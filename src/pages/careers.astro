									</div>
									<p class="text-[10px] font-mono text-neutral-500 tracking-wider">
										By applying, you agree to our <a href="/privacy" class="text-neutral-400 hover:text-white underline transition-colors">Privacy Policy</a>.
									</p>
								</div>
							</form>

							<!-- Success Screen (Hidden by default) -->
							<div id="success-screen" class="hidden absolute inset-0 bg-neutral-950/95 backdrop-blur-xl flex flex-col items-center justify-center text-center space-y-6 p-6 rounded-3xl z-20 border border-white/10">
								<div class="relative w-16 h-16 mb-2">
									<div class="absolute inset-0 rounded-full border border-white/10 bg-white/5 animate-pulse-slow"></div>
									<div class="absolute inset-2 rounded-full border border-white/20 flex items-center justify-center">
										<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
											<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
										</svg>
									</div>
								</div>
								<div class="space-y-4 px-6 max-w-md">
									<h3 class="text-xl font-syne font-bold tracking-tight text-white uppercase select-text">Credentials Received</h3>
									
									<!-- Simulated Console -->
									<div class="bg-black/90 border border-white/10 rounded-lg p-4 font-mono text-[10px] text-left text-neutral-400 space-y-1.5 overflow-hidden h-28 max-w-sm mx-auto shadow-inner">
										<div class="terminal-line opacity-0">> ANALYZING APPLICANT SIGNATURE… [OK]</div>
										<div class="terminal-line opacity-0">> VERIFYING UPLOAD INTEGRITY… [100%]</div>
										<div class="terminal-line opacity-0">> UPLOADING CREDENTIALS CORE… [OK]</div>
										<div class="terminal-line opacity-0">> INTERFACE HANDSHAKE COMPLETED… [ESTABLISHED]</div>
									</div>
									
									<p class="text-[11px] font-mono text-neutral-400 leading-relaxed select-text mt-2">
										Your credentials have been successfully loaded. Review latency: <span class="text-white font-bold">48 Hours</span>.
									</p>
								</div>
								<button 
									id="reset-form-btn" 
									class="text-[10px] font-mono tracking-widest text-neutral-400 hover:text-white uppercase transition-colors pointer-events-auto cursor-pointer"
								>
									Submit Another Profile
								</button>
							</div>
						</div>
					</div>
				</div>

			</div>
		</section>

	</div>

	<!-- Custom style for the spin (matching contact.astro) -->
	<style>
		@keyframes border-spin {
			from { transform: rotate(0deg); }
			to { transform: rotate(360deg); }
		}
		.animate-border-spin {
			animation: border-spin 3s linear infinite;
		}
	</style>

	<!-- Interactive Script -->
	<script>
		import * as THREE from 'three';
		import { gsap } from 'gsap';

		// Accordion Logic
		const jobBtns = document.querySelectorAll('.job-item button');
		jobBtns.forEach(btn => {
			btn.addEventListener('click', () => {
				const item = btn.parentElement;
				const details = item?.querySelector('.job-details') as HTMLElement | null;
				const chevron = btn.querySelector('.chevron-icon svg') as HTMLElement | null;

				if (!details || !item) return;

				const isOpen = !details.classList.contains('hidden');

				// Close all other jobs
				document.querySelectorAll('.job-item').forEach(otherItem => {
					if (otherItem !== item) {
						const otherDetails = otherItem.querySelector('.job-details') as HTMLElement | null;
						const otherChevron = otherItem.querySelector('.chevron-icon svg') as HTMLElement | null;
						if (otherDetails && !otherDetails.classList.contains('hidden')) {
							gsap.to(otherDetails, {
								height: 0,
								opacity: 0,
								duration: 0.3,
								ease: 'power2.out',
								onComplete: () => {
									otherDetails.classList.add('hidden');
									otherDetails.style.height = '';
								}
							});
							if (otherChevron) otherChevron.style.transform = 'rotate(0deg)';
						}
					}
				});

				// Toggle clicked job
				if (isOpen) {
					gsap.to(details, {
						height: 0,
						opacity: 0,
						duration: 0.3,
						ease: 'power2.out',
						onComplete: () => {
							details.classList.add('hidden');
							details.style.height = '';
						}
					});
					if (chevron) chevron.style.transform = 'rotate(0deg)';
				} else {
					details.classList.remove('hidden');
					const naturalHeight = details.scrollHeight;
					gsap.fromTo(details, 
						{ height: 0, opacity: 0 },
						{ height: naturalHeight, opacity: 1, duration: 0.4, ease: 'power2.out' }
					);
					if (chevron) chevron.style.transform = 'rotate(180deg)';
				}
			});
		});

		// Apply button logic inside accordion
		const applyBtns = document.querySelectorAll('.apply-to-job-btn');
		const positionSelect = document.getElementById('apply_position') as HTMLSelectElement | null;
		applyBtns.forEach(btn => {
			btn.addEventListener('click', (e) => {
				e.preventDefault();
				const targetRole = btn.getAttribute('data-role');
				if (positionSelect && targetRole) {
					if (targetRole.includes('AI Systems')) {
						positionSelect.value = 'ai_systems';
					} else if (targetRole.includes('MLOps')) {
						positionSelect.value = 'mlops';
					} else if (targetRole.includes('Interactive Designer')) {
						positionSelect.value = 'design';
					} else if (targetRole.includes('Full-Stack')) {
						positionSelect.value = 'full_stack';
					}
				}
				
				const applySection = document.getElementById('apply');
				if (applySection) {
					applySection.scrollIntoView({ behavior: 'smooth' });
				}
			});
		});

		// Filters Logic
		const filterBtns = document.querySelectorAll('.filter-btn');
		filterBtns.forEach(btn => {
			btn.addEventListener('click', () => {
				const filter = btn.getAttribute('data-filter');
				
				// Update active class
				filterBtns.forEach(b => {
					b.classList.remove('text-cyan-400', 'bg-cyan-500/10', 'border-cyan-400/20');
					b.classList.add('text-neutral-400', 'border-transparent');
				});
				btn.classList.remove('text-neutral-400', 'border-transparent');
				btn.classList.add('text-cyan-400', 'bg-cyan-500/10', 'border-cyan-400/20');

				// Filter items
				document.querySelectorAll('.job-item').forEach(item => {
					const dept = item.getAttribute('data-dept');
					if (filter === 'all' || dept === filter) {
						gsap.to(item, { display: 'block', opacity: 1, y: 0, duration: 0.3 });
					} else {
						gsap.to(item, { display: 'none', opacity: 0, y: 15, duration: 0.3 });
					}
				});
			});
		});

		// Drag & Drop File Upload UI updates
		const fileInput = document.getElementById('resume-file') as HTMLInputElement | null;
		const dropZone = document.getElementById('drop-zone');
		const emptyState = document.getElementById('upload-empty-state');
		const activeState = document.getElementById('upload-active-state');
		const fileNameSpan = document.getElementById('uploaded-file-name');
		const removeBtn = document.getElementById('remove-file-btn');
		const canvasContainer = document.getElementById('canvas-container');
		const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		if (fileInput && dropZone && emptyState && activeState && fileNameSpan && removeBtn) {
			const handleFile = (file: File) => {
				fileNameSpan.innerText = file.name;
				emptyState.classList.add('hidden');
				activeState.classList.remove('hidden');
				dropZone.classList.add('border-cyan-500/30', 'bg-cyan-950/5');
				fileInput.classList.add('hidden');
			};

			fileInput.addEventListener('change', () => {
				if (fileInput.files && fileInput.files.length > 0) {
					handleFile(fileInput.files[0]);
				}
			});

			removeBtn.addEventListener('click', (e) => {
				e.preventDefault();
				e.stopPropagation(); // Avoid triggering file selection dialog
				fileInput.value = '';
				fileInput.classList.remove('hidden');
				activeState.classList.add('hidden');
				emptyState.classList.remove('hidden');
				dropZone.classList.remove('border-cyan-500/30', 'bg-cyan-950/5');
			});

			// drag and drop triggers
			dropZone.addEventListener('dragover', (e) => {
				e.preventDefault();
				if (!activeState.classList.contains('hidden')) return;
				dropZone.classList.add('border-cyan-500/50', 'bg-cyan-950/10');
			});

			dropZone.addEventListener('dragleave', () => {
				if (!activeState.classList.contains('hidden')) return;
				dropZone.classList.remove('border-cyan-500/50', 'bg-cyan-950/10');
			});

			dropZone.addEventListener('drop', (e) => {
				e.preventDefault();
				if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
					const file = e.dataTransfer.files[0];
					if (file.type === 'application/pdf') {
						fileInput.files = e.dataTransfer.files;
						handleFile(file);
					}
				}
			});
		}

		// Application submission sequence
		const applyForm = document.getElementById('apply-form') as HTMLFormElement | null;
		const successScreen = document.getElementById('success-screen');
		const resetFormBtn = document.getElementById('reset-form-btn');

		if (applyForm && successScreen && resetFormBtn) {
			applyForm.addEventListener('submit', (e) => {
				e.preventDefault();
				const submitBtn = applyForm.querySelector('button[type="submit"]') as HTMLButtonElement | null;
				if (submitBtn) {
					submitBtn.disabled = true;
					submitBtn.innerText = 'Compressing Transmission…';
				}

				gsap.to(applyForm, {
					opacity: 0,
					y: -10,
					duration: 0.4,
					onComplete: () => {
						applyForm.classList.add('hidden');
						successScreen.classList.remove('hidden');
						successScreen.style.opacity = '0';
						successScreen.style.transform = 'translateY(10px)';

						gsap.to(successScreen, {
							opacity: 1,
							y: 0,
							duration: 0.5,
							ease: 'power2.out',
							onComplete: () => {
								const lines = successScreen.querySelectorAll('.terminal-line');
								gsap.to(lines, {
									opacity: 1,
									stagger: 0.35,
									duration: 0.15,
									ease: 'none'
								});
							}
						});
					}
				});
			});

			resetFormBtn.addEventListener('click', () => {
				gsap.to(successScreen, {
					opacity: 0,
					y: 10,
					duration: 0.4,
					onComplete: () => {
						successScreen.classList.add('hidden');
						const lines = successScreen.querySelectorAll('.terminal-line');
						lines.forEach(line => (line as HTMLElement).style.opacity = '0');

						applyForm.reset();
						if (fileInput && dropZone && emptyState && activeState) {
							fileInput.value = '';
							fileInput.classList.remove('hidden');
							activeState.classList.add('hidden');
							emptyState.classList.remove('hidden');
							dropZone.classList.remove('border-cyan-500/30', 'bg-cyan-950/5');
						}

						applyForm.classList.remove('hidden');
						applyForm.style.opacity = '0';
						applyForm.style.transform = 'translateY(-10px)';

						const submitBtn = applyForm.querySelector('button[type="submit"]') as HTMLButtonElement | null;
						if (submitBtn) {
							submitBtn.disabled = false;
							submitBtn.innerText = 'Submit Application';
						}

						gsap.to(applyForm, {
							opacity: 1,
							y: 0,
							duration: 0.5,
							ease: 'power2.out'
						});
					}
				});
			});
		}
		// 3. Three.js Interactive Particle SVG Image System
		let scene: THREE.Scene, 
			camera: THREE.PerspectiveCamera, 
			renderer: THREE.WebGLRenderer,
			geometry: THREE.BufferGeometry,
			points: THREE.Points,
			currentScale = 1.0;
		
		function initThree() {
			if (!canvasContainer) return;
			
			// Load SVG image as textures/particles
			const img = new Image();
			img.crossOrigin = "anonymous";
			img.src = '/careers-hero.svg';
			
			img.onload = () => {
				const sampleCanvas = document.createElement('canvas');
				const sWidth = 185;
				const sHeight = 185;
				
				sampleCanvas.width = sWidth;
				sampleCanvas.height = sHeight;
				const sCtx = sampleCanvas.getContext('2d');
				if (!sCtx) return;
				
				sCtx.drawImage(img, 0, 0, sWidth, sHeight);
				const imgData = sCtx.getImageData(0, 0, sWidth, sHeight);
				const data = imgData.data;
				
				const rawParticles = [];
				
				for (let y = 0; y < sHeight; y++) {
					for (let x = 0; x < sWidth; x++) {
						const idx = (y * sWidth + x) * 4;
						const r = data[idx];
						const g = data[idx + 1];
						const b = data[idx + 2];
						const a = data[idx + 3];
						
						if (a > 60) {
							const px = ((x / sWidth) - 0.5) * 5.0;
							const py = -((y / sHeight) - 0.5) * 5.0;
							const pz = (Math.random() - 0.5) * 0.12;
							
							rawParticles.push({
								x: px,
								y: py,
								z: pz,
								r: r / 255,
								g: g / 255,
								b: b / 255
							});
						}
					}
				}
				
				const maxParticles = 3200;
				let particlesList = [];
				if (rawParticles.length > maxParticles) {
					const rawCount = rawParticles.length;
					for (let i = 0; i < maxParticles; i++) {
						const index = Math.floor((i / (maxParticles - 1)) * (rawCount - 1));
						particlesList.push(rawParticles[index]);
					}
				} else {
					particlesList = rawParticles;
				}
				
				setupParticleSystem(particlesList);
			};
		}

		function setupParticleSystem(particlesList: any[]) {
			if (!canvasContainer) return;
			const width = canvasContainer.clientWidth;
			const height = canvasContainer.clientHeight || 350;
			
			scene = new THREE.Scene();
			
			camera = new THREE.PerspectiveCamera(60, width / height, 0.1, 100);
			camera.position.z = 4.8;
			
			renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
			renderer.setSize(width, height);
			renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
			renderer.domElement.style.display = 'block';
			canvasContainer.appendChild(renderer.domElement);
			
			const count = particlesList.length;
			const positions = new Float32Array(count * 3);
			const colors = new Float32Array(count * 3);
			const originalPositions = new Float32Array(count * 3);
			const velocities = new Float32Array(count * 3);
			
			for (let i = 0; i < count; i++) {
				const p = particlesList[i];
				const i3 = i * 3;
				
				originalPositions[i3] = p.x;
				originalPositions[i3 + 1] = p.y;
				originalPositions[i3 + 2] = p.z;
				
				positions[i3] = p.x + (Math.random() - 0.5) * 12;
				positions[i3 + 1] = p.y + (Math.random() - 0.5) * 12;
				positions[i3 + 2] = p.z + (Math.random() - 0.5) * 12;
				
				colors[i3] = p.r;
				colors[i3 + 1] = p.g;
				colors[i3 + 2] = p.b;
				
				velocities[i3] = 0;
				velocities[i3 + 1] = 0;
				velocities[i3 + 2] = 0;
			}
			
			geometry = new THREE.BufferGeometry();
			geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
			geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));
			
			const canvas = document.createElement('canvas');
			canvas.width = 32;
			canvas.height = 32;
			const ctx = canvas.getContext('2d');
			if (ctx) {
				const gradient = ctx.createRadialGradient(16, 16, 0, 16, 16, 16);
				gradient.addColorStop(0, 'rgba(255, 255, 255, 1)');
				gradient.addColorStop(0.25, 'rgba(255, 255, 255, 0.7)');
				gradient.addColorStop(0.6, 'rgba(255, 255, 255, 0.15)');
				gradient.addColorStop(1, 'rgba(255, 255, 255, 0)');
				ctx.fillStyle = gradient;
				ctx.fillRect(0, 0, 32, 32);
			}
			const texture = new THREE.CanvasTexture(canvas);
			
			const material = new THREE.PointsMaterial({
				size: 0.085,
				map: texture,
				transparent: true,
				opacity: 0.9,
				blending: THREE.AdditiveBlending,
				depthWrite: false,
				vertexColors: true
			});
			
			points = new THREE.Points(geometry, material);
			scene.add(points);
			
			function adjustScale() {
				if (!points || !canvasContainer) return;
				const w = canvasContainer.clientWidth;
				const h = canvasContainer.clientHeight || 350;
				const aspect = w / h;
				
				if (aspect < 1.0) {
					currentScale = aspect * 0.95;
				} else {
					currentScale = 1.05;
				}
				points.scale.set(currentScale, currentScale, currentScale);
			}
			
			adjustScale();
			
			const mouse = new THREE.Vector2(-9999, -9999);
			const mouse3D = new THREE.Vector3(-9999, -9999, 0);
			const plane = new THREE.Plane(new THREE.Vector3(0, 0, 1), 0);
			const raycaster = new THREE.Raycaster();
			
			function updateMousePosition(clientX: number, clientY: number) {
				if (!canvasContainer) return;
				const rect = canvasContainer.getBoundingClientRect();
				const x = ((clientX - rect.left) / rect.width) * 2 - 1;
				const y = -((clientY - rect.top) / rect.height) * 2 + 1;
				mouse.set(x, y);
				
				raycaster.setFromCamera(mouse, camera);
				raycaster.ray.intersectPlane(plane, mouse3D);
			}
			
			function handleMove(e: MouseEvent) {
				updateMousePosition(e.clientX, e.clientY);
			}
			
			function handleLeave() {
				mouse.set(-9999, -9999);
				mouse3D.set(-9999, -9999, 0);
			}
			
			function handleTouch(e: TouchEvent) {
				if (e.touches.length > 0) {
					updateMousePosition(e.touches[0].clientX, e.touches[0].clientY);
				}
			}
			
			canvasContainer.addEventListener('mousemove', handleMove);
			canvasContainer.addEventListener('mouseleave', handleLeave);
			canvasContainer.addEventListener('touchmove', handleTouch);
			canvasContainer.addEventListener('touchend', handleLeave);
			
			const clock = new THREE.Clock();
			
			function animate() {
				requestAnimationFrame(animate);
				
				const delta = Math.min(clock.getDelta(), 0.1);
				const elapsed = clock.getElapsedTime();

				// Rotate the image particles slightly for a premium dynamic feel
				if (points && !prefersReduced) {
					points.rotation.y = Math.sin(elapsed * 0.12) * 0.15;
					points.rotation.x = Math.cos(elapsed * 0.08) * 0.08;
				}

				const positionsAttr = geometry.attributes.position;
				const posArray = positionsAttr.array as Float32Array;
				
				const mouseRadius = 0.95;
				const mousePush = 3.5;
				const springForce = 5.2;
				const damping = 0.83;
				
				for (let i = 0; i < count; i++) {
					const idx = i * 3;
					
					let x = posArray[idx];
					let y = posArray[idx + 1];
					let z = posArray[idx + 2];
					
					const ox = originalPositions[idx];
					const oy = originalPositions[idx + 1];
					const oz = originalPositions[idx + 2];
					
					let vx = velocities[idx];
					let vy = velocities[idx + 1];
					let vz = velocities[idx + 2];
					
					if (mouse.x > -1000 && !prefersReduced) {
						const localMouseX = mouse3D.x / currentScale;
						const localMouseY = mouse3D.y / currentScale;
						const localMouseZ = mouse3D.z / currentScale;
						
						const dx = x - localMouseX;
						const dy = y - localMouseY;
						const dz = z - localMouseZ;
						const dist = Math.sqrt(dx*dx + dy*dy + dz*dz);
						
						if (dist < mouseRadius) {
							const pushStrength = (1.0 - dist / mouseRadius) * mousePush;
							const angleX = dist > 0 ? dx / dist : (Math.random() - 0.5);
							const angleY = dist > 0 ? dy / dist : (Math.random() - 0.5);
							const angleZ = dist > 0 ? dz / dist : (Math.random() - 0.5);
							
							vx += angleX * pushStrength * delta;
							vy += angleY * pushStrength * delta;
							vz += angleZ * pushStrength * delta;
						}
					}
					
					const sx = (ox - x) * springForce;
					const sy = (oy - y) * springForce;
					const sz = (oz - z) * springForce;
					
					vx += sx * delta;
					vy += sy * delta;
					vz += sz * delta;
					
					vx *= damping;
					vy *= damping;
					vz *= damping;
					
					x += vx;
					y += vy;
					z += vz;
					
					posArray[idx] = x;
					posArray[idx + 1] = y;
					posArray[idx + 2] = z;
					
					velocities[idx] = vx;
					velocities[idx + 1] = vy;
					velocities[idx + 2] = vz;
				}
				
				positionsAttr.needsUpdate = true;
				renderer.render(scene, camera);
			}
			
			animate();
			
			window.addEventListener('resize', () => {
				if (!canvasContainer || !renderer || !camera) return;
				const w = canvasContainer.clientWidth;
				const h = canvasContainer.clientHeight || 350;
				
				camera.aspect = w / h;
				camera.updateProjectionMatrix();
				renderer.setSize(w, h);
				
				adjustScale();
			});
		}

		initThree();
	</script>
</PageLayout>
