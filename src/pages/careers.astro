---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout 
	title="diceforce IT | Careers | Join the Frontier" 
	description="We are always seeking deep-learning specialists, MLOps engineers, and interactive developers. Join our remote-first, high-autonomy engineering team."
	activePage="careers"
>
	<div class="max-w-6xl mx-auto w-full flex flex-col gap-16 md:gap-24">
		
		<!-- SECTION 1: HERO (2-Column Layout) -->
		<section class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center animate-stagger-item">
			<!-- Left Column: Hero Copy -->
			<div class="lg:col-span-7 space-y-6">
				<div class="inline-flex items-center gap-2 px-3 py-1 border border-cyan-500/20 rounded-full bg-cyan-950/10">
					<span class="font-mono text-[9px] tracking-widest text-cyan-400 uppercase">WE ARE HIRING</span>
				</div>
				<h1 class="font-syne font-black text-4xl sm:text-5xl md:text-6xl lg:text-7xl tracking-tighter leading-[0.95] text-white select-text text-balance">
					Shape the frontier<br />
					of digital systems.
				</h1>
				<p class="text-neutral-400 font-light text-base sm:text-lg max-w-xl mt-6 leading-relaxed select-text">
					We are building the systems, autonomous agents, and scaling platforms of tomorrow. Join a high-autonomy, remote-first team of engineers and designers.
				</p>
				<div class="pt-4 flex flex-wrap gap-4">
					<a href="#positions" class="px-6 py-3 bg-white text-black font-semibold rounded-full hover:bg-white/90 hover:scale-102 transition-all duration-300 text-xs tracking-wider uppercase whitespace-nowrap">
						View Open Roles
					</a>
					<a href="#apply" class="px-6 py-3 border border-white/10 hover:border-white/30 text-white font-semibold rounded-full hover:bg-white/5 transition-all duration-300 text-xs tracking-wider uppercase whitespace-nowrap">
						General Application
					</a>
				</div>
			</div>
			<!-- Right Column: Interactive 3D WebGL Particle System -->
			<div class="lg:col-span-5 relative w-full h-[350px] sm:h-[420px] lg:h-[480px] flex items-center justify-center overflow-hidden">
				<div class="absolute inset-0 bg-[#00deff]/[0.02] blur-[80px] rounded-full pointer-events-none"></div>
				<!-- Three.js Canvas Container -->
				<div id="canvas-container" class="w-full h-full cursor-grab active:cursor-grabbing relative z-10"></div>
			</div>
		</section>

		<!-- SECTION 2: CULTURE / BENEFITS (Grid Layout) -->
		<section class="border-t border-white/5 pt-16 animate-stagger-item">
			<div class="space-y-4 mb-12">
				<div class="flex items-center gap-2">
					<span class="text-[10px] font-mono tracking-widest text-cyan-400/80 uppercase">OUR CULTURE</span>
				</div>
				<h2 class="font-syne font-semibold text-2xl sm:text-3xl text-white tracking-tight leading-none select-text">
					Why work with diceforce IT?
				</h2>
				<p class="text-neutral-400 text-sm leading-relaxed max-w-xl select-text font-light">
					We skip the bureaucracy and focus entirely on building high-performance solutions. Here is what you can expect when you join our team:
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
				<!-- Benefit Card 1 -->
				<div class="p-6 rounded-2xl border border-white/5 bg-white/[0.01] hover:border-cyan-500/20 hover:bg-white/[0.02] transition-all duration-300 flex flex-col justify-between h-56 group shadow-lg shadow-black/10">
					<div class="w-10 h-10 rounded-xl bg-cyan-400/5 text-cyan-400 border border-cyan-400/10 flex items-center justify-center group-hover:bg-cyan-400/10 group-hover:border-cyan-400/30 transition-all duration-300">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 002 2h2m.05 0a9 9 0 11-20.94-3.362z" />
						</svg>
					</div>
					<div>
						<h3 class="font-syne font-medium text-white text-base mb-1 select-text">Remote-First & Async</h3>
						<p class="text-neutral-400 text-xs leading-relaxed font-light select-text">
							Work from anywhere. We optimize for flow and uninterrupted blocks of deep focus, not meetings.
						</p>
					</div>
				</div>

				<!-- Benefit Card 2 -->
				<div class="p-6 rounded-2xl border border-white/5 bg-white/[0.01] hover:border-cyan-500/20 hover:bg-white/[0.02] transition-all duration-300 flex flex-col justify-between h-56 group shadow-lg shadow-black/10">
					<div class="w-10 h-10 rounded-xl bg-blue-400/5 text-blue-400 border border-blue-400/10 flex items-center justify-center group-hover:bg-blue-400/10 group-hover:border-blue-400/30 transition-all duration-300">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
						</svg>
					</div>
					<div>
						<h3 class="font-syne font-medium text-white text-base mb-1 select-text">High Autonomy</h3>
						<p class="text-neutral-400 text-xs leading-relaxed font-light select-text">
							You own your features, architectures, and decisions. We value builders who take complete ownership.
						</p>
					</div>
				</div>

				<!-- Benefit Card 3 -->
				<div class="p-6 rounded-2xl border border-white/5 bg-white/[0.01] hover:border-cyan-500/20 hover:bg-white/[0.02] transition-all duration-300 flex flex-col justify-between h-56 group shadow-lg shadow-black/10">
					<div class="w-10 h-10 rounded-xl bg-purple-400/5 text-purple-400 border border-purple-400/10 flex items-center justify-center group-hover:bg-purple-400/10 group-hover:border-purple-400/30 transition-all duration-300">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
						</svg>
					</div>
					<div>
						<h3 class="font-syne font-medium text-white text-base mb-1 select-text">Futuristic Stack</h3>
						<p class="text-neutral-400 text-xs leading-relaxed font-light select-text">
							Deploy the latest custom AI agents, write optimized CUDA kernels, use Rust, and design premium Three.js interfaces.
						</p>
					</div>
				</div>

				<!-- Benefit Card 4 -->
				<div class="p-6 rounded-2xl border border-white/5 bg-white/[0.01] hover:border-cyan-500/20 hover:bg-white/[0.02] transition-all duration-300 flex flex-col justify-between h-56 group shadow-lg shadow-black/10">
					<div class="w-10 h-10 rounded-xl bg-indigo-400/5 text-indigo-400 border border-indigo-400/10 flex items-center justify-center group-hover:bg-indigo-400/10 group-hover:border-indigo-400/30 transition-all duration-300">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 .364l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
						</svg>
					</div>
					<div>
						<h3 class="font-syne font-medium text-white text-base mb-1 select-text">Cognitive Growth</h3>
						<p class="text-neutral-400 text-xs leading-relaxed font-light select-text">
							Work on complex problems like compiler engineering, vector search speeds, and advanced AI-human interfaces.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- SECTION 3: OPEN POSITIONS (Accordion List) -->
		<section id="positions" class="border-t border-white/5 pt-16 scroll-mt-24 animate-stagger-item">
			<div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-12">
				<div class="space-y-4">
					<div class="flex items-center gap-2">
						<span class="text-[10px] font-mono tracking-widest text-cyan-400/80 uppercase">EXPLORE OPPORTUNITIES</span>
					</div>
					<h2 class="font-syne font-semibold text-2xl sm:text-3xl text-white tracking-tight leading-none select-text">
						Open Positions
					</h2>
					<p class="text-neutral-400 text-sm leading-relaxed max-w-xl select-text font-light">
						Choose a role to view the qualifications, requirements, and apply directly.
					</p>
				</div>
				
				<!-- Filter Buttons -->
				<div class="flex items-center gap-2 border border-white/5 rounded-full p-1 bg-black/40 backdrop-blur-md self-start sm:self-auto shrink-0 font-mono text-[10px] tracking-wider uppercase select-none">
					<button data-filter="all" class="filter-btn px-4 py-1.5 rounded-full text-cyan-400 bg-cyan-500/10 border border-cyan-400/20 transition-all duration-300 cursor-pointer">All</button>
					<button data-filter="engineering" class="filter-btn px-4 py-1.5 rounded-full text-neutral-400 hover:text-white border border-transparent transition-all duration-300 cursor-pointer">Engineering</button>
					<button data-filter="design" class="filter-btn px-4 py-1.5 rounded-full text-neutral-400 hover:text-white border border-transparent transition-all duration-300 cursor-pointer">Design</button>
				</div>
			</div>

			<!-- Positions Stack -->
			<div class="space-y-4">
				<!-- Position 1: AI Systems Engineer -->
				<div class="job-item border border-white/5 bg-white/[0.01] hover:bg-white/[0.02] backdrop-blur-md rounded-2xl overflow-hidden transition-all duration-300 hover:border-cyan-500/20 shadow-lg shadow-black/20" data-dept="engineering">
					<!-- Header (Trigger) -->
					<button class="w-full text-left p-6 sm:p-8 flex items-center justify-between gap-4 cursor-pointer outline-none group/jobbtn">
						<div class="space-y-2">
							<div class="flex flex-wrap items-center gap-2.5">
								<span class="font-mono text-[9px] tracking-widest text-cyan-400 bg-cyan-400/5 border border-cyan-400/10 px-2 py-0.5 rounded uppercase">Engineering</span>
								<span class="font-mono text-[9px] tracking-widest text-neutral-400 bg-white/[0.02] border border-white/5 px-2 py-0.5 rounded uppercase">Remote</span>
								<span class="font-mono text-[9px] tracking-widest text-neutral-400 bg-white/[0.02] border border-white/5 px-2 py-0.5 rounded uppercase">Full-Time</span>
							</div>
							<h3 class="font-syne font-bold text-lg sm:text-xl text-white group-hover/jobbtn:text-cyan-400 transition-colors select-text">
								Senior AI Systems Engineer
							</h3>
						</div>
						<!-- Chevron Icon -->
						<div class="w-10 h-10 rounded-full border border-white/10 flex items-center justify-center shrink-0 text-neutral-400 group-hover/jobbtn:text-cyan-400 group-hover/jobbtn:border-cyan-500/20 transition-all duration-300 chevron-icon">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
							</svg>
						</div>
					</button>

					<!-- Expandable Details -->
					<div class="job-details hidden border-t border-white/5 bg-[#030307]/40 p-6 sm:p-8 space-y-6">
						<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
							<div class="lg:col-span-2 space-y-4">
								<h4 class="font-mono text-xs uppercase tracking-widest text-neutral-400">Role Overview</h4>
								<p class="text-neutral-400 text-sm leading-relaxed font-light select-text">
									We are looking for a Senior AI Systems Engineer to design and implement robust, production-grade infrastructure for our custom autonomous agent systems. In this role, you will lead the architecture of high-concurrency event loops, pipeline fine-tuning pipelines, and write interfaces that orchestrate multi-agent operations securely and with minimal latency.
								</p>
								<h4 class="font-mono text-xs uppercase tracking-widest text-neutral-400 pt-2">Key Responsibilities</h4>
								<ul class="space-y-2.5 text-neutral-300 text-sm leading-relaxed font-light select-text">
									<li class="flex items-start gap-2.5">
										<span class="w-1.5 h-1.5 rounded-full bg-cyan-500/40 mt-2 shrink-0"></span>
										<span>Build robust orchestration systems for multiple LLM-based agents.</span>
									</li>
									<li class="flex items-start gap-2.5">
										<span class="w-1.5 h-1.5 rounded-full bg-cyan-500/40 mt-2 shrink-0"></span>
										<span>Implement fine-tuning and retrieval pipelines utilizing advanced embedding structures and context window management.</span>
									</li>
									<li class="flex items-start gap-2.5">
										<span class="w-1.5 h-1.5 rounded-full bg-cyan-500/40 mt-2 shrink-0"></span>
										<span>Design fast caching systems for vector search models and database interfaces.</span>
									</li>
									<li class="flex items-start gap-2.5">
										<span class="w-1.5 h-1.5 rounded-full bg-cyan-500/40 mt-2 shrink-0"></span>
										<span>Collaborate with front-end engineers to expose high-fidelity real-time streaming interfaces.</span>
									</li>
								</ul>
							</div>
							<div class="space-y-4 lg:border-l lg:border-white/5 lg:pl-8">
								<h4 class="font-mono text-xs uppercase tracking-widest text-neutral-400">Stack & Requirements</h4>
								<div class="flex flex-wrap gap-1.5 pt-1">
									<span class="font-mono text-[10px] text-neutral-300 bg-white/5 border border-white/10 px-2 py-0.5 rounded">Python</span>
									<span class="font-mono text-[10px] text-neutral-300 bg-white/5 border border-white/10 px-2 py-0.5 rounded">Rust</span>
									<span class="font-mono text-[10px] text-neutral-300 bg-white/5 border border-white/10 px-2 py-0.5 rounded">Go</span>
									<span class="font-mono text-[10px] text-neutral-300 bg-white/5 border border-white/10 px-2 py-0.5 rounded">PyTorch</span>
									<span class="font-mono text-[10px] text-neutral-300 bg-white/5 border border-white/10 px-2 py-0.5 rounded">LangChain</span>
									<span class="font-mono text-[10px] text-neutral-300 bg-white/5 border border-white/10 px-2 py-0.5 rounded">Vector DBs</span>
								</div>
								<div class="space-y-3 pt-3">
									<div>
										<span class="text-[10px] font-mono text-neutral-500 uppercase block">Experience</span>
										<span class="text-white text-xs select-text font-medium">5+ years in system engineering</span>
									</div>
									<div>
										<span class="text-[10px] font-mono text-neutral-500 uppercase block">Compensation</span>
										<span class="text-white text-xs select-text font-medium">Competitive Equity + Competitive Base</span>
									</div>
								</div>
							</div>
						</div>
						<div class="pt-4 border-t border-white/5 flex">
							<a href="#apply" data-role="Senior AI Systems Engineer" class="apply-to-job-btn px-6 py-2.5 bg-cyan-400 hover:bg-cyan-300 hover:scale-[1.02] text-black font-mono text-[10px] font-bold uppercase tracking-wider rounded-full transition-all duration-300 hover:shadow-[0_0_15px_rgba(34,211,238,0.4)]">
								Apply For This Role
							</a>
						</div>
					</div>
				</div>

				<!-- Position 2: MLOps & CUDA Engineer -->
				<div class="job-item border border-white/5 bg-white/[0.01] hover:bg-white/[0.02] backdrop-blur-md rounded-2xl overflow-hidden transition-all duration-300 hover:border-cyan-500/20 shadow-lg shadow-black/20" data-dept="engineering">
					<!-- Header (Trigger) -->
					<button class="w-full text-left p-6 sm:p-8 flex items-center justify-between gap-4 cursor-pointer outline-none group/jobbtn">
						<div class="space-y-2">
							<div class="flex flex-wrap items-center gap-2.5">
								<span class="font-mono text-[9px] tracking-widest text-cyan-400 bg-cyan-400/5 border border-cyan-400/10 px-2 py-0.5 rounded uppercase">Engineering</span>
								<span class="font-mono text-[9px] tracking-widest text-neutral-400 bg-white/[0.02] border border-white/5 px-2 py-0.5 rounded uppercase">Remote</span>
								<span class="font-mono text-[9px] tracking-widest text-neutral-400 bg-white/[0.02] border border-white/5 px-2 py-0.5 rounded uppercase">Full-Time</span>
							</div>
							<h3 class="font-syne font-bold text-lg sm:text-xl text-white group-hover/jobbtn:text-cyan-400 transition-colors select-text">
								Staff MLOps & CUDA Engineer
							</h3>
						</div>
						<!-- Chevron Icon -->
						<div class="w-10 h-10 rounded-full border border-white/10 flex items-center justify-center shrink-0 text-neutral-400 group-hover/jobbtn:text-cyan-400 group-hover/jobbtn:border-cyan-500/20 transition-all duration-300 chevron-icon">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
							</svg>
						</div>
					</button>

					<!-- Expandable Details -->
					<div class="job-details hidden border-t border-white/5 bg-[#030307]/40 p-6 sm:p-8 space-y-6">
						<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
							<div class="lg:col-span-2 space-y-4">
								<h4 class="font-mono text-xs uppercase tracking-widest text-neutral-400">Role Overview</h4>
								<p class="text-neutral-400 text-sm leading-relaxed font-light select-text">
									As our Staff MLOps & CUDA Engineer, you will own the deployment speed and optimization of our private model networks. This includes writing custom CUDA kernels to optimize tensor workloads, calibrating distributed pipelines across GPU nodes, and managing automated container orchestration scaling triggers.
								</p>
								<h4 class="font-mono text-xs uppercase tracking-widest text-neutral-400 pt-2">Key Responsibilities</h4>
								<ul class="space-y-2.5 text-neutral-300 text-sm leading-relaxed font-light select-text">
									<li class="flex items-start gap-2.5">
										<span class="w-1.5 h-1.5 rounded-full bg-cyan-500/40 mt-2 shrink-0"></span>
										<span>Write and profile custom CUDA kernels to minimize latency during transformer executions.</span>
									</li>
									<li class="flex items-start gap-2.5">
										<span class="w-1.5 h-1.5 rounded-full bg-cyan-500/40 mt-2 shrink-0"></span>
										<span>Configure Kubernetes orchestrations to autoscale multi-GPU container deployments.</span>
									</li>
									<li class="flex items-start gap-2.5">
										<span class="w-1.5 h-1.5 rounded-full bg-cyan-500/40 mt-2 shrink-0"></span>
										<span>Integrate model compilation systems like Triton, TensorRT, or vLLM to scale request throughput.</span>
									</li>
									<li class="flex items-start gap-2.5">
										<span class="w-1.5 h-1.5 rounded-full bg-cyan-500/40 mt-2 shrink-0"></span>
										<span>Manage telemetry collection pipelines for GPU performance, throttling, and memory bounds.</span>
									</li>
								</ul>
							</div>
							<div class="space-y-4 lg:border-l lg:border-white/5 lg:pl-8">
								<h4 class="font-mono text-xs uppercase tracking-widest text-neutral-400">Stack & Requirements</h4>
								<div class="flex flex-wrap gap-1.5 pt-1">
									<span class="font-mono text-[10px] text-neutral-300 bg-white/5 border border-white/10 px-2 py-0.5 rounded">CUDA</span>
									<span class="font-mono text-[10px] text-neutral-300 bg-white/5 border border-white/10 px-2 py-0.5 rounded">C++</span>
									<span class="font-mono text-[10px] text-neutral-300 bg-white/5 border border-white/10 px-2 py-0.5 rounded">Python</span>
									<span class="font-mono text-[10px] text-neutral-300 bg-white/5 border border-white/10 px-2 py-0.5 rounded">vLLM</span>
									<span class="font-mono text-[10px] text-neutral-300 bg-white/5 border border-white/10 px-2 py-0.5 rounded">Docker</span>
									<span class="font-mono text-[10px] text-neutral-300 bg-white/5 border border-white/10 px-2 py-0.5 rounded">K8s</span>
								</div>
								<div class="space-y-3 pt-3">
									<div>
										<span class="text-[10px] font-mono text-neutral-500 uppercase block">Experience</span>
										<span class="text-white text-xs select-text font-medium">4+ years writing GPU-accelerated code</span>
									</div>
									<div>
										<span class="text-[10px] font-mono text-neutral-500 uppercase block">Compensation</span>
										<span class="text-white text-xs select-text font-medium">Competitive Base + High Equity options</span>
									</div>
								</div>
							</div>
						</div>
						<div class="pt-4 border-t border-white/5 flex">
							<a href="#apply" data-role="Staff MLOps & CUDA Engineer" class="apply-to-job-btn px-6 py-2.5 bg-cyan-400 hover:bg-cyan-300 hover:scale-[1.02] text-black font-mono text-[10px] font-bold uppercase tracking-wider rounded-full transition-all duration-300 hover:shadow-[0_0_15px_rgba(34,211,238,0.4)]">
								Apply For This Role
							</a>
						</div>
					</div>
				</div>

				<!-- Position 3: Lead Interactive Designer -->
				<div class="job-item border border-white/5 bg-white/[0.01] hover:bg-white/[0.02] backdrop-blur-md rounded-2xl overflow-hidden transition-all duration-300 hover:border-cyan-500/20 shadow-lg shadow-black/20" data-dept="design">
					<!-- Header (Trigger) -->
					<button class="w-full text-left p-6 sm:p-8 flex items-center justify-between gap-4 cursor-pointer outline-none group/jobbtn">
						<div class="space-y-2">
							<div class="flex flex-wrap items-center gap-2.5">
								<span class="font-mono text-[9px] tracking-widest text-purple-400 bg-purple-400/5 border border-purple-400/10 px-2 py-0.5 rounded uppercase">Design</span>
								<span class="font-mono text-[9px] tracking-widest text-neutral-400 bg-white/[0.02] border border-white/5 px-2 py-0.5 rounded uppercase">Remote</span>
								<span class="font-mono text-[9px] tracking-widest text-neutral-400 bg-white/[0.02] border border-white/5 px-2 py-0.5 rounded uppercase">Full-Time</span>
							</div>
