---
import Layout from '../layouts/Layout.astro';
---

<Layout title="diceforce IT | Something Great Is On The Way">
	<main class="glow-bg w-full min-h-screen h-dvh flex flex-col justify-center items-center px-4 pt-24 pb-16 relative overflow-x-hidden overflow-y-auto select-none">
		<!-- Interactive Mouse Spotlight Glow -->
		<div class="mouse-spotlight"></div>
		
		<!-- Grid lines and Diamond shapes overlay -->
		<div class="grid-overlay"></div>

		<!-- Top Header logo (positioned absolutely at top) -->
		<header class="absolute top-0 left-0 w-full px-6 sm:px-12 h-20 flex items-center justify-center z-40 animate-fade-in">
			<div class="max-w-7xl mx-auto w-full h-full flex items-center justify-center">
				<span class="text-sm sm:text-base font-space tracking-[0.3em] text-shimmer uppercase font-bold leading-none">diceforce IT</span>
			</div>
		</header>

		<!-- Main Center Section (perfectly centered vertically and horizontally) -->
		<div class="relative flex flex-col justify-center items-center gap-6 md:gap-8 z-30 max-w-4xl mx-auto text-center">
			
			<!-- Heading -->
			<div class="space-y-4 animate-fade-in animation-delay-200">
				<h1 class="font-syne font-semibold tracking-tight text-white leading-[1.1] text-balance">
					<span class="block text-3xl sm:text-4xl md:text-5xl lg:text-6xl">
						Something <span class="text-shimmer font-semibold inline-block">Great</span>
					</span>
					<span class="block text-2xl sm:text-3xl md:text-4xl lg:text-5xl text-white/35 mt-1 sm:mt-2">
						Is On The Way
					</span>
				</h1>
			</div>

			<!-- Center Illustration (3D Hand holding glass card) -->
			<div class="relative w-56 h-56 sm:w-64 sm:h-64 md:w-72 md:h-72 lg:w-80 lg:h-80 xl:w-[350px] xl:h-[350px] mx-auto animate-float animate-fade-in animation-delay-400 perspective-container">
				<!-- Outer glow behind hand -->
				<div class="absolute inset-0 bg-[#4F7DFF]/15 rounded-full filter blur-[64px] opacity-70 animate-pulse-slow"></div>
				
				<!-- Tilt element wrapper -->
				<div class="w-full h-full tilt-element relative z-10">
					<!-- Cinematic 3D Hand Illustration -->
					<img 
						src="/glowing-hand-icon.png" 
						alt="Cinematic 3D Hand holding a glowing glass card with star sparkle icon" 
						width="384"
						height="384"
						class="w-full h-full object-contain pointer-events-none select-none scale-105"
						loading="eager"
						fetchpriority="high"
					/>
				</div>

				<!-- Subtle shadow block underneath to fade it to black -->
				<div class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-black to-transparent z-20 pointer-events-none"></div>
			</div>

			<!-- Launch Button -->
			<div class="animate-fade-in animation-delay-500 z-40">
				<div class="relative group transition-transform duration-500 hover:scale-[1.015]">
					<!-- Outer atmospheric soft glow using logo colors (very subtle, low opacity) -->
					<div class="absolute -inset-1 bg-gradient-to-r from-[#0377ff] via-[#00deff] to-[#883ae2] rounded-full blur-md opacity-25 group-hover:opacity-60 transition-all duration-500 ease-out"></div>
					
					<!-- Rounded container that clips the rotating border gradient -->
					<div class="relative rounded-full p-[1px] overflow-hidden flex items-center justify-center bg-black shadow-[0_4px_12px_rgba(0,0,0,0.5)] group-hover:shadow-[0_0_20px_rgba(3,119,255,0.4)] transition-all duration-500">
						<!-- Rotating gradient element with logo colors -->
						<div class="absolute inset-[-200%] bg-[conic-gradient(from_0deg,#0377ff,#00deff,#883ae2,#00deff,#0377ff)] animate-border-spin"></div>
						
						<!-- Main Button Link -->
						<a 
							href="/home" 
							class="relative px-8 py-3.5 bg-black hover:bg-neutral-900 text-white font-semibold rounded-full transition-all duration-300 inline-flex items-center gap-2.5 text-sm font-sans tracking-wide cursor-pointer z-10 select-none group-hover:text-[#00deff]"
						>
							Launch Experience
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
						</a>
					</div>
				</div>
			</div>

		</div>

		<!-- Giant bold text logo with cinematic half-reveal from bottom -->
		<footer class="absolute bottom-0 left-0 w-full overflow-hidden pointer-events-none select-none z-10 reveal-mask">
			<div class="animate-reveal-up animation-delay-600">
				<h2 class="text-[8vw] sm:text-[9vw] lg:text-[110px] font-extrabold tracking-[10px] mr-[-10px] text-white uppercase leading-none font-syne select-none text-center">
					diceforce IT
				</h2>
			</div>
		</footer>
	</main>

	<!-- Inject inline CSS for dot animations & spotlight -->
	<style>
		@keyframes dot-fade {
			0%, 100% { opacity: 0.2; }
			50% { opacity: 1; }
		}
		.dot-1 { animation: dot-fade 1.4s infinite 0s; }
		.dot-2 { animation: dot-fade 1.4s infinite 0.2s; }
		.dot-3 { animation: dot-fade 1.4s infinite 0.4s; }

		/* Custom slow, smooth spin for the button border gradient */
		@keyframes border-spin {
			from {
				transform: rotate(0deg);
			}
			to {
				transform: rotate(360deg);
			}
		}
		.animate-border-spin {
			animation: border-spin 3s linear infinite;
		}

		/* Mouse Spotlight effect */
		.mouse-spotlight {
			position: absolute;
			inset: 0;
			background: radial-gradient(
				600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
				rgba(79, 125, 255, 0.09) 0%,
				transparent 75%
			);
			pointer-events: none;
			z-index: 1;
			transition: background 0.3s ease-out;
		}

		/* Hovering over the page increases interactive glow slightly */
		body:hover .mouse-spotlight {
			background: radial-gradient(
				700px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
				rgba(79, 125, 255, 0.11) 0%,
				transparent 75%
			);
		}

		/* 3D Perspective and Tilt transition rules */
		.perspective-container {
			perspective: 1200px;
		}
		.tilt-element {
			transform-style: preserve-3d;
			transition: transform 0.2s cubic-bezier(0.25, 1, 0.5, 1);
		}
	</style>

	<script>
		// Follow cursor for glowing spotlight effect & 3D tilt
		const mainElement = document.querySelector('main');
		const tiltElement = document.querySelector('.tilt-element');
		
		if (mainElement && tiltElement) {
			window.addEventListener('mousemove', (e) => {
				const rect = mainElement.getBoundingClientRect();
				const x = e.clientX - rect.left;
				const y = e.clientY - rect.top;
				
				// Update spotlight custom properties
				mainElement.style.setProperty('--mouse-x', `${x}px`);
				mainElement.style.setProperty('--mouse-y', `${y}px`);

				// Parallax 3D tilt calculation
				const centerX = rect.width / 2;
				const centerY = rect.height / 2;
				const percentX = (x - centerX) / centerX; // Range -1 to 1
				const percentY = (y - centerY) / centerY; // Range -1 to 1

				const maxTilt = 8; // Max rotation in degrees
				const tiltX = (percentY * maxTilt * -1).toFixed(2); // Rotate around X axis
				const tiltY = (percentX * maxTilt).toFixed(2);      // Rotate around Y axis

				// Apply 3D rotation and a subtle zoom on hover
				(tiltElement as HTMLElement).style.transform = `rotateX(${tiltX}deg) rotateY(${tiltY}deg) scale3d(1.02, 1.02, 1.02)`;
			});

			// Reset smooth rotation to zero when mouse leaves the page
			document.addEventListener('mouseleave', () => {
				(tiltElement as HTMLElement).style.transform = 'rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
			});
		}
	</script>
</Layout>
