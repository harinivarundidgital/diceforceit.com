---
import Layout from '../layouts/Layout.astro';
---

<Layout title="diceforce IT | Contact // Let's Talk" description="Thinking about your next move? Let's discuss how diceforce IT can help make it real. Reach out to our design, engineering, and strategy teams.">
	<!-- Ambient Background Glows & Grid (Behind Content) -->
	<div class="fixed inset-0 pointer-events-none z-0 overflow-hidden bg-[#000000]">
		<!-- Interactive Mouse Spotlight Glow -->
		<div id="bg-spotlight" class="mouse-spotlight absolute inset-0"></div>
		
		<!-- Centered soft radial glows (slow CSS drifting) -->
		<div class="absolute top-[20%] left-[10%] w-[500px] h-[500px] rounded-full bg-[#00deff]/[0.04] blur-[120px] animate-drift-slow"></div>
		<div class="absolute bottom-[20%] right-[10%] w-[600px] h-[600px] rounded-full bg-[#0377ff]/[0.04] blur-[140px] animate-drift-medium"></div>
		
		<!-- High-fidelity background grid overlay -->
		<div class="absolute inset-0 grid-overlay-home opacity-40"></div>
	</div>

	<!-- Floating Header Navigation -->
	<header id="main-header" class="fixed top-6 left-0 right-0 z-50 w-full flex justify-center transition-all duration-500 ease-out opacity-0 -translate-y-10 pointer-events-none">
		<div class="w-[92%] max-w-6xl relative backdrop-blur-lg bg-black/60 border border-white/10 rounded-full px-8 py-2 flex items-center justify-between shadow-[0_4px_30px_rgba(0,0,0,0.4),inset_0_1px_0_rgba(255,255,255,0.05)] z-50">
			
			<!-- Brand Logo & Link -->
			<a href="/home" class="flex items-center gap-3 group relative z-10 pointer-events-auto shrink-0">
				<img src="/diceforceITlogo_.gif" alt="diceforce IT Logo" class="w-14 h-14 object-contain filter drop-shadow-[0_0_8px_rgba(34,211,238,0.6)]" width="56" height="56" />
				<span class="text-[15px] font-space tracking-[0.25em] text-cyan-400 uppercase font-extrabold leading-none group-hover:text-white transition-colors">diceforce</span>
			</a>
			
			<!-- Navigation Links (Right Aligned) -->
			<nav class="hidden md:flex items-center gap-6 relative z-25 pointer-events-auto">
				<!-- Home -->
				<a href="/home#home" class="inline-flex items-center justify-center text-[13px] font-mono tracking-widest text-white/60 hover:text-cyan-400 transition-colors uppercase py-1 px-2 group/link">
					<span class="text-cyan-400 opacity-0 group-hover/link:opacity-100 transition-all duration-200 mr-1 translate-x-1 group-hover/link:translate-x-0">[</span>
					<span>Home</span>
					<span class="text-cyan-400 opacity-0 group-hover/link:opacity-100 transition-all duration-200 ml-1 -translate-x-1 group-hover/link:translate-x-0">]</span>
				</a>
				<!-- About -->
				<a href="/home#about" class="inline-flex items-center justify-center text-[13px] font-mono tracking-widest text-white/60 hover:text-cyan-400 transition-colors uppercase py-1 px-2 group/link">
					<span class="text-cyan-400 opacity-0 group-hover/link:opacity-100 transition-all duration-200 mr-1 translate-x-1 group-hover/link:translate-x-0">[</span>
					<span>About</span>
					<span class="text-cyan-400 opacity-0 group-hover/link:opacity-100 transition-all duration-200 ml-1 -translate-x-1 group-hover/link:translate-x-0">]</span>
				</a>
				
				<!-- Services Dropdown Group -->
				<div class="relative group/dropdown py-1 flex items-center justify-center">
					<a href="/home#services" class="inline-flex items-center justify-center text-[13px] font-mono tracking-widest text-white/60 hover:text-cyan-400 transition-colors uppercase py-1 px-2 gap-1 group/link">
						<span class="text-cyan-400 opacity-0 group-hover/link:opacity-100 transition-all duration-200 mr-1 translate-x-1 group-hover/link:translate-x-0">[</span>
						<span>Services</span>
						<span class="text-cyan-400 opacity-0 group-hover/link:opacity-100 transition-all duration-200 ml-1 -translate-x-1 group-hover/link:translate-x-0">]</span>
						<svg class="w-3 h-3 text-white/40 group-hover/dropdown:text-cyan-400 transition-colors group-hover/dropdown:rotate-180 transition-transform duration-300 animate-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
							<polyline points="6 9 12 15 18 9"></polyline>
						</svg>
					</a>
					
					<!-- Dropdown Menu Box -->
					<div class="absolute top-full left-1/2 -translate-x-1/2 pt-2.5 opacity-0 invisible group-hover/dropdown:opacity-100 group-hover/dropdown:visible transition-all duration-300 w-56 pointer-events-none group-hover/dropdown:pointer-events-auto z-50">
						<div class="backdrop-blur-md bg-black/95 border border-white/10 rounded-lg p-2 shadow-2xl flex flex-col items-stretch space-y-0.5">
							<a href="/home#services" class="inline-flex items-center justify-center text-[11px] font-mono uppercase tracking-widest text-neutral-400 hover:text-cyan-400 hover:bg-white/5 px-3 py-2 rounded transition-all group/dropitem">
								<span class="text-cyan-400 opacity-0 group-hover/dropitem:opacity-100 transition-all duration-200 mr-1.5 translate-x-1 group-hover/dropitem:translate-x-0">[</span>
								<span>AI & ML Services</span>
								<span class="text-cyan-400 opacity-0 group-hover/dropitem:opacity-100 transition-all duration-200 ml-1.5 -translate-x-1 group-hover/dropitem:translate-x-0">]</span>
							</a>
							<a href="/home#staffing" class="inline-flex items-center justify-center text-[11px] font-mono uppercase tracking-widest text-neutral-400 hover:text-cyan-400 hover:bg-white/5 px-3 py-2 rounded transition-all group/dropitem">
								<span class="text-cyan-400 opacity-0 group-hover/dropitem:opacity-100 transition-all duration-200 mr-1.5 translate-x-1 group-hover/dropitem:translate-x-0">[</span>
								<span>IT Staffing</span>
								<span class="text-cyan-400 opacity-0 group-hover/dropitem:opacity-100 transition-all duration-200 ml-1.5 -translate-x-1 group-hover/dropitem:translate-x-0">]</span>
							</a>
						</div>
					</div>
				</div>

				<!-- Careers -->
				<a href="/home#career" class="inline-flex items-center justify-center text-[13px] font-mono tracking-widest text-white/60 hover:text-cyan-400 transition-colors uppercase py-1 px-2 group/link">
					<span class="text-cyan-400 opacity-0 group-hover/link:opacity-100 transition-all duration-200 mr-1 translate-x-1 group-hover/link:translate-x-0">[</span>
					<span>Careers</span>
					<span class="text-cyan-400 opacity-0 group-hover/link:opacity-100 transition-all duration-200 ml-1 -translate-x-1 group-hover/link:translate-x-0">]</span>
				</a>
				
				<!-- Contact (Active) -->
				<a href="#" class="inline-flex items-center justify-center text-[13px] font-mono tracking-widest text-cyan-400 transition-colors uppercase py-1 px-2">
					<span class="text-cyan-400 opacity-100 mr-1">[</span>
					<span>Contact</span>
					<span class="text-cyan-400 opacity-100 ml-1">]</span>
				</a>
			</nav>
		</div>
	</header>

	<!-- High-fidelity Preloader Overlay -->
	<div id="sequence-loading-screen" class="fixed inset-0 bg-[#030303] z-[100] flex flex-col items-center justify-center transition-opacity duration-700 ease-out pointer-events-auto">
		<div class="flex flex-col items-center gap-6">
			<!-- Glowing Logo -->
			<div class="relative w-16 h-16">
				<img src="/diceforceITlogo_.gif" alt="diceforce IT Logo" class="w-full h-full object-contain" />
				<div class="absolute inset-[-4px] rounded-full border border-cyan-500/20 border-t-cyan-400 animate-spin duration-1000"></div>
			</div>
			<div class="text-center space-y-2">
				<div class="font-space text-[10px] tracking-[0.3em] text-white/80 uppercase">diceforce core</div>
				<div class="font-mono text-[9px] text-white/40 uppercase tracking-widest">
					Calibrating Neural Interface... <span id="loading-progress-text">0%</span>
				</div>
			</div>
			<!-- Loading bar container -->
			<div class="w-48 h-[1px] bg-white/5 rounded-full overflow-hidden">
				<div id="loading-progress-bar-fill" class="h-full w-0 bg-cyan-400 transition-all duration-300"></div>
			</div>
		</div>
	</div>

	<!-- Main Layout Layer (Swiss Minimalist Editorial Style) -->
	<main class="relative z-20 w-full min-h-screen text-white font-sans flex flex-col items-center px-6 sm:px-12 md:px-16 pt-36 pb-0 pointer-events-auto select-auto">
		<div class="max-w-6xl mx-auto w-full flex flex-col gap-20">
			
			<!-- SECTION 1: HERO -->
			<section class="space-y-6 animate-stagger-item">
				<h1 class="font-syne font-black text-5xl sm:text-7xl lg:text-[104px] tracking-tighter uppercase leading-[0.9] text-white select-text">
					Thinking about<br class="hidden sm:inline" />
					your next move?
				</h1>
				<p class="text-neutral-400 font-light text-base sm:text-lg max-w-xl border-l border-cyan-500/70 pl-4 mt-6 leading-relaxed select-text">
					Let’s discuss how diceforce IT can help make it real.
				</p>
			</section>

			<!-- SECTION 2: FORM & DETAILS GRID -->
			<section class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-start pt-16 mt-4 animate-stagger-item">
				
				<!-- Left Column: Let's talk & Contact Form (7 columns) -->
				<div class="lg:col-span-7 space-y-8">
					<div class="space-y-2">
						<h2 class="font-syne font-semibold text-3xl sm:text-4xl text-white tracking-tight leading-none select-text">
							Let's talk!
						</h2>
						<p class="text-neutral-400 text-sm select-text">
							We'd love to hear from you and your team.
						</p>
					</div>

					<div class="relative min-h-[380px]">
						<!-- Contact Form -->
						<form id="contact-form" class="space-y-6">
							<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
								<!-- Name -->
								<div class="border-b border-white/10 hover:border-white/20 focus-within:border-cyan-400 transition-all duration-300 py-1 relative">
									<label for="name" class="block font-mono text-[9px] uppercase tracking-widest text-neutral-400 mb-1">Your name</label>
									<input 
										type="text" 
										id="name" 
										name="name" 
										required 
										placeholder="Enter your name" 
										class="w-full bg-transparent text-sm text-white placeholder-neutral-600 outline-none py-1.5 transition-all rounded-none border-none"
									/>
								</div>
								<!-- Company -->
								<div class="border-b border-white/10 hover:border-white/20 focus-within:border-cyan-400 transition-all duration-300 py-1 relative">
									<label for="company" class="block font-mono text-[9px] uppercase tracking-widest text-neutral-400 mb-1">Company</label>
									<input 
										type="text" 
										id="company" 
										name="company" 
										required 
										placeholder="Enter your company name" 
										class="w-full bg-transparent text-sm text-white placeholder-neutral-600 outline-none py-1.5 transition-all rounded-none border-none"
									/>
								</div>
							</div>

							<!-- Email -->
							<div class="border-b border-white/10 hover:border-white/20 focus-within:border-cyan-400 transition-all duration-300 py-1 relative">
								<label for="email" class="block font-mono text-[9px] uppercase tracking-widest text-neutral-400 mb-1">Email</label>
								<input 
									type="email" 
									id="email" 
									name="email" 
									required 
									placeholder="Enter your email address" 
									class="w-full bg-transparent text-sm text-white placeholder-neutral-600 outline-none py-1.5 transition-all rounded-none border-none"
								/>
							</div>

							<!-- Message -->
							<div class="border-b border-white/10 hover:border-white/20 focus-within:border-cyan-400 transition-all duration-300 py-1 relative">
								<label for="message" class="block font-mono text-[9px] uppercase tracking-widest text-neutral-400 mb-1">Your message</label>
								<textarea 
									id="message" 
									name="message" 
									required 
									rows="4" 
									placeholder="Describe your project, stack, or timeline details..." 
									class="w-full bg-transparent text-sm text-white placeholder-neutral-600 outline-none py-1.5 transition-all resize-none rounded-none border-none"
								></textarea>
							</div>

							<div class="pt-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
								<button 
									type="submit" 
									class="w-full sm:w-auto bg-gradient-to-r from-[#0377ff] to-[#00deff] hover:from-[#005cff] hover:to-[#00c8ff] text-white font-mono text-xs font-bold uppercase tracking-widest py-4 px-10 rounded-xl transition-all duration-300 hover:scale-[1.02] active:scale-[0.98] cursor-pointer shadow-[0_4px_24px_rgba(3,119,255,0.2)] hover:shadow-[0_8px_32px_rgba(0,222,255,0.3)] z-10"
								>
									Submit
								</button>
								<p class="text-[10px] font-mono text-neutral-500 tracking-wider">
									By submitting, you agree to our <a href="/terms" class="text-neutral-400 hover:text-white underline transition-colors">Terms & Service</a>.
								</p>
							</div>
						</form>

						<!-- Success state (Hidden initially) -->
						<div id="success-screen" class="hidden absolute inset-0 bg-[#000000]/95 backdrop-blur-md flex flex-col items-center justify-center text-center space-y-6 py-6 rounded-2xl z-20">
							<div class="relative w-16 h-16 mb-2">
								<div class="absolute inset-0 rounded-full border border-cyan-400/20 bg-cyan-400/5 animate-pulse-slow"></div>
								<div class="absolute inset-2 rounded-full border border-cyan-400/40 flex items-center justify-center">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
										<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
									</svg>
								</div>
							</div>
							<div class="space-y-2 px-6">
								<h3 class="text-2xl font-syne font-bold tracking-tight text-white uppercase select-text">Message Sent</h3>
								<p class="text-xs font-mono text-neutral-400 max-w-sm mx-auto leading-relaxed select-text">
									Your transmission has been successfully routed. Expected response latency: <span class="text-cyan-400">24 hours</span>.
								</p>
							</div>
							<button 
								id="reset-form-btn" 
								class="text-[10px] font-mono tracking-widest text-cyan-400 hover:text-white uppercase transition-colors pointer-events-auto cursor-pointer"
							>
								// Send Another Message
							</button>
						</div>
					</div>
				</div>

				<!-- Right Column: Quote & Live Status / Contacts (5 columns) -->
				<div class="lg:col-span-5 space-y-10 lg:pl-4">
					<!-- Quote Card -->
					<div class="bg-neutral-950/40 border border-white/5 p-8 rounded-2xl flex flex-col justify-between relative">
						<div class="absolute top-0 left-0 w-full h-[1.5px] bg-gradient-to-r from-transparent via-cyan-400/20 to-transparent"></div>
						<p class="text-lg sm:text-xl font-light text-neutral-300 leading-relaxed italic select-text">
							"We listen first, stay transparent, and deliver what we promise. Every project matters to us."
						</p>
						<div class="border-t border-white/5 pt-6 mt-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
							<div>
								<span class="text-white text-sm font-semibold block select-text">Tobias Neumann</span>
								<span class="text-neutral-500 text-xs block select-text">CEO of diceforce IT</span>
							</div>
							<a 
								href="https://calendly.com/" 
								target="_blank" 
								rel="noopener" 
								class="inline-block border border-white/10 hover:border-white/30 text-white font-mono text-[10px] tracking-widest uppercase py-3 px-6 rounded-lg text-center transition-all hover:bg-white/5 hover:scale-[1.02] cursor-pointer"
							>
								Book an Intro Call
							</a>
						</div>
					</div>

					<!-- Live Status / Address Details -->
					<div class="space-y-8 pl-2">
						<!-- Live Status Indicator -->
						<div class="flex items-center gap-3">
							<span class="relative flex h-2 w-2">
								<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
								<span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
							</span>
							<span class="text-xs font-mono text-neutral-400 uppercase tracking-widest select-text">
								Online <span class="text-neutral-600">//</span> Local time: <span id="local-time" class="text-white font-medium">--:--:--</span>
							</span>
						</div>

						<!-- Address details grid -->
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-8 text-xs sm:text-sm font-light text-neutral-400">
							<div class="space-y-1">
								<strong class="text-white font-semibold block mb-1 font-sans">Office</strong>
								<p class="leading-relaxed select-text">
									diceforce IT LLC.<br />
									567 Sunset Blvd, Suite 501<br />
									Los Angeles, CA 90026
								</p>
							</div>
							<div class="space-y-3">
								<div>
									<strong class="text-white font-semibold block mb-1 font-sans">Email</strong>
									<a href="mailto:hello@diceforceit.com" class="text-neutral-300 hover:text-cyan-400 transition-colors block select-text font-mono text-xs">
										hello@diceforceit.com
									</a>
								</div>
								<div>
									<strong class="text-white font-semibold block mb-0.5 font-sans">Phone</strong>
									<span class="block select-text font-mono">(310) 555-0165</span>
								</div>
							</div>
						</div>
					</div>
				</div>

			</section>

			<!-- SECTION 3: STATS BANNER -->
			<section class="py-16 animate-stagger-item">
				<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
					<!-- Left Column: 10 Years -->
					<div class="lg:col-span-5 space-y-4">
						<div class="flex items-baseline gap-2">
							<span class="font-syne font-black text-7xl sm:text-8xl lg:text-[104px] text-white tracking-tighter leading-none select-text">10</span>
							<span class="font-mono text-xs uppercase tracking-widest text-cyan-400 font-bold select-text">Years</span>
						</div>
						<p class="text-neutral-400 font-light text-base leading-relaxed max-w-sm select-text">
							Building lasting partnerships, scaling brands, and shipping work that stands out in the AI landscape.
						</p>
					</div>
					<!-- Right Column: 3 Stats Cards -->
					<div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-3 gap-6">
						<div class="border border-white/5 bg-neutral-900/10 p-6 rounded-xl space-y-1 relative">
							<div class="absolute top-0 left-0 w-8 h-[1px] bg-cyan-400/40"></div>
							<span class="text-3xl font-syne font-bold text-white block select-text">120+</span>
							<span class="text-[10px] font-mono text-neutral-500 uppercase tracking-wider block select-text">Projects Delivered</span>
						</div>
						<div class="border border-white/5 bg-neutral-900/10 p-6 rounded-xl space-y-1 relative">
							<div class="absolute top-0 left-0 w-8 h-[1px] bg-cyan-400/40"></div>
							<span class="text-3xl font-syne font-bold text-white block select-text">99%</span>
							<span class="text-[10px] font-mono text-neutral-500 uppercase tracking-wider block select-text">On-time Launches</span>
						</div>
						<div class="border border-white/5 bg-neutral-900/10 p-6 rounded-xl space-y-1 relative">
							<div class="absolute top-0 left-0 w-8 h-[1px] bg-cyan-400/40"></div>
							<span class="text-3xl font-syne font-bold text-white block select-text">84%</span>
							<span class="text-[10px] font-mono text-neutral-500 uppercase tracking-wider block select-text">Avg Engagement Boost</span>
						</div>
					</div>
				</div>
			</section>

			<!-- SECTION 4: SCROLLING MARQUEE -->
			<section class="relative w-full overflow-hidden py-6 select-none pointer-events-none animate-stagger-item">
				<div class="animate-marquee flex gap-8 whitespace-nowrap">
					<!-- Instance 1 -->
					<span class="font-syne font-extrabold text-5xl sm:text-7xl text-transparent uppercase tracking-tight" style="-webkit-text-stroke: 1px rgba(0, 222, 255, 0.40)">
						Let us inspire your next project • Let us inspire your next project • Let us inspire your next project • Let us inspire your next project • 
					</span>
					<!-- Instance 2 -->
					<span class="font-syne font-extrabold text-5xl sm:text-7xl text-transparent uppercase tracking-tight" style="-webkit-text-stroke: 1px rgba(0, 222, 255, 0.40)">
						Let us inspire your next project • Let us inspire your next project • Let us inspire your next project • Let us inspire your next project • 
					</span>
				</div>
			</section>

			<footer class="relative w-full pt-28 pb-40 mt-20 overflow-hidden bg-black animate-stagger-item">
				
				<!-- Footer Background Image (Cover & Center) -->
				<div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
					<img 
						src="/footerbackground.jpg" 
						alt="Footer Background" 
						class="w-full h-full object-cover object-center scale-[1.25] opacity-45 mix-blend-screen" 
						style="mix-blend-mode: screen;"
					/>
				</div>

				<!-- Dark Overlay to guarantee high contrast and readability -->
				<div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/45 to-black/20 z-1 pointer-events-none"></div>

				<!-- Footer Content Grid -->
				<div class="max-w-6xl mx-auto w-full grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-16 relative z-10 pointer-events-auto">
					<!-- Brand Block -->
					<div class="lg:col-span-4 space-y-3">
						<a href="/home" class="flex items-center gap-3">
							<img src="/diceforceITlogo_.gif" alt="Diceforce IT" class="w-14 h-14 object-contain" width="56" height="56" />
							<span class="text-[13px] font-space tracking-[0.25em] text-cyan-400 font-bold leading-none select-text">Diceforce IT</span>
						</a>
						<p class="text-neutral-300 text-[13px] leading-relaxed max-w-xs select-text">
							Digital experiences that connect, scale and perform. A creative technology studio for design, strategy, marketing, and scalable AI solutions.
						</p>
						<span class="text-[13px] font-mono text-neutral-400 block pt-3 select-text">
							© 2026 diceforce IT — All work, all rights reserved.
						</span>
					</div>
					
					<!-- Column 2: Navigate -->
					<div class="lg:col-span-2 space-y-3">
						<h4 class="text-[13px] font-mono uppercase tracking-[0.2em] text-white font-bold select-text">Navigate</h4>
						<ul class="space-y-2 text-[13px] text-neutral-300 font-sans">
							<li><a href="/home#home" class="hover:text-cyan-400 transition-colors">// Home</a></li>
							<li><a href="/home#about" class="hover:text-cyan-400 transition-colors">// About</a></li>
							<li><a href="/home#services" class="hover:text-cyan-400 transition-colors">// Services</a></li>
							<li><a href="/home#staffing" class="hover:text-cyan-400 transition-colors">// Staffing</a></li>
