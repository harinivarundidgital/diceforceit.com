---
import Layout from '../layouts/Layout.astro';
---

<Layout title="diceforce IT | Contact // Let's Talk" description="Thinking about your next move? Let's discuss how diceforce IT can help make it real. Reach out to our design, engineering, and staffing teams.">
	<!-- Ambient Background Glows & Grid (Behind Content) -->
	<div class="fixed inset-0 pointer-events-none z-0 overflow-hidden bg-[#020205]">
		<!-- Interactive Mouse Spotlight Glow -->
		<div id="bg-spotlight" class="mouse-spotlight absolute inset-0"></div>
		
		<!-- Centered soft radial glows using logo colors (slow CSS drifting) -->
		<div class="absolute top-[10%] left-[-5%] w-[600px] h-[600px] rounded-full bg-[#00deff]/[0.12] blur-[130px] animate-drift-slow"></div>
		<div class="absolute bottom-[10%] right-[-5%] w-[700px] h-[700px] rounded-full bg-[#0377ff]/[0.12] blur-[150px] animate-drift-medium"></div>
		<div class="absolute top-[40%] right-[15%] w-[550px] h-[550px] rounded-full bg-[#883ae2]/[0.10] blur-[120px] animate-drift-slow"></div>
		
		<!-- High-fidelity background grid overlay -->
		<div class="absolute inset-0 grid-overlay-home opacity-40"></div>
	</div>

	<!-- Floating Header Navigation -->
	<header id="main-header" class="fixed top-6 left-0 right-0 z-50 w-full flex justify-center transition-all duration-500 ease-out opacity-0 -translate-y-10 pointer-events-none">
		<div class="w-[92%] max-w-6xl relative backdrop-blur-lg bg-black/60 border border-white/10 rounded-full px-8 py-2 flex items-center justify-between shadow-[0_4px_30px_rgba(0,0,0,0.4),inset_0_1px_0_rgba(255,255,255,0.05)] z-50">
			
			<!-- Brand Logo & Link -->
			<a href="/home" class="flex items-center gap-3 group relative z-10 pointer-events-auto shrink-0 transition-colors">
				<img src="/diceforceITlogo_.gif" alt="diceforce IT Logo" class="w-14 h-14 object-contain filter drop-shadow-[0_0_8px_rgba(34,211,238,0.6)]" width="56" height="56" />
				<span class="text-[15px] font-space tracking-[0.25em] text-cyan-400 uppercase font-extrabold leading-none group-hover:text-white transition-colors">diceforce</span>
			</a>
			
			<!-- Navigation Links (Right Aligned) -->
			<nav class="hidden md:flex items-center gap-6 relative z-25 pointer-events-auto">
				<!-- Home -->
				<a href="/home#home" class="inline-flex items-center justify-center text-[13px] font-mono tracking-widest text-white/60 hover:text-cyan-400 transition-colors uppercase py-1 px-2 group/link">
					<span class="text-cyan-400 opacity-0 group-hover/link:opacity-100 transition-[opacity,transform] duration-200 mr-1 translate-x-1 group-hover/link:translate-x-0">[</span>
					<span>Home</span>
					<span class="text-cyan-400 opacity-0 group-hover/link:opacity-100 transition-[opacity,transform] duration-200 ml-1 -translate-x-1 group-hover/link:translate-x-0">]</span>
				</a>
				<!-- About -->
				<a href="/home#about" class="inline-flex items-center justify-center text-[13px] font-mono tracking-widest text-white/60 hover:text-cyan-400 transition-colors uppercase py-1 px-2 group/link">
					<span class="text-cyan-400 opacity-0 group-hover/link:opacity-100 transition-[opacity,transform] duration-200 mr-1 translate-x-1 group-hover/link:translate-x-0">[</span>
					<span>About</span>
					<span class="text-cyan-400 opacity-0 group-hover/link:opacity-100 transition-[opacity,transform] duration-200 ml-1 -translate-x-1 group-hover/link:translate-x-0">]</span>
				</a>
				
				<!-- Services Dropdown Group -->
				<div class="relative group/dropdown py-1 flex items-center justify-center">
					<a href="/home#services" class="inline-flex items-center justify-center text-[13px] font-mono tracking-widest text-white/60 hover:text-cyan-400 transition-colors uppercase py-1 px-2 gap-1 group/link">
						<span class="text-cyan-400 opacity-0 group-hover/link:opacity-100 transition-[opacity,transform] duration-200 mr-1 translate-x-1 group-hover/link:translate-x-0">[</span>
						<span>Services</span>
						<span class="text-cyan-400 opacity-0 group-hover/link:opacity-100 transition-[opacity,transform] duration-200 ml-1 -translate-x-1 group-hover/link:translate-x-0">]</span>
						<svg class="w-3.5 h-3.5 text-white/40 group-hover/dropdown:text-cyan-400 transition-[color,transform] group-hover/dropdown:rotate-180 duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
							<polyline points="6 9 12 15 18 9"></polyline>
						</svg>
					</a>
					
					<!-- Dropdown Menu Box -->
					<div class="absolute top-full left-1/2 -translate-x-1/2 pt-2.5 opacity-0 invisible group-hover/dropdown:opacity-100 group-hover/dropdown:visible transition-[opacity,visibility] duration-300 w-56 pointer-events-none group-hover/dropdown:pointer-events-auto z-50">
						<div class="backdrop-blur-md bg-black/95 border border-white/10 rounded-lg p-2 shadow-2xl flex flex-col items-stretch space-y-0.5">
							<a href="/home#services" class="inline-flex items-center justify-center text-[11px] font-mono uppercase tracking-widest text-neutral-400 hover:text-cyan-400 hover:bg-white/5 px-3 py-2 rounded transition-[color,background-color] group/dropitem">
								<span class="text-cyan-400 opacity-0 group-hover/dropitem:opacity-100 transition-[opacity,transform] duration-200 mr-1.5 translate-x-1 group-hover/dropitem:translate-x-0">[</span>
								<span>AI & ML Services</span>
								<span class="text-cyan-400 opacity-0 group-hover/dropitem:opacity-100 transition-[opacity,transform] duration-200 ml-1.5 -translate-x-1 group-hover/dropitem:translate-x-0">]</span>
							</a>
							<a href="/home#staffing" class="inline-flex items-center justify-center text-[11px] font-mono uppercase tracking-widest text-neutral-400 hover:text-cyan-400 hover:bg-white/5 px-3 py-2 rounded transition-[color,background-color] group/dropitem">
								<span class="text-cyan-400 opacity-0 group-hover/dropitem:opacity-100 transition-[opacity,transform] duration-200 mr-1.5 translate-x-1 group-hover/dropitem:translate-x-0">[</span>
								<span>IT Staffing</span>
								<span class="text-cyan-400 opacity-0 group-hover/dropitem:opacity-100 transition-[opacity,transform] duration-200 ml-1.5 -translate-x-1 group-hover/dropitem:translate-x-0">]</span>
							</a>
						</div>
					</div>
				</div>

				<!-- Careers -->
				<a href="/home#career" class="inline-flex items-center justify-center text-[13px] font-mono tracking-widest text-white/60 hover:text-cyan-400 transition-colors uppercase py-1 px-2 group/link">
					<span class="text-cyan-400 opacity-0 group-hover/link:opacity-100 transition-[opacity,transform] duration-200 mr-1 translate-x-1 group-hover/link:translate-x-0">[</span>
					<span>Careers</span>
					<span class="text-cyan-400 opacity-0 group-hover/link:opacity-100 transition-[opacity,transform] duration-200 ml-1 -translate-x-1 group-hover/link:translate-x-0">]</span>
				</a>
				
				<!-- Contact (Active) -->
				<a href="#" class="inline-flex items-center justify-center text-[13px] font-mono tracking-widest text-cyan-400 transition-colors uppercase py-1 px-2">
					<span class="text-cyan-400 opacity-100 mr-1">[</span>
					<span>Contact</span>
					<span class="text-cyan-400 opacity-100 ml-1">]</span>
				</a>
			</nav>
		</div>
	</header>

	<!-- High-fidelity Preloader Overlay -->
	<div id="sequence-loading-screen" class="fixed inset-0 bg-[#030303] z-[100] flex flex-col items-center justify-center transition-opacity duration-700 ease-out pointer-events-auto">
		<div class="flex flex-col items-center gap-6">
			<!-- Glowing Logo -->
			<div class="relative w-16 h-16">
				<img src="/diceforceITlogo_.gif" alt="diceforce IT Logo" class="w-full h-full object-contain" />
				<div class="absolute inset-[-4px] rounded-full border border-cyan-500/20 border-t-cyan-400 animate-spin duration-1000"></div>
			</div>
			<div class="text-center space-y-2">
				<div class="font-space text-[10px] tracking-[0.3em] text-white/80 uppercase">diceforce core</div>
				<div class="font-mono text-[9px] text-white/40 uppercase tracking-widest">
					Calibrating Neural Interface… <span id="loading-progress-text">0%</span>
				</div>
			</div>
			<!-- Loading bar container -->
			<div class="w-48 h-[1px] bg-white/5 rounded-full overflow-hidden">
				<div id="loading-progress-bar-fill" class="h-full w-0 bg-cyan-400 transition-all duration-300"></div>
			</div>
		</div>
	</div>

	<!-- Main Layout Layer (Swiss Minimalist Editorial Style) -->
	<main class="relative z-20 w-full min-h-screen text-white font-sans flex flex-col items-center px-6 sm:px-12 md:px-16 pt-36 pb-0 pointer-events-auto select-auto">
		<div class="max-w-6xl mx-auto w-full flex flex-col gap-12">
			
			<!-- SECTION 1: HERO (2-Column Layout) -->
			<section class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center animate-stagger-item">
				<!-- Left Column: Hero Copy -->
				<div class="lg:col-span-7 space-y-6">
					<h1 class="font-syne font-black text-4xl sm:text-5xl md:text-6xl lg:text-7xl tracking-tighter leading-[0.95] text-white select-text text-balance">
						Thinking about<br class="hidden sm:inline" />
						your next move?
					</h1>
					<p class="text-neutral-400 font-light text-base sm:text-lg max-w-xl mt-6 leading-relaxed select-text">
						Let’s discuss how diceforce IT can help make it real. Reach out to our design, engineering, and staffing teams.
					</p>
				</div>
				<!-- Right Column: Interactive Particles (Loaded from SVG) -->
				<div class="lg:col-span-5 relative w-full h-[400px] sm:h-[480px] lg:h-[550px] flex items-center justify-center overflow-hidden">
					<div class="absolute inset-0 bg-[#00deff]/[0.02] blur-[80px] rounded-full pointer-events-none"></div>
					<!-- Three.js Canvas Container -->
					<div id="canvas-container" class="w-full h-full cursor-grab active:cursor-grabbing relative z-10"></div>
				</div>
			</section>

			<!-- SECTION 2: CONTACT DETAILS & INQUIRY FORM -->
			<section class="border-t border-white/5 pt-16 pb-20 animate-stagger-item">
				<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-start">
					
					<!-- Left Column: Details (5 columns) -->
					<div class="lg:col-span-5 space-y-8 lg:pr-4">
						<div class="space-y-4">
							<h2 class="font-syne font-semibold text-2xl sm:text-3xl text-white tracking-tight leading-none select-text">
								Get in touch directly
							</h2>
							<p class="text-neutral-400 text-sm leading-relaxed select-text font-light">
								Whether you have a specific project in mind, need technical staffing support, or just want to explore possibilities, we're here to help.
							</p>
						</div>

						<!-- Address details stack (Clean, neat & minimal) -->
						<div class="space-y-6 pt-6 border-t border-white/5">
							<div class="space-y-2">
								<span class="text-neutral-500 font-mono text-[11px] uppercase tracking-wider block">Office</span>
								<p class="text-neutral-300 text-sm leading-relaxed select-text font-light">
									diceforce IT LLC.<br />
									567 Sunset Blvd, Suite 501<br />
									Los Angeles, CA 90026
								</p>
							</div>
							<div class="space-y-2">
								<span class="text-neutral-500 font-mono text-[11px] uppercase tracking-wider block">Email</span>
								<a href="mailto:hello@diceforceit.com" class="text-neutral-300 hover:text-white transition-colors block select-text font-mono text-sm">
									hello@diceforceit.com
								</a>
							</div>
							<div class="space-y-2">
								<span class="text-neutral-500 font-mono text-[11px] uppercase tracking-wider block">Phone</span>
								<span class="text-neutral-300 font-mono text-sm block select-text">(310) 555-0165</span>
							</div>
						</div>
					</div>

					<!-- Right Column: Inquiry Form (7 columns) -->
					<div class="lg:col-span-7 space-y-8">
						<div class="space-y-2">
							<h2 class="font-syne font-semibold text-2xl sm:text-3xl text-white tracking-tight leading-none select-text">
								Send a message
							</h2>
							<p class="text-neutral-400 text-sm select-text font-light">
								Configure your inquiry and our team will get back to you shortly.
							</p>
						</div>

						<div class="relative min-h-[460px]">
							<!-- Contact Form -->
							<form id="contact-form" class="space-y-6">
								<!-- 1. Inquiry Type (Clean cards) -->
								<div class="space-y-3">
									<span class="block font-mono text-[11px] uppercase tracking-widest text-neutral-400">Inquiry Type</span>
									<div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
										<label class="relative flex flex-col p-4 border border-white/5 rounded-xl cursor-pointer bg-neutral-950/20 hover:border-white/10 transition-colors select-none focus-within:border-white/30">
											<input type="radio" name="inquiry_type" value="ai_ml" class="sr-only" checked />
											<span class="text-xs font-mono text-white uppercase tracking-wider font-semibold">AI & ML Solutions</span>
											<span class="text-[10px] text-neutral-400 mt-1 leading-normal font-light">Custom models & systems</span>
										</label>
										<label class="relative flex flex-col p-4 border border-white/5 rounded-xl cursor-pointer bg-neutral-950/20 hover:border-white/10 transition-colors select-none focus-within:border-white/30">
											<input type="radio" name="inquiry_type" value="staffing" class="sr-only" />
											<span class="text-xs font-mono text-white uppercase tracking-wider font-semibold">IT Staffing</span>
											<span class="text-[10px] text-neutral-400 mt-1 leading-normal font-light">Embed dedicated specialists</span>
										</label>
										<label class="relative flex flex-col p-4 border border-white/5 rounded-xl cursor-pointer bg-neutral-950/20 hover:border-white/10 transition-colors select-none focus-within:border-white/30">
											<input type="radio" name="inquiry_type" value="general" class="sr-only" />
											<span class="text-xs font-mono text-white uppercase tracking-wider font-semibold">General Inquiry</span>
											<span class="text-[10px] text-neutral-400 mt-1 leading-normal font-light">Other questions & topics</span>
										</label>
									</div>
								</div>

								<!-- 2. Name & Company -->
								<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
									<!-- Name -->
									<div class="border-b border-white/10 hover:border-white/20 focus-within:border-white transition-colors duration-300 py-1 relative">
										<label for="name" class="block font-mono text-[11px] uppercase tracking-widest text-neutral-400 mb-1">Your name</label>
										<input 
											type="text" 
											id="name" 
											name="name" 
											required 
											autocomplete="name"
											placeholder="e.g. Tobias Neumann…" 
											class="w-full bg-transparent text-sm text-white placeholder-neutral-600 outline-none py-1.5 transition-colors rounded-none border-none animate-none focus:ring-0"
										/>
									</div>
									<!-- Company -->
									<div class="border-b border-white/10 hover:border-white/20 focus-within:border-white transition-colors duration-300 py-1 relative">
										<label for="company" class="block font-mono text-[11px] uppercase tracking-widest text-neutral-400 mb-1">Company</label>
										<input 
											type="text" 
											id="company" 
											name="company" 
											required 
											autocomplete="organization"
											placeholder="e.g. diceforce IT…" 
											class="w-full bg-transparent text-sm text-white placeholder-neutral-600 outline-none py-1.5 transition-colors rounded-none border-none animate-none focus:ring-0"
										/>
									</div>
								</div>

								<!-- 3. Email -->
								<div class="border-b border-white/10 hover:border-white/20 focus-within:border-white transition-colors duration-300 py-1 relative">
									<label for="email" class="block font-mono text-[11px] uppercase tracking-widest text-neutral-400 mb-1">Email</label>
									<input 
										type="email" 
										id="email" 
										name="email" 
										required 
										autocomplete="email"
										spellcheck="false"
										placeholder="e.g. hello@diceforceit.com…" 
										class="w-full bg-transparent text-sm text-white placeholder-neutral-600 outline-none py-1.5 transition-colors rounded-none border-none animate-none focus:ring-0"
									/>
								</div>

								<!-- 4. Interactive selection pills for Skills/Capabilities -->
								<div class="space-y-4">
									<span class="block font-mono text-[11px] uppercase tracking-widest text-neutral-400">Select Areas of Interest</span>
									
									<div class="grid grid-cols-1 sm:grid-cols-2 gap-6 bg-neutral-950/20 border border-white/5 rounded-2xl p-5">
										<!-- AI & ML Group -->
										<div id="pills-ai-ml" class="space-y-2 transition-opacity duration-300">
											<span class="block font-mono text-[9px] text-white/80 uppercase tracking-widest font-semibold">// AI & ML Solutions</span>
											<div class="flex flex-wrap gap-2">
												<label class="relative flex items-center justify-center px-3 py-1.5 border border-white/5 rounded-full cursor-pointer bg-neutral-950/40 hover:border-white/10 transition-colors select-none text-[10px] font-mono text-neutral-300">
													<input type="checkbox" name="services" value="llms_agents" class="sr-only" />
													<span>LLMs & Agents</span>
												</label>
												<label class="relative flex items-center justify-center px-3 py-1.5 border border-white/5 rounded-full cursor-pointer bg-neutral-950/40 hover:border-white/10 transition-colors select-none text-[10px] font-mono text-neutral-300">
													<input type="checkbox" name="services" value="fine_tuning" class="sr-only" />
													<span>Fine-Tuning</span>
												</label>
												<label class="relative flex items-center justify-center px-3 py-1.5 border border-white/5 rounded-full cursor-pointer bg-neutral-950/40 hover:border-white/10 transition-colors select-none text-[10px] font-mono text-neutral-300">
													<input type="checkbox" name="services" value="vector_db" class="sr-only" />
													<span>Vector DBs</span>
												</label>
											</div>
										</div>

										<!-- Staffing Group -->
										<div id="pills-staffing" class="space-y-2 transition-opacity duration-300">
											<span class="block font-mono text-[9px] text-white/80 uppercase tracking-widest font-semibold">// IT Staffing Roles</span>
											<div class="flex flex-wrap gap-2">
												<label class="relative flex items-center justify-center px-3 py-1.5 border border-white/5 rounded-full cursor-pointer bg-neutral-950/40 hover:border-white/10 transition-colors select-none text-[10px] font-mono text-neutral-300">
													<input type="checkbox" name="services" value="ai_researchers" class="sr-only" />
													<span>AI Researchers</span>
												</label>
												<label class="relative flex items-center justify-center px-3 py-1.5 border border-white/5 rounded-full cursor-pointer bg-neutral-950/40 hover:border-white/10 transition-colors select-none text-[10px] font-mono text-neutral-300">
													<input type="checkbox" name="services" value="mlops" class="sr-only" />
													<span>MLOps Engineers</span>
												</label>
												<label class="relative flex items-center justify-center px-3 py-1.5 border border-white/5 rounded-full cursor-pointer bg-neutral-950/40 hover:border-white/10 transition-colors select-none text-[10px] font-mono text-neutral-300">
													<input type="checkbox" name="services" value="backend" class="sr-only" />
													<span>Backend Pioneers</span>
												</label>
											</div>
										</div>
									</div>
								</div>

								<!-- 5. Message -->
								<div class="border-b border-white/10 hover:border-white/20 focus-within:border-white transition-colors duration-300 py-1 relative">
									<label for="message" class="block font-mono text-[11px] uppercase tracking-widest text-neutral-400 mb-1">Your message</label>
									<textarea 
										id="message" 
										name="message" 
										required 
										rows="4" 
										placeholder="e.g. We need dedicated MLOps support for a custom LLM pipeline…" 
										class="w-full bg-transparent text-sm text-white placeholder-neutral-600 outline-none py-1.5 transition-colors resize-none rounded-none border-none focus:ring-0"
									></textarea>
								</div>

								<div class="pt-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
									<div class="w-full sm:w-auto z-10">
										<div class="relative group transition-transform duration-500 hover:scale-[1.015] w-full sm:w-auto">
											<!-- Outer atmospheric soft glow using logo colors -->
											<div class="absolute -inset-1 bg-gradient-to-r from-[#0377ff] via-[#00deff] to-[#883ae2] rounded-full blur-md opacity-25 group-hover:opacity-60 transition-all duration-500 ease-out"></div>
											
											<!-- Rounded container that clips the rotating border gradient -->
											<div class="relative rounded-full p-[1px] overflow-hidden flex items-center justify-center bg-black shadow-[0_4px_12px_rgba(0,0,0,0.5)] group-hover:shadow-[0_0_20px_rgba(3,119,255,0.4)] transition-all duration-500 w-full sm:w-auto">
												<!-- Rotating gradient element with logo colors -->
												<div class="absolute inset-[-200%] bg-[conic-gradient(from_0deg,#0377ff,#00deff,#883ae2,#00deff,#0377ff)] animate-border-spin"></div>
												
												<!-- Main Button -->
												<button 
													type="submit" 
													class="relative w-full sm:w-auto px-10 py-4 bg-black hover:bg-neutral-900 text-white font-mono text-xs font-bold uppercase tracking-widest rounded-full transition-all duration-300 inline-flex items-center justify-center gap-2.5 cursor-pointer z-10 select-none group-hover:text-[#00deff] border-none focus:outline-none"
												>
													Submit Inquiry
												</button>
											</div>
										</div>
									</div>
									<p class="text-[10px] font-mono text-neutral-500 tracking-wider">
										By submitting, you agree to our <a href="/terms" class="text-neutral-400 hover:text-white underline transition-colors">Terms of Service</a>.
									</p>
								</div>
							</form>

							<!-- Success state (Hidden initially) -->
							<div id="success-screen" class="hidden absolute inset-0 bg-[#000000]/98 backdrop-blur-md flex flex-col items-center justify-center text-center space-y-6 py-6 rounded-2xl z-20 border border-white/10">
								<div class="relative w-16 h-16 mb-2">
									<div class="absolute inset-0 rounded-full border border-white/10 bg-white/5 animate-pulse-slow"></div>
									<div class="absolute inset-2 rounded-full border border-white/20 flex items-center justify-center">
										<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
											<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
										</svg>
									</div>
								</div>
								<div class="space-y-4 px-6 max-w-md">
									<h3 class="text-xl font-syne font-bold tracking-tight text-white uppercase select-text">Transmission Complete</h3>
									
									<!-- Simulated Console -->
									<div class="bg-black/90 border border-white/10 rounded-lg p-4 font-mono text-[9px] text-left text-neutral-400 space-y-1.5 overflow-hidden h-28 max-w-sm mx-auto shadow-inner">
										<div class="terminal-line opacity-0">> CALIBRATING NEURAL ROUTING… [OK]</div>
