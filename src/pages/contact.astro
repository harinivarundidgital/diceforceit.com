---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout 
	title="diceforce IT | Contact | Let's Talk" 
	description="Thinking about your next move? Let's discuss how diceforce IT can help make it real. Reach out to our design, engineering, and staffing teams."
	activePage="contact"
>
	<div class="max-w-6xl mx-auto w-full flex flex-col gap-12">
		
		<!-- SECTION 1: HERO (2-Column Layout) -->
		<section class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center animate-stagger-item">
			<!-- Left Column: Hero Copy -->
			<div class="lg:col-span-7 space-y-6">
				<h1 class="font-syne font-black text-4xl sm:text-5xl md:text-6xl lg:text-7xl tracking-tighter leading-[0.95] text-white select-text text-balance">
					Thinking about<br class="hidden sm:inline" />
					your next move?
				</h1>
				<p class="text-neutral-400 font-light text-base sm:text-lg max-w-xl mt-6 leading-relaxed select-text">
					Let’s discuss how diceforce IT can help make it real. Reach out to our design, engineering, and staffing teams.
				</p>
			</div>
			<!-- Right Column: Interactive Particles (Loaded from SVG) -->
			<div class="lg:col-span-5 relative w-full h-[400px] sm:h-[480px] lg:h-[550px] flex items-center justify-center overflow-hidden">
				<div class="absolute inset-0 bg-[#00deff]/[0.02] blur-[80px] rounded-full pointer-events-none"></div>
				<!-- Three.js Canvas Container -->
				<div id="canvas-container" class="w-full h-full cursor-grab active:cursor-grabbing relative z-10"></div>
			</div>
		</section>

		<!-- SECTION 2: CONTACT DETAILS & INQUIRY FORM -->
		<section class="border-t border-white/5 pt-16 pb-20 animate-stagger-item">
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-start">
				
				<!-- Left Column: Details (5 columns) -->
				<div class="lg:col-span-5 space-y-8 lg:pr-4">
					<div class="space-y-4">
						<div class="flex items-center gap-2">
							<span class="text-xs font-mono tracking-widest text-cyan-400/80 uppercase">Direct Communication</span>
						</div>
						<h2 class="font-syne font-semibold text-2xl sm:text-3xl text-white tracking-tight leading-none select-text">
							Get in touch directly
						</h2>
						<p class="text-neutral-400 text-sm leading-relaxed select-text font-light">
							Whether you have a specific project in mind, need technical staffing support, or just want to explore possibilities, we're here to help.
						</p>
					</div>

					<!-- Address details stack (Clean, neat & minimal cards) -->
					<div class="space-y-4 pt-6 border-t border-white/5">
						<!-- Office Card -->
						<div class="flex flex-col gap-4 p-5 rounded-2xl border border-white/5 bg-white/[0.01] hover:border-cyan-500/20 hover:bg-white/[0.02] transition-all duration-300 group/item">
							<div class="flex items-start gap-4">
								<div class="flex items-center justify-center w-10 h-10 rounded-xl bg-cyan-400/5 text-cyan-400 border border-cyan-400/10 group-hover/item:bg-cyan-400/10 group-hover/item:border-cyan-400/30 transition-all duration-300 shrink-0">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
										<path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
										<path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
									</svg>
								</div>
								<div class="space-y-1">
									<span class="text-xs font-mono tracking-widest text-neutral-500 uppercase block group-hover/item:text-cyan-400 transition-colors">Office Location</span>
									<p class="text-neutral-300 text-sm leading-relaxed select-text font-light">
										diceforce IT LLC.<br />
										567 Sunset Blvd, Suite 501<br />
										Los Angeles, CA 90026
									</p>
								</div>
							</div>

							<!-- Embedded Google Map -->
							<div class="w-full h-44 rounded-xl overflow-hidden border border-white/10 opacity-70 group-hover/item:opacity-100 transition-opacity duration-300">
								<iframe 
									src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3305.289139268307!2d-118.2673822!3d34.0748726!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x80c2c77d5b88a83f%3A0xea84126b86f6f962!2sSunset%20Blvd%2C%20Los%20Angeles%2C%20CA!5e0!3m2!1sen!2sus!4v1700000000000!5m2!1sen!2sus" 
									width="100%" 
									height="100%" 
									style="border:0; filter: grayscale(1) invert(0.92) contrast(1.15);" 
									allowfullscreen="" 
									loading="lazy" 
									referrerpolicy="no-referrer-when-downgrade"
								></iframe>
							</div>
						</div>

						<!-- Email Card -->
						<div class="flex items-start gap-4 p-5 rounded-2xl border border-white/5 bg-white/[0.01] hover:border-cyan-500/20 hover:bg-white/[0.02] transition-all duration-300 group/item">
							<div class="flex items-center justify-center w-10 h-10 rounded-xl bg-cyan-400/5 text-cyan-400 border border-cyan-400/10 group-hover/item:bg-cyan-400/10 group-hover/item:border-cyan-400/30 transition-all duration-300 shrink-0">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
								</svg>
							</div>
							<div class="space-y-1">
								<span class="text-xs font-mono tracking-widest text-neutral-500 uppercase block group-hover/item:text-cyan-400 transition-colors">Email Address</span>
								<a href="mailto:hello@diceforceit.com" class="text-neutral-300 hover:text-white transition-colors block select-text font-mono text-sm sm:text-base">
									hello@diceforceit.com
								</a>
							</div>
						</div>

						<!-- Phone Card -->
						<div class="flex items-start gap-4 p-5 rounded-2xl border border-white/5 bg-white/[0.01] hover:border-cyan-500/20 hover:bg-white/[0.02] transition-all duration-300 group/item">
							<div class="flex items-center justify-center w-10 h-10 rounded-xl bg-cyan-400/5 text-cyan-400 border border-cyan-400/10 group-hover/item:bg-cyan-400/10 group-hover/item:border-cyan-400/30 transition-all duration-300 shrink-0">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
								</svg>
							</div>
							<div class="space-y-1">
								<span class="text-xs font-mono tracking-widest text-neutral-500 uppercase block group-hover/item:text-cyan-400 transition-colors">Phone Number</span>
								<span class="text-neutral-300 font-mono text-sm sm:text-base block select-text">(310) 555-0165</span>
							</div>
						</div>
					</div>
				</div>

				<!-- Right Column: Inquiry Form (7 columns) -->
				<div class="lg:col-span-7">
					<!-- Glassmorphic Card Container -->
					<div class="relative bg-neutral-950/40 backdrop-blur-xl border border-white/10 rounded-3xl p-6 sm:p-10 shadow-[0_20px_50px_rgba(0,0,0,0.5)] overflow-hidden group/form">
						<!-- Top atmospheric gradient decoration (subtle and premium) -->
						<div class="absolute -top-40 -right-40 w-80 h-80 bg-cyan-500/10 rounded-full blur-[60px] pointer-events-none transition-all duration-700 group-hover/form:bg-cyan-500/15"></div>
						<div class="absolute -bottom-40 -left-40 w-80 h-80 bg-[#883ae2]/10 rounded-full blur-[60px] pointer-events-none transition-all duration-700 group-hover/form:bg-[#883ae2]/15"></div>

						<!-- Card Header -->
						<div class="space-y-3 mb-8 relative z-10">
							<div class="flex items-center gap-2">
								<span class="text-xs font-mono tracking-widest text-cyan-400/80 uppercase">Secure Channel</span>
							</div>
							<h2 class="font-syne font-semibold text-2xl sm:text-3xl text-white tracking-tight leading-none select-text">
								Send a message
							</h2>
							<p class="text-neutral-400 text-sm select-text font-light">
								Configure your inquiry and our team will get back to you shortly.
							</p>
						</div>

						<div class="relative min-h-[460px] z-10">
							<!-- Contact Form -->
							<form id="contact-form" class="space-y-6">
								<!-- 1. Inquiry Type (Dropdown selection) -->
								<div class="space-y-2">
									<label for="inquiry_type" class="block font-mono text-xs uppercase tracking-widest text-neutral-300">Inquiry Type</label>
									<div class="relative rounded-xl border border-white/10 bg-white/[0.02] hover:bg-white/[0.04] focus-within:border-cyan-500/50 focus-within:bg-white/[0.04] transition-all duration-300">
										<select 
											id="inquiry_type" 
											name="inquiry_type" 
											class="w-full bg-transparent text-sm sm:text-base text-white outline-none py-3 px-4 pr-10 appearance-none cursor-pointer border-none focus:ring-0"
										>
											<option value="ai_ml" class="bg-neutral-950 text-white">AI & ML Solutions (Custom models & systems)</option>
											<option value="staffing" class="bg-neutral-950 text-white">IT Staffing (Embed dedicated specialists)</option>
											<option value="general" class="bg-neutral-950 text-white">General Inquiry (Other questions & topics)</option>
										</select>
										<!-- Custom Chevron Icon -->
										<div class="absolute inset-y-0 right-4 flex items-center pointer-events-none text-neutral-400">
											<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
												<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
											</svg>
										</div>
									</div>
								</div>

								<!-- 2. Name & Company -->
								<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
									<!-- Name -->
									<div class="space-y-2">
										<label for="name" class="block font-mono text-xs uppercase tracking-widest text-neutral-300">Your name</label>
										<div class="relative rounded-xl border border-white/10 bg-white/[0.02] hover:bg-white/[0.04] focus-within:border-cyan-500/50 focus-within:bg-white/[0.04] transition-all duration-300 px-4 py-2 flex items-center">
											<input 
												(type="text")
												id="name" 
												name="name" 
												required 
												autocomplete="name"
												placeholder="e.g. Tobias Neumann…" 
												class="w-full bg-transparent text-sm sm:text-base text-white placeholder-neutral-500 outline-none py-1 border-none focus:ring-0"
											/>
										</div>
									</div>
									<!-- Company -->
									<div class="space-y-2">
										<label for="company" class="block font-mono text-xs uppercase tracking-widest text-neutral-300">Company</label>
										<div class="relative rounded-xl border border-white/10 bg-white/[0.02] hover:bg-white/[0.04] focus-within:border-cyan-500/50 focus-within:bg-white/[0.04] transition-all duration-300 px-4 py-2 flex items-center">
											<input 
												type="text" 
												id="company" 
												name="company" 
												required 
												autocomplete="organization"
												placeholder="e.g. diceforce IT…" 
												class="w-full bg-transparent text-sm sm:text-base text-white placeholder-neutral-500 outline-none py-1 border-none focus:ring-0"
											/>
										</div>
									</div>
								</div>

								<!-- 3. Email -->
								<div class="space-y-2">
									<label for="email" class="block font-mono text-xs uppercase tracking-widest text-neutral-300">Email</label>
									<div class="relative rounded-xl border border-white/10 bg-white/[0.02] hover:bg-white/[0.04] focus-within:border-cyan-500/50 focus-within:bg-white/[0.04] transition-all duration-300 px-4 py-2 flex items-center">
										<input 
											type="email" 
											id="email" 
											name="email" 
											required 
											autocomplete="email"
											spellcheck="false"
											placeholder="e.g. hello@diceforceit.com…" 
											class="w-full bg-transparent text-sm sm:text-base text-white placeholder-neutral-500 outline-none py-1 border-none focus:ring-0"
										/>
									</div>
								</div>

								<!-- 4. Interactive selection pills for Skills/Capabilities -->
								<div class="space-y-2 relative">
									<label class="block font-mono text-xs uppercase tracking-widest text-neutral-300">Select Areas of Interest</label>
									
									<!-- Dropdown Trigger Button -->
									<button 
										type="button" 
										id="interests-dropdown-trigger"
										class="w-full flex items-center justify-between bg-white/[0.02] border border-white/10 rounded-xl px-4 py-3 text-sm sm:text-base text-neutral-400 hover:bg-white/[0.04] transition-all duration-300 cursor-pointer outline-none focus:border-cyan-500/50"
									>
										<span id="interests-trigger-text" class="truncate select-none">Select areas of interest…</span>
										<!-- Custom Chevron Icon -->
										<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-neutral-400 transition-transform duration-300 pointer-events-none" id="interests-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
											<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
										</svg>
									</button>

									<!-- Dropdown Content Card (Floating) -->
									<div 
										id="interests-dropdown-content"
										class="hidden absolute z-30 left-0 right-0 mt-2 bg-neutral-950/98 backdrop-blur-xl border border-white/10 rounded-2xl p-5 shadow-2xl space-y-4 max-h-72 overflow-y-auto"
									>
										<!-- AI & ML Group -->
										<div id="pills-ai-ml" class="space-y-3 transition-opacity duration-300">
											<span class="block font-mono text-xs text-cyan-400/80 uppercase tracking-widest font-semibold">AI & ML Solutions</span>
											<div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
												<label class="relative flex items-center gap-3 px-4 py-2.5 border border-white/10 rounded-xl cursor-pointer bg-white/[0.02] hover:border-cyan-400/30 hover:bg-cyan-950/20 transition-all duration-300 select-none text-xs font-mono text-neutral-300">
													<input type="checkbox" name="services" value="llms_agents" class="w-3.5 h-3.5 rounded border-white/20 bg-transparent text-cyan-500 focus:ring-0 focus:ring-offset-0 cursor-pointer" />
													<span>LLMs & Agents</span>
												</label>
												<label class="relative flex items-center gap-3 px-4 py-2.5 border border-white/10 rounded-xl cursor-pointer bg-white/[0.02] hover:border-cyan-400/30 hover:bg-cyan-950/20 transition-all duration-300 select-none text-xs font-mono text-neutral-300">
													<input type="checkbox" name="services" value="fine_tuning" class="w-3.5 h-3.5 rounded border-white/20 bg-transparent text-cyan-500 focus:ring-0 focus:ring-offset-0 cursor-pointer" />
													<span>Fine-Tuning</span>
												</label>
												<label class="relative flex items-center gap-3 px-4 py-2.5 border border-white/10 rounded-xl cursor-pointer bg-white/[0.02] hover:border-cyan-400/30 hover:bg-cyan-950/20 transition-all duration-300 select-none text-xs font-mono text-neutral-300">
													<input type="checkbox" name="services" value="vector_db" class="w-3.5 h-3.5 rounded border-white/20 bg-transparent text-cyan-500 focus:ring-0 focus:ring-offset-0 cursor-pointer" />
													<span>Vector DBs</span>
												</label>
											</div>
										</div>

										<!-- Staffing Group -->
										<div id="pills-staffing" class="space-y-3 transition-opacity duration-300">
											<span class="block font-mono text-xs text-cyan-400/80 uppercase tracking-widest font-semibold">IT Staffing Roles</span>
											<div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
												<label class="relative flex items-center gap-3 px-4 py-2.5 border border-white/10 rounded-xl cursor-pointer bg-white/[0.02] hover:border-cyan-400/30 hover:bg-cyan-950/20 transition-all duration-300 select-none text-xs font-mono text-neutral-300">
													<input type="checkbox" name="services" value="ai_researchers" class="w-3.5 h-3.5 rounded border-white/20 bg-transparent text-cyan-500 focus:ring-0 focus:ring-offset-0 cursor-pointer" />
													<span>AI Researchers</span>
												</label>
												<label class="relative flex items-center gap-3 px-4 py-2.5 border border-white/10 rounded-xl cursor-pointer bg-white/[0.02] hover:border-cyan-400/30 hover:bg-cyan-950/20 transition-all duration-300 select-none text-xs font-mono text-neutral-300">
													<input type="checkbox" name="services" value="mlops" class="w-3.5 h-3.5 rounded border-white/20 bg-transparent text-cyan-500 focus:ring-0 focus:ring-offset-0 cursor-pointer" />
													<span>MLOps Engineers</span>
												</label>
												<label class="relative flex items-center gap-3 px-4 py-2.5 border border-white/10 rounded-xl cursor-pointer bg-white/[0.02] hover:border-cyan-400/30 hover:bg-cyan-950/20 transition-all duration-300 select-none text-xs font-mono text-neutral-300">
													<input type="checkbox" name="services" value="backend" class="w-3.5 h-3.5 rounded border-white/20 bg-transparent text-cyan-500 focus:ring-0 focus:ring-offset-0 cursor-pointer" />
													<span>Backend Pioneers</span>
												</label>
											</div>
										</div>
									</div>
								</div>

								<!-- 5. Message -->
								<div class="space-y-2">
									<label for="message" class="block font-mono text-xs uppercase tracking-widest text-neutral-300">Your message</label>
									<div class="relative rounded-xl border border-white/10 bg-white/[0.02] hover:bg-white/[0.04] focus-within:border-cyan-500/50 focus-within:bg-white/[0.04] transition-all duration-300 px-4 py-3">
										<textarea 
											id="message" 
											name="message" 
											required 
											rows="4" 
											placeholder="e.g. We need dedicated MLOps support for a custom LLM pipeline…" 
											class="w-full bg-transparent text-sm sm:text-base text-white placeholder-neutral-500 outline-none py-1 border-none focus:ring-0 resize-none"
										></textarea>
									</div>
								</div>

								<div class="pt-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
									<div class="w-full sm:w-auto z-10">
										<div class="relative group transition-transform duration-500 hover:scale-[1.015] w-full sm:w-auto">
											<!-- Outer atmospheric soft glow using logo colors -->
											<div class="absolute -inset-1 bg-gradient-to-r from-[#0377ff] via-[#00deff] to-[#883ae2] rounded-full blur-md opacity-25 group-hover:opacity-60 transition-all duration-500 ease-out"></div>
											
											<!-- Rounded container that clips the rotating border gradient -->
											<div class="relative rounded-full p-[1px] overflow-hidden flex items-center justify-center bg-black shadow-[0_4px_12px_rgba(0,0,0,0.5)] group-hover:shadow-[0_0_20px_rgba(3,119,255,0.4)] transition-all duration-500 w-full sm:w-auto">
												<!-- Rotating gradient element with logo colors -->
												<div class="absolute inset-[-200%] bg-[conic-gradient(from_0deg,#0377ff,#00deff,#883ae2,#00deff,#0377ff)] animate-border-spin"></div>
												
												<!-- Main Button -->
												<button 
													type="submit" 
													class="relative w-full sm:w-auto px-10 py-4 bg-black hover:bg-neutral-900 text-white font-mono text-xs font-bold uppercase tracking-widest rounded-full transition-all duration-300 inline-flex items-center justify-center gap-2.5 cursor-pointer z-10 select-none group-hover:text-[#00deff] border-none focus:outline-none"
												>
													Submit Inquiry
												</button>
											</div>
										</div>
									</div>
									<p class="text-xs font-mono text-neutral-500 tracking-wider">
										By submitting, you agree to our <a href="/terms" class="text-neutral-400 hover:text-white underline transition-colors">Terms of Service</a>.
									</p>
								</div>
							</form>

							<!-- Success state (Hidden initially) -->
							<div id="success-screen" class="hidden absolute inset-0 bg-neutral-950/95 backdrop-blur-xl flex flex-col items-center justify-center text-center space-y-6 p-6 rounded-3xl z-20 border border-white/10">
								<div class="relative w-16 h-16 mb-2">
									<div class="absolute inset-0 rounded-full border border-white/10 bg-white/5 animate-pulse-slow"></div>
									<div class="absolute inset-2 rounded-full border border-white/20 flex items-center justify-center">
										<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
											<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
										</svg>
									</div>
								</div>
								<div class="space-y-4 px-6 max-w-md">
									<h3 class="text-xl font-syne font-bold tracking-tight text-white uppercase select-text">Transmission Complete</h3>
									
									<!-- Simulated Console -->
									<div class="bg-black/90 border border-white/10 rounded-lg p-4 font-mono text-xs text-left text-neutral-400 space-y-1.5 overflow-hidden h-28 max-w-sm mx-auto shadow-inner">
										<div class="terminal-line opacity-0">> CALIBRATING NEURAL ROUTING… [OK]</div>
										<div class="terminal-line opacity-0">> UPLOADING SECURE STREAM… [OK]</div>
										<div class="terminal-line opacity-0">> PACKET INTEGRITY MATCH: 100%</div>
										<div class="terminal-line opacity-0">> HANDSHAKE WITH CORE ENGINE… [ESTABLISHED]</div>
									</div>
									
									<p class="text-xs font-mono text-neutral-400 leading-relaxed select-text mt-2">
										Your transmission has been successfully routed. Expected response latency: <span class="text-white font-bold">24 hours</span>.
									</p>
								</div>
								<button 
									id="reset-form-btn" 
									class="text-xs font-mono tracking-widest text-neutral-400 hover:text-white uppercase transition-colors pointer-events-auto cursor-pointer"
								>
									Send Another Transmission
								</button>
							</div>
						</div>
					</div>
				</div>

			</div>
		</section>

	</div>

	<!-- Hydration Script -->
	<script>
		import * as THREE from 'three';
		import { gsap } from 'gsap';

		// Elements
		const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
		const successScreen = document.getElementById('success-screen');
		const resetFormBtn = document.getElementById('reset-form-btn');
		const inquirySelect = document.getElementById('inquiry_type') as HTMLSelectElement | null;
		const pillsAiMl = document.getElementById('pills-ai-ml');
		const pillsStaffing = document.getElementById('pills-staffing');
		const dropdownTrigger = document.getElementById('interests-dropdown-trigger');
		const dropdownContent = document.getElementById('interests-dropdown-content');
		const dropdownChevron = document.getElementById('interests-chevron');
		const triggerText = document.getElementById('interests-trigger-text');
		const checkboxes = document.querySelectorAll('#interests-dropdown-content input[type="checkbox"]') as NodeListOf<HTMLInputElement>;
		const canvasContainer = document.getElementById('canvas-container');
		const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		// 1. Interactive Form Inquiry Filter
		const updateInquiryGroups = () => {
			if (!inquirySelect) return;
			
			const type = inquirySelect.value;
			if (type === 'ai_ml') {
				gsap.to(pillsAiMl, { opacity: 1, duration: 0.4 });
				gsap.to(pillsStaffing, { opacity: 0.25, duration: 0.4 });
			} else if (type === 'staffing') {
				gsap.to(pillsAiMl, { opacity: 0.25, duration: 0.4 });
				gsap.to(pillsStaffing, { opacity: 1, duration: 0.4 });
			} else {
				gsap.to([pillsAiMl, pillsStaffing], { opacity: 0.6, duration: 0.4 });
			}
		};
		
		if (inquirySelect) {
			inquirySelect.addEventListener('change', updateInquiryGroups);
		}
		updateInquiryGroups();

		// Custom Multi-select Dropdown for Areas of Interest
		if (dropdownTrigger && dropdownContent && dropdownChevron) {
			dropdownTrigger.addEventListener('click', (e) => {
				e.stopPropagation();
				const isHidden = dropdownContent.classList.contains('hidden');
				if (isHidden) {
					dropdownContent.classList.remove('hidden');
					dropdownChevron.style.transform = 'rotate(180deg)';
				} else {
					dropdownContent.classList.add('hidden');
					dropdownChevron.style.transform = 'rotate(0deg)';
				}
			});
			
			// Close when clicking outside
			document.addEventListener('click', (e) => {
				const target = e.target as HTMLElement;
				if (dropdownContent && dropdownTrigger && !dropdownContent.contains(target) && !dropdownTrigger.contains(target)) {
					dropdownContent.classList.add('hidden');
					dropdownChevron.style.transform = 'rotate(0deg)';
				}
			});
		}

		// Update trigger text based on selected options
		const updateTriggerText = () => {
			if (!triggerText || !checkboxes) return;
			const selected: string[] = [];
			checkboxes.forEach((cb) => {
				if (cb.checked) {
					// Get the label text
					const labelSpan = cb.nextElementSibling as HTMLSpanElement | null;
					if (labelSpan) {
						selected.push(labelSpan.innerText.trim());
					}
				}
			});

			if (selected.length === 0) {
				triggerText.innerText = 'Select areas of interest…';
				triggerText.classList.remove('text-cyan-400');
				triggerText.classList.add('text-neutral-400');
			} else {
				triggerText.innerText = selected.join(', ');
				triggerText.classList.remove('text-neutral-400');
				triggerText.classList.add('text-cyan-400');
			}
		};

		checkboxes.forEach((cb) => {
			cb.addEventListener('change', updateTriggerText);
		});
		updateTriggerText();

		// 2. Form Submission Animation (Simulated Terminal Output)
		if (contactForm && successScreen && resetFormBtn) {
			contactForm.addEventListener('submit', (e) => {
				e.preventDefault();
				
				const submitBtn = contactForm.querySelector('button[type="submit"]') as HTMLButtonElement | null;
				if (submitBtn) {
					submitBtn.disabled = true;
					submitBtn.innerText = 'Routing Transmission…';
				}

				// Animate form fields fade-out
				gsap.to(contactForm, {
					opacity: 0,
					y: -10,
					duration: 0.4,
					onComplete: () => {
						contactForm.classList.add('hidden');
						successScreen.classList.remove('hidden');
						successScreen.style.opacity = '0';
						successScreen.style.transform = 'translateY(10px)';
						
						gsap.to(successScreen, {
							opacity: 1,
							y: 0,
							duration: 0.5,
							ease: 'power2.out',
							onComplete: () => {
								// Trigger Staggered Terminal Console Lines
								const lines = successScreen.querySelectorAll('.terminal-line');
								gsap.to(lines, {
									opacity: 1,
									stagger: 0.4,
									duration: 0.2,
									ease: 'none'
								});
							}
						});
					}
				});
			});

			// Reset Form
			resetFormBtn.addEventListener('click', () => {
				gsap.to(successScreen, {
					opacity: 0,
					y: 10,
					duration: 0.4,
					onComplete: () => {
						successScreen.classList.add('hidden');
						
						// Reset terminal lines
						const lines = successScreen.querySelectorAll('.terminal-line');
						lines.forEach(l => (l as HTMLElement).style.opacity = '0');
						
						contactForm.reset();
						updateInquiryGroups();
						updateTriggerText();
						contactForm.classList.remove('hidden');
						contactForm.style.opacity = '0';
						contactForm.style.transform = 'translateY(-10px)';
						
						const submitBtn = contactForm.querySelector('button[type="submit"]') as HTMLButtonElement | null;
						if (submitBtn) {
							submitBtn.disabled = false;
							submitBtn.innerText = 'Submit Inquiry';
						}

						gsap.to(contactForm, {
							opacity: 1,
							y: 0,
							duration: 0.5,
							ease: 'power2.out'
						});
					}
				});
			});
		}

		// 3. Three.js Interactive Particle SVG Image System
		let scene: THREE.Scene, 
			camera: THREE.PerspectiveCamera, 
			renderer: THREE.WebGLRenderer,
			geometry: THREE.BufferGeometry,
			points: THREE.Points,
			currentScale = 1.0;
		
		function initThree() {
			if (!canvasContainer) return;
			
			// Load SVG image as textures/particles
			const img = new Image();
			img.crossOrigin = "anonymous";
			img.src = '/contact-hero.svg';
			
			img.onload = () => {
				const sampleCanvas = document.createElement('canvas');
				const sWidth = 180;
				const sHeight = Math.round(180 * (738.36 / 767.7));
				
				sampleCanvas.width = sWidth;
				sampleCanvas.height = sHeight;
				const sCtx = sampleCanvas.getContext('2d');
				if (!sCtx) return;
				
				sCtx.drawImage(img, 0, 0, sWidth, sHeight);
				const imgData = sCtx.getImageData(0, 0, sWidth, sHeight);
				const data = imgData.data;
				
				const rawParticles = [];
				
				for (let y = 0; y < sHeight; y++) {
					for (let x = 0; x < sWidth; x++) {
						const idx = (y * sWidth + x) * 4;
						const r = data[idx];
						const g = data[idx + 1];
						const b = data[idx + 2];
						const a = data[idx + 3];
						
						if (a > 60) {
							const px = ((x / sWidth) - 0.5) * 5.0;
							const py = -((y / sHeight) - 0.5) * 5.0 * (sHeight / sWidth);
							const pz = (Math.random() - 0.5) * 0.12;
							
							rawParticles.push({
								x: px,
								y: py,
								z: pz,
								r: r / 255,
								g: g / 255,
								b: b / 255
							});
						}
					}
				}
				
				const maxParticles = 3000;
				let particlesList = [];
				if (rawParticles.length > maxParticles) {
					const rawCount = rawParticles.length;
					for (let i = 0; i < maxParticles; i++) {
						const index = Math.floor((i / (maxParticles - 1)) * (rawCount - 1));
						particlesList.push(rawParticles[index]);
					}
				} else {
					particlesList = rawParticles;
				}
				
				setupParticleSystem(particlesList);
			};
		}

		function setupParticleSystem(particlesList: any[]) {
			if (!canvasContainer) return;
			const width = canvasContainer.clientWidth;
			const height = canvasContainer.clientHeight || 400;
			
			scene = new THREE.Scene();
			
			camera = new THREE.PerspectiveCamera(60, width / height, 0.1, 100);
			camera.position.z = 5.2;
			
			renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
			renderer.setSize(width, height);
			renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
			renderer.domElement.style.display = 'block';
			canvasContainer.appendChild(renderer.domElement);
			
			const count = particlesList.length;
			const positions = new Float32Array(count * 3);
			const colors = new Float32Array(count * 3);
			const originalPositions = new Float32Array(count * 3);
			const velocities = new Float32Array(count * 3);
			
			for (let i = 0; i < count; i++) {
				const p = particlesList[i];
				const i3 = i * 3;
				
				originalPositions[i3] = p.x;
				originalPositions[i3 + 1] = p.y;
				originalPositions[i3 + 2] = p.z;
				
				positions[i3] = p.x + (Math.random() - 0.5) * 12;
				positions[i3 + 1] = p.y + (Math.random() - 0.5) * 12;
				positions[i3 + 2] = p.z + (Math.random() - 0.5) * 12;
				
				colors[i3] = p.r;
				colors[i3 + 1] = p.g;
				colors[i3 + 2] = p.b;
				
				velocities[i3] = 0;
				velocities[i3 + 1] = 0;
				velocities[i3 + 2] = 0;
			}
			
			geometry = new THREE.BufferGeometry();
			geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
			geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));
			
			const canvas = document.createElement('canvas');
			canvas.width = 32;
			canvas.height = 32;
			const ctx = canvas.getContext('2d');
			if (ctx) {
				const gradient = ctx.createRadialGradient(16, 16, 0, 16, 16, 16);
				gradient.addColorStop(0, 'rgba(255, 255, 255, 1)');
				gradient.addColorStop(0.25, 'rgba(255, 255, 255, 0.7)');
				gradient.addColorStop(0.6, 'rgba(255, 255, 255, 0.15)');
				gradient.addColorStop(1, 'rgba(255, 255, 255, 0)');
				ctx.fillStyle = gradient;
				ctx.fillRect(0, 0, 32, 32);
			}
			const texture = new THREE.CanvasTexture(canvas);
			
			const material = new THREE.PointsMaterial({
				size: 0.085,
				map: texture,
				transparent: true,
				opacity: 0.9,
				blending: THREE.AdditiveBlending,
				depthWrite: false,
				vertexColors: true
			});
			
			points = new THREE.Points(geometry, material);
			scene.add(points);
			
			function adjustScale() {
				if (!points || !canvasContainer) return;
				const w = canvasContainer.clientWidth;
				const h = canvasContainer.clientHeight || 400;
				const aspect = w / h;
				
				if (aspect < 1.0) {
					currentScale = aspect * 0.9;
				} else {
					currentScale = 1.0;
				}
				points.scale.set(currentScale, currentScale, currentScale);
			}
			
			adjustScale();
			
			const mouse = new THREE.Vector2(-9999, -9999);
			const mouse3D = new THREE.Vector3(-9999, -9999, 0);
			const plane = new THREE.Plane(new THREE.Vector3(0, 0, 1), 0);
			const raycaster = new THREE.Raycaster();
			
			function updateMousePosition(clientX: number, clientY: number) {
				if (!canvasContainer) return;
				const rect = canvasContainer.getBoundingClientRect();
				const x = ((clientX - rect.left) / rect.width) * 2 - 1;
				const y = -((clientY - rect.top) / rect.height) * 2 + 1;
				mouse.set(x, y);
				
				raycaster.setFromCamera(mouse, camera);
				raycaster.ray.intersectPlane(plane, mouse3D);
			}
			
			function handleMove(e: MouseEvent) {
				updateMousePosition(e.clientX, e.clientY);
			}
			
			function handleLeave() {
				mouse.set(-9999, -9999);
				mouse3D.set(-9999, -9999, 0);
			}
			
			function handleTouch(e: TouchEvent) {
				if (e.touches.length > 0) {
					updateMousePosition(e.touches[0].clientX, e.touches[0].clientY);
				}
			}
			
			canvasContainer.addEventListener('mousemove', handleMove);
			canvasContainer.addEventListener('mouseleave', handleLeave);
			canvasContainer.addEventListener('touchmove', handleTouch);
			canvasContainer.addEventListener('touchend', handleLeave);
			
			const clock = new THREE.Clock();
			
			function animate() {
				requestAnimationFrame(animate);
				
				const delta = Math.min(clock.getDelta(), 0.1);
				const positionsAttr = geometry.attributes.position;
				const posArray = positionsAttr.array as Float32Array;
				
				const mouseRadius = 0.9;
				const mousePush = 3.6;
				const springForce = 5.2;
				const damping = 0.84;
				
				for (let i = 0; i < count; i++) {
					const idx = i * 3;
					
					let x = posArray[idx];
					let y = posArray[idx + 1];
					let z = posArray[idx + 2];
					
					const ox = originalPositions[idx];
					const oy = originalPositions[idx + 1];
					const oz = originalPositions[idx + 2];
					
					let vx = velocities[idx];
					let vy = velocities[idx + 1];
					let vz = velocities[idx + 2];
					
					if (mouse.x > -1000 && !prefersReduced) {
						const localMouseX = mouse3D.x / currentScale;
						const localMouseY = mouse3D.y / currentScale;
						const localMouseZ = mouse3D.z / currentScale;
						
						const dx = x - localMouseX;
						const dy = y - localMouseY;
						const dz = z - localMouseZ;
						const dist = Math.sqrt(dx*dx + dy*dy + dz*dz);
						
						if (dist < mouseRadius) {
							const pushStrength = (1.0 - dist / mouseRadius) * mousePush;
							const angleX = dist > 0 ? dx / dist : (Math.random() - 0.5);
							const angleY = dist > 0 ? dy / dist : (Math.random() - 0.5);
							const angleZ = dist > 0 ? dz / dist : (Math.random() - 0.5);
							
							vx += angleX * pushStrength * delta;
							vy += angleY * pushStrength * delta;
							vz += angleZ * pushStrength * delta;
						}
					}
					
					const sx = (ox - x) * springForce;
					const sy = (oy - y) * springForce;
					const sz = (oz - z) * springForce;
					
					vx += sx * delta;
					vy += sy * delta;
					vz += sz * delta;
					
					vx *= damping;
					vy *= damping;
					vz *= damping;
					
					x += vx;
					y += vy;
					z += vz;
					
					posArray[idx] = x;
					posArray[idx + 1] = y;
					posArray[idx + 2] = z;
					
					velocities[idx] = vx;
					velocities[idx + 1] = vy;
					velocities[idx + 2] = vz;
				}
				
				positionsAttr.needsUpdate = true;
				renderer.render(scene, camera);
			}
			
			animate();
			
			window.addEventListener('resize', () => {
				if (!canvasContainer || !renderer || !camera) return;
				const w = canvasContainer.clientWidth;
				const h = canvasContainer.clientHeight || 400;
				
				camera.aspect = w / h;
				camera.updateProjectionMatrix();
				renderer.setSize(w, h);
				
				adjustScale();
			});
		}

		initThree();
	</script>
</PageLayout>
