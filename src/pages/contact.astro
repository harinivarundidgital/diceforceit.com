---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout 
	title="Diceforce IT | Contact | Let's Talk" 
	description="Ready to fix your engineering bottlenecks? Contact Diceforce IT for AI ML solutions, custom software, digital transformation, IT consulting, and dedicated engineering staffing."
	activePage="contact"
>
	<div class="max-w-6xl mx-auto w-full flex flex-col gap-12">
		
		<!-- SECTION 1: HERO (2-Column Layout) -->
		<section class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center animate-stagger-item">
			<!-- Left Column: Hero Copy -->
			<div class="lg:col-span-7 space-y-6">
				<h1 class="font-syne font-black text-4xl sm:text-5xl md:text-6xl lg:text-7xl tracking-tighter leading-[0.95] text-white select-text text-balance">
					Ready To Fix Your<br class="hidden sm:inline" />
					Engineering Bottlenecks.
				</h1>
				<p class="text-neutral-400 font-light text-base sm:text-lg max-w-xl mt-6 leading-relaxed select-text">
					Tell us where it hurts, and we are ready to plug the gaps by helping you with high-pressure launch, drowning in technical debt, or finding developers who can actually pass a code review.
				</p>
			</div>
			<!-- Right Column: Interactive Particles (Loaded from SVG) -->
			<div class="lg:col-span-5 relative w-full h-[400px] sm:h-[480px] lg:h-[550px] flex items-center justify-center overflow-hidden">
				<div class="absolute inset-0 bg-[#00deff]/[0.02] blur-[80px] rounded-full pointer-events-none"></div>
				<!-- Three.js Canvas Container -->
				<div id="canvas-container" class="w-full h-full cursor-grab active:cursor-grabbing relative z-10"></div>
			</div>
		</section>

		<!-- SECTION 2: CONTACT DETAILS & INQUIRY FORM -->
		<section class="pt-16 pb-20 animate-stagger-item">
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-start">
				
				<!-- Left Column: Details (5 columns) -->
				<div class="lg:col-span-5 space-y-8 lg:pr-4">
					<div class="space-y-4">
						<div class="flex items-center gap-2">
							<span class="text-xs font-mono tracking-widest text-cyan-400/80 uppercase">Take Your Next Step</span>
						</div>
						<h2 class="font-syne font-semibold text-2xl sm:text-3xl text-white tracking-tight leading-none select-text">
							Visit Us Directly
						</h2>
						<p class="text-neutral-400 text-sm leading-relaxed select-text font-light">
							Don’t want to waste any more time taking the next step to growth? Let's talk directly at our office space, and to your utmost comfort.
						</p>
					</div>

					<!-- Address details stack (Clean, neat & minimal cards) -->
					<div class="space-y-4 pt-6">
						<!-- Office Card -->
						<div class="flex flex-col gap-4 p-5 rounded-2xl border border-white/5 bg-white/[0.01] hover:border-cyan-500/20 hover:bg-white/[0.02] transition-all duration-300 group/item">
							<div class="flex items-start gap-4">
								<div class="flex items-center justify-center w-10 h-10 rounded-xl bg-cyan-400/5 text-cyan-400 border border-cyan-400/10 group-hover/item:bg-cyan-400/10 group-hover/item:border-cyan-400/30 transition-all duration-300 shrink-0">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
										<path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
										<path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
									</svg>
								</div>
								<div class="space-y-1">
									<span class="text-xs font-mono tracking-widest text-neutral-500 uppercase block group-hover/item:text-cyan-400 transition-colors">Address</span>
									<p class="text-neutral-300 text-sm leading-relaxed select-text font-light">
										Diceforce IT LLC.<br />
										567 Sunset Blvd, Suite 501<br />
										Los Angeles, CA 90026
									</p>
								</div>
							</div>

							<!-- Embedded Google Map -->
							<div class="w-full h-44 rounded-xl overflow-hidden border border-white/10 opacity-70 group-hover/item:opacity-100 transition-opacity duration-300">
								<iframe 
									src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3305.289139268307!2d-118.2673822!3d34.0748726!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x80c2c77d5b88a83f%3A0xea84126b86f6f962!2sSunset%20Blvd%2C%20Los%20Angeles%2C%20CA!5e0!3m2!1sen!2sus!4v1700000000000!5m2!1sen!2sus" 
									width="100%" 
									height="100%" 
									style="border:0; filter: grayscale(1) invert(0.92) contrast(1.15);" 
									allowfullscreen="" 
									loading="lazy" 
									referrerpolicy="no-referrer-when-downgrade"
								></iframe>
							</div>
						</div>

						<!-- Email Card -->
						<div class="flex items-start gap-4 p-5 rounded-2xl border border-white/5 bg-white/[0.01] hover:border-cyan-500/20 hover:bg-white/[0.02] transition-all duration-300 group/item">
							<div class="flex items-center justify-center w-10 h-10 rounded-xl bg-cyan-400/5 text-cyan-400 border border-cyan-400/10 group-hover/item:bg-cyan-400/10 group-hover/item:border-cyan-400/30 transition-all duration-300 shrink-0">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
								</svg>
							</div>
							<div class="space-y-1">
								<span class="text-xs font-mono tracking-widest text-neutral-500 uppercase block group-hover/item:text-cyan-400 transition-colors">Email</span>
								<a href="mailto:hello@diceforceit.com" class="text-neutral-300 hover:text-white transition-colors block select-text font-mono text-sm sm:text-base">
									hello@diceforceit.com
								</a>
							</div>
						</div>

						<!-- Phone Card -->
						<div class="flex items-start gap-4 p-5 rounded-2xl border border-white/5 bg-white/[0.01] hover:border-cyan-500/20 hover:bg-white/[0.02] transition-all duration-300 group/item">
							<div class="flex items-center justify-center w-10 h-10 rounded-xl bg-cyan-400/5 text-cyan-400 border border-cyan-400/10 group-hover/item:bg-cyan-400/10 group-hover/item:border-cyan-400/30 transition-all duration-300 shrink-0">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
								</svg>
							</div>
							<div class="space-y-1">
								<span class="text-xs font-mono tracking-widest text-neutral-500 uppercase block group-hover/item:text-cyan-400 transition-colors">Phone</span>
								<a href="tel:+19727102714" class="text-neutral-300 hover:text-white transition-colors block select-text font-mono text-sm sm:text-base">
									+1 (972) 710-2714
								</a>
							</div>
						</div>

						<!-- WhatsApp Direct Chat Card -->
						<div class="flex items-center justify-between p-5 rounded-2xl border border-emerald-500/20 bg-emerald-950/[0.1] hover:border-emerald-500/40 hover:bg-emerald-950/[0.2] transition-all duration-300 group/wa">
							<div class="flex items-center gap-4">
								<div class="flex items-center justify-center w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 group-hover/wa:scale-105 transition-all duration-300 shrink-0">
									<svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
										<path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
									</svg>
								</div>
								<div class="space-y-0.5">
									<span class="text-xs font-mono tracking-widest text-emerald-400 uppercase block font-semibold">WhatsApp Direct</span>
									<span class="text-neutral-300 font-mono text-xs block">+1 (972) 710-2714</span>
								</div>
							</div>
							<a 
								href="https://wa.me/19727102714?text=Hello%20Diceforce%20IT%20Team%2C%20I'd%20like%20to%20get%20in%20touch." 
								target="_blank" 
								rel="noopener noreferrer"
								class="px-3.5 py-1.5 rounded-lg bg-emerald-500 text-black font-mono text-xs font-bold uppercase hover:bg-emerald-400 transition-colors shadow-[0_0_12px_rgba(37,211,102,0.3)] shrink-0"
							>
								Chat Now
							</a>
						</div>
					</div>
				</div>

				<!-- Right Column: Inquiry Form (7 columns) -->
				<div class="lg:col-span-7">
					<!-- Glassmorphic Card Container -->
					<div class="relative bg-gradient-to-b from-[#0c0d15]/80 via-[#07080f]/90 to-[#040408]/95 backdrop-blur-2xl border border-white/10 rounded-[2rem] p-8 sm:p-12 shadow-[0_25px_60px_rgba(0,0,0,0.6)] overflow-hidden group/form">
						<!-- Top atmospheric gradient decoration (subtle and premium) -->
						<div class="absolute -top-40 -right-40 w-96 h-96 bg-cyan-500/10 rounded-full blur-[80px] pointer-events-none transition-all duration-700 group-hover/form:bg-cyan-500/20"></div>
						<div class="absolute -bottom-40 -left-40 w-96 h-96 bg-[#883ae2]/10 rounded-full blur-[80px] pointer-events-none transition-all duration-700 group-hover/form:bg-[#883ae2]/20"></div>

						<!-- Card Header -->
						<div class="space-y-3 mb-8 relative z-10">
							<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-400/10 border border-cyan-400/20">
								<span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
								<span class="text-[11px] font-mono tracking-widest text-cyan-400 uppercase font-semibold">Let us help you</span>
							</div>
							<h2 class="font-syne font-bold text-3xl sm:text-4xl text-white tracking-tight leading-none select-text">
								Write to us
							</h2>
							<p class="text-neutral-400 text-sm select-text font-light leading-relaxed">
								Send us your concern and let us get in touch with you.
							</p>
						</div>

						<div class="relative min-h-[460px] z-10">
							<!-- Contact Form -->
							<form id="contact-form" class="space-y-6">
								<!-- 1. Name & Phone -->
								<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
									<!-- Name -->
									<div class="space-y-2">
										<label for="name" class="font-mono text-[11px] uppercase tracking-widest text-neutral-300 font-medium flex items-center gap-1.5">
											Name
										</label>
										<div class="relative rounded-2xl border border-white/10 bg-white/[0.025] hover:bg-white/[0.04] focus-within:border-cyan-400 focus-within:ring-2 focus-within:ring-cyan-400/20 focus-within:bg-black/40 transition-all duration-300 px-4 py-2.5 flex items-center gap-3 group/input">
											<svg class="w-4 h-4 text-neutral-500 group-focus-within/input:text-cyan-400 transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
												<path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
											</svg>
											<input 
												type="text" 
												id="name" 
												name="name" 
												required 
												autocomplete="name"
												placeholder="Your full name…" 
												class="w-full bg-transparent text-sm sm:text-base text-white placeholder-neutral-500 outline-none py-1 border-none focus:ring-0"
											/>
										</div>
									</div>
									<!-- Phone -->
									<div class="space-y-2">
										<label for="phone" class="font-mono text-[11px] uppercase tracking-widest text-neutral-300 font-medium flex items-center gap-1.5">
											Phone
										</label>
										<div class="relative rounded-2xl border border-white/10 bg-white/[0.025] hover:bg-white/[0.04] focus-within:border-cyan-400 focus-within:ring-2 focus-within:ring-cyan-400/20 focus-within:bg-black/40 transition-all duration-300 px-4 py-2.5 flex items-center gap-3 group/input">
											<svg class="w-4 h-4 text-neutral-500 group-focus-within/input:text-cyan-400 transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
												<path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
											</svg>
											<input 
												type="tel" 
												id="phone" 
												name="phone" 
												required 
												autocomplete="tel"
												placeholder="Phone number…" 
												class="w-full bg-transparent text-sm sm:text-base text-white placeholder-neutral-500 outline-none py-1 border-none focus:ring-0"
											/>
										</div>
									</div>
								</div>

								<!-- 2. Email & Company -->
								<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
									<!-- Email -->
									<div class="space-y-2">
										<label for="email" class="font-mono text-[11px] uppercase tracking-widest text-neutral-300 font-medium flex items-center gap-1.5">
											Email
										</label>
										<div class="relative rounded-2xl border border-white/10 bg-white/[0.025] hover:bg-white/[0.04] focus-within:border-cyan-400 focus-within:ring-2 focus-within:ring-cyan-400/20 focus-within:bg-black/40 transition-all duration-300 px-4 py-2.5 flex items-center gap-3 group/input">
											<svg class="w-4 h-4 text-neutral-500 group-focus-within/input:text-cyan-400 transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
												<path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
											</svg>
											<input 
												type="email" 
												id="email" 
												name="email" 
												required 
												autocomplete="email"
												spellcheck="false"
												placeholder="e.g. hello@diceforceit.com…" 
												class="w-full bg-transparent text-sm sm:text-base text-white placeholder-neutral-500 outline-none py-1 border-none focus:ring-0"
											/>
										</div>
									</div>
									<!-- Company -->
									<div class="space-y-2">
										<label for="company" class="font-mono text-[11px] uppercase tracking-widest text-neutral-300 font-medium flex items-center gap-1.5">
											Company
										</label>
										<div class="relative rounded-2xl border border-white/10 bg-white/[0.025] hover:bg-white/[0.04] focus-within:border-cyan-400 focus-within:ring-2 focus-within:ring-cyan-400/20 focus-within:bg-black/40 transition-all duration-300 px-4 py-2.5 flex items-center gap-3 group/input">
											<svg class="w-4 h-4 text-neutral-500 group-focus-within/input:text-cyan-400 transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
												<path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m0 0h4m-4 0V11m0 10V11m0 0h4M9 7h1m-1 4h1m4-4h1m-1 4h1" />
											</svg>
											<input 
												type="text" 
												id="company" 
												name="company" 
												required 
												autocomplete="organization"
												placeholder="Your company name…" 
												class="w-full bg-transparent text-sm sm:text-base text-white placeholder-neutral-500 outline-none py-1 border-none focus:ring-0"
											/>
										</div>
									</div>
								</div>

								<!-- 3. Enquiry type (Custom Dropdown selection) -->
								<div class="space-y-2 relative">
									<label class="font-mono text-[11px] uppercase tracking-widest text-neutral-300 font-medium flex items-center gap-1.5">
										Enquiry type
									</label>
									<input type="hidden" name="enquiry_type" id="enquiry_type" value="ai_ml" />
									<button 
										type="button" 
										id="enquiry-dropdown-trigger"
										class="w-full flex items-center justify-between bg-white/[0.025] border border-white/10 hover:border-cyan-400/40 rounded-2xl px-4 py-3.5 text-sm sm:text-base text-white hover:bg-white/[0.04] transition-all duration-300 cursor-pointer outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/20 group/input"
									>
										<div class="flex items-center gap-3 truncate">
											<svg class="w-4 h-4 text-cyan-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
												<path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
											</svg>
											<span id="enquiry-trigger-text" class="truncate font-medium">AI ML Solutions (Custom Models & Intelligent Systems)</span>
										</div>
										<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-neutral-400 transition-transform duration-300 pointer-events-none shrink-0" id="enquiry-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
											<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
										</svg>
									</button>

									<!-- Custom Floating Options Menu -->
									<div 
										id="enquiry-dropdown-content"
										class="hidden absolute z-40 left-0 right-0 mt-2 bg-[#090a12]/98 backdrop-blur-2xl border border-cyan-500/20 rounded-2xl p-2 shadow-[0_20px_50px_rgba(0,0,0,0.9)] space-y-1 max-h-72 overflow-y-auto"
									>
										<div data-value="ai_ml" class="enquiry-option px-4 py-3 rounded-xl cursor-pointer hover:bg-cyan-950/40 text-xs sm:text-sm font-sans text-neutral-200 hover:text-white flex items-center justify-between transition-all duration-200 bg-cyan-950/20 text-cyan-300">
											<span>AI ML Solutions (Custom Models & Intelligent Systems)</span>
											<svg class="w-4 h-4 text-cyan-400 check-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
										</div>
										<div data-value="ai_transformation" class="enquiry-option px-4 py-3 rounded-xl cursor-pointer hover:bg-cyan-950/40 text-xs sm:text-sm font-sans text-neutral-200 hover:text-white flex items-center justify-between transition-all duration-200">
											<span>AI Transformation (Enterprise AI Strategy & Adoption)</span>
											<svg class="w-4 h-4 text-cyan-400 check-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
										</div>
										<div data-value="ai_product" class="enquiry-option px-4 py-3 rounded-xl cursor-pointer hover:bg-cyan-950/40 text-xs sm:text-sm font-sans text-neutral-200 hover:text-white flex items-center justify-between transition-all duration-200">
											<span>AI Product Engineering (AI-Powered Software & Platforms)</span>
											<svg class="w-4 h-4 text-cyan-400 check-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
										</div>
										<div data-value="custom_software" class="enquiry-option px-4 py-3 rounded-xl cursor-pointer hover:bg-cyan-950/40 text-xs sm:text-sm font-sans text-neutral-200 hover:text-white flex items-center justify-between transition-all duration-200">
											<span>Custom Software Development (Web, Mobile & Enterprise Applications)</span>
											<svg class="w-4 h-4 text-cyan-400 check-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
										</div>
										<div data-value="platform_eng" class="enquiry-option px-4 py-3 rounded-xl cursor-pointer hover:bg-cyan-950/40 text-xs sm:text-sm font-sans text-neutral-200 hover:text-white flex items-center justify-between transition-all duration-200">
