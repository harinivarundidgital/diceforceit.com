	<script is:inline>
		function switchStaffingTab(tab) {
			var panels = {
				'temp': document.getElementById('tab-panel-temp'),
				'perm': document.getElementById('tab-panel-perm'),
				't2h': document.getElementById('tab-panel-t2h')
			};

			var btns = {
				'temp': document.getElementById('tab-btn-temp'),
				'perm': document.getElementById('tab-btn-perm'),
				't2h': document.getElementById('tab-btn-t2h')
			};

			for (var key in panels) {
				if (panels[key]) {
					if (key === tab) {
						panels[key].classList.remove('hidden');
					} else {
						panels[key].classList.add('hidden');
					}
				}

				if (btns[key]) {
					if (key === tab) {
						btns[key].className = 'staffing-tab-btn px-6 py-3 rounded-full font-mono text-xs uppercase tracking-wider font-bold transition-all border border-cyan-400 bg-cyan-500/10 text-cyan-400 shadow-[0_0_15px_rgba(34,211,238,0.2)]';
					} else {
						btns[key].className = 'staffing-tab-btn px-6 py-3 rounded-full font-mono text-xs uppercase tracking-wider font-bold transition-all border border-white/10 bg-white/[0.02] text-neutral-400 hover:text-white hover:border-white/30';
					}
				}
			}
		}
	</script>

	<!-- Three.js Interactive Particle SVG System (Careers Page Style) -->
	<script>
		import * as THREE from 'three';

		const canvasContainer = document.getElementById('canvas-container');
		const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		let scene: THREE.Scene, 
			camera: THREE.PerspectiveCamera, 
			renderer: THREE.WebGLRenderer,
			geometry: THREE.BufferGeometry,
			points: THREE.Points,
			currentScale = 1.0;

		function initThree() {
			if (!canvasContainer) return;
			
			// Load SVG image as textures/particles (IT Staffing Hero graphic)
			const img = new Image();
			img.crossOrigin = "anonymous";
			img.src = '/it-staffing-hero.svg';
			
			img.onload = () => {
				const sampleCanvas = document.createElement('canvas');
				const sWidth = 185;
				const sHeight = 185;
				
				sampleCanvas.width = sWidth;
				sampleCanvas.height = sHeight;
				const sCtx = sampleCanvas.getContext('2d');
				if (!sCtx) return;
				
				sCtx.drawImage(img, 0, 0, sWidth, sHeight);
				const imgData = sCtx.getImageData(0, 0, sWidth, sHeight);
				const data = imgData.data;
				
				const rawParticles = [];
				
				for (let y = 0; y < sHeight; y++) {
					for (let x = 0; x < sWidth; x++) {
						const idx = (y * sWidth + x) * 4;
						const r = data[idx];
						const g = data[idx + 1];
						const b = data[idx + 2];
						const a = data[idx + 3];
						
						if (a > 60) {
							const px = ((x / sWidth) - 0.5) * 5.0;
							const py = -((y / sHeight) - 0.5) * 5.0;
							const pz = (Math.random() - 0.5) * 0.12;
							
							rawParticles.push({
								x: px,
								y: py,
								z: pz,
								r: r / 255,
								g: g / 255,
								b: b / 255
							});
						}
					}
				}
				
				const maxParticles = 3200;
				let particlesList = [];
				if (rawParticles.length > maxParticles) {
					const rawCount = rawParticles.length;
					for (let i = 0; i < maxParticles; i++) {
						const index = Math.floor((i / (maxParticles - 1)) * (rawCount - 1));
						particlesList.push(rawParticles[index]);
					}
				} else {
					particlesList = rawParticles;
				}
				
				setupParticleSystem(particlesList);
			};
		}

		function setupParticleSystem(particlesList: any[]) {
			if (!canvasContainer) return;
			const width = canvasContainer.clientWidth;
			const height = canvasContainer.clientHeight || 350;
			
			scene = new THREE.Scene();
			
			camera = new THREE.PerspectiveCamera(60, width / height, 0.1, 100);
			camera.position.z = 4.8;
			
			renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
			renderer.setSize(width, height);
			renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
			renderer.domElement.style.display = 'block';
			canvasContainer.appendChild(renderer.domElement);
			
			const count = particlesList.length;
			const positions = new Float32Array(count * 3);
			const colors = new Float32Array(count * 3);
			const originalPositions = new Float32Array(count * 3);
			const velocities = new Float32Array(count * 3);
			
			for (let i = 0; i < count; i++) {
				const p = particlesList[i];
				const i3 = i * 3;
				
				originalPositions[i3] = p.x;
				originalPositions[i3 + 1] = p.y;
				originalPositions[i3 + 2] = p.z;
				
				positions[i3] = p.x + (Math.random() - 0.5) * 12;
				positions[i3 + 1] = p.y + (Math.random() - 0.5) * 12;
				positions[i3 + 2] = p.z + (Math.random() - 0.5) * 12;
				
				colors[i3] = p.r;
				colors[i3 + 1] = p.g;
				colors[i3 + 2] = p.b;
				
				velocities[i3] = 0;
				velocities[i3 + 1] = 0;
				velocities[i3 + 2] = 0;
			}
			
			geometry = new THREE.BufferGeometry();
			geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
			geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));
			
			const canvas = document.createElement('canvas');
			canvas.width = 32;
			canvas.height = 32;
			const ctx = canvas.getContext('2d');
			if (ctx) {
				const gradient = ctx.createRadialGradient(16, 16, 0, 16, 16, 16);
				gradient.addColorStop(0, 'rgba(255, 255, 255, 1)');
				gradient.addColorStop(0.25, 'rgba(255, 255, 255, 0.7)');
				gradient.addColorStop(0.6, 'rgba(255, 255, 255, 0.15)');
				gradient.addColorStop(1, 'rgba(255, 255, 255, 0)');
				ctx.fillStyle = gradient;
				ctx.fillRect(0, 0, 32, 32);
			}
			const texture = new THREE.CanvasTexture(canvas);
			
			const material = new THREE.PointsMaterial({
				size: 0.085,
				map: texture,
				transparent: true,
				opacity: 0.9,
				blending: THREE.AdditiveBlending,
				depthWrite: false,
				vertexColors: true
			});
			
			points = new THREE.Points(geometry, material);
			scene.add(points);
			
			function adjustScale() {
				if (!points || !canvasContainer) return;
				const w = canvasContainer.clientWidth;
				const h = canvasContainer.clientHeight || 350;
				const aspect = w / h;
				
				if (aspect < 1.0) {
					currentScale = aspect * 0.95;
				} else {
					currentScale = 1.05;
				}
				points.scale.set(currentScale, currentScale, currentScale);
			}
			
			adjustScale();
			
			const mouse = new THREE.Vector2(-9999, -9999);
			const mouse3D = new THREE.Vector3(-9999, -9999, 0);
			const plane = new THREE.Plane(new THREE.Vector3(0, 0, 1), 0);
			const raycaster = new THREE.Raycaster();
			
			function updateMousePosition(clientX: number, clientY: number) {
				if (!canvasContainer) return;
				const rect = canvasContainer.getBoundingClientRect();
				const x = ((clientX - rect.left) / rect.width) * 2 - 1;
				const y = -((clientY - rect.top) / rect.height) * 2 + 1;
				mouse.set(x, y);
				
				raycaster.setFromCamera(mouse, camera);
				raycaster.ray.intersectPlane(plane, mouse3D);
			}
			
			function handleMove(e: MouseEvent) {
				updateMousePosition(e.clientX, e.clientY);
			}
			
			function handleLeave() {
				mouse.set(-9999, -9999);
				mouse3D.set(-9999, -9999, 0);
			}
			
			function handleTouch(e: TouchEvent) {
				if (e.touches.length > 0) {
					updateMousePosition(e.touches[0].clientX, e.touches[0].clientY);
				}
			}
			
			canvasContainer.addEventListener('mousemove', handleMove);
			canvasContainer.addEventListener('mouseleave', handleLeave);
			canvasContainer.addEventListener('touchmove', handleTouch);
			canvasContainer.addEventListener('touchend', handleLeave);
			
			const clock = new THREE.Clock();
			
			function animate() {
				requestAnimationFrame(animate);
				
				const delta = Math.min(clock.getDelta(), 0.1);
				const elapsed = clock.getElapsedTime();

				if (points && !prefersReduced) {
					points.rotation.y = Math.sin(elapsed * 0.12) * 0.15;
					points.rotation.x = Math.cos(elapsed * 0.08) * 0.08;
				}

				const positionsAttr = geometry.attributes.position;
				const posArray = positionsAttr.array as Float32Array;
				
				const mouseRadius = 0.95;
				const mousePush = 3.5;
				const springForce = 5.2;
				const damping = 0.83;
				
				for (let i = 0; i < count; i++) {
					const idx = i * 3;
					
					let x = posArray[idx];
					let y = posArray[idx + 1];
					let z = posArray[idx + 2];
					
					const ox = originalPositions[idx];
					const oy = originalPositions[idx + 1];
					const oz = originalPositions[idx + 2];
					
					let vx = velocities[idx];
					let vy = velocities[idx + 1];
					let vz = velocities[idx + 2];
					
					if (mouse.x > -1000 && !prefersReduced) {
						const localMouseX = mouse3D.x / currentScale;
						const localMouseY = mouse3D.y / currentScale;
						const localMouseZ = mouse3D.z / currentScale;
						
						const dx = x - localMouseX;
						const dy = y - localMouseY;
						const dz = z - localMouseZ;
						const dist = Math.sqrt(dx*dx + dy*dy + dz*dz);
						
						if (dist < mouseRadius) {
							const pushStrength = (1.0 - dist / mouseRadius) * mousePush;
							const angleX = dist > 0 ? dx / dist : (Math.random() - 0.5);
							const angleY = dist > 0 ? dy / dist : (Math.random() - 0.5);
							const angleZ = dist > 0 ? dz / dist : (Math.random() - 0.5);
							
							vx += angleX * pushStrength * delta;
							vy += angleY * pushStrength * delta;
							vz += angleZ * pushStrength * delta;
						}
					}
					
					const sx = (ox - x) * springForce;
					const sy = (oy - y) * springForce;
					const sz = (oz - z) * springForce;
					
					vx += sx * delta;
					vy += sy * delta;
					vz += sz * delta;
					
					vx *= damping;
					vy *= damping;
					vz *= damping;
					
					x += vx;
					y += vy;
					z += vz;
					
					posArray[idx] = x;
					posArray[idx + 1] = y;
					posArray[idx + 2] = z;
					
					velocities[idx] = vx;
					velocities[idx + 1] = vy;
					velocities[idx + 2] = vz;
				}
				
				positionsAttr.needsUpdate = true;
				renderer.render(scene, camera);
			}
			
			animate();
			
			window.addEventListener('resize', () => {
				if (!canvasContainer || !renderer || !camera) return;
				const w = canvasContainer.clientWidth;
				const h = canvasContainer.clientHeight || 350;
				
				camera.aspect = w / h;
				camera.updateProjectionMatrix();
				renderer.setSize(w, h);
				
				adjustScale();
			});
		}

		initThree();
	</script>
