					const targetRole = applyBtn.getAttribute('data-role');
					const jobIdInput = document.getElementById('apply_job_id') as HTMLInputElement | null;
					if (targetJobId && jobIdInput) {
						jobIdInput.value = targetJobId;
					}
					if (positionSelect && targetJobId) {
						let matchingOption = Array.from(positionSelect.options).find(opt => 
							opt.value === targetJobId || 
							(targetRole && opt.text.toLowerCase().trim() === targetRole.toLowerCase().trim())
						);

						if (!matchingOption && targetRole) {
							const newOpt = document.createElement('option');
							newOpt.value = targetJobId;
							newOpt.text = targetRole;
							newOpt.className = 'bg-neutral-950 text-white';
							newOpt.setAttribute('data-job-id', targetJobId);
							positionSelect.appendChild(newOpt);
							matchingOption = newOpt;
						}

						if (matchingOption) {
							positionSelect.value = matchingOption.value;
						}
					}
					const applySection = document.getElementById('apply');
					if (applySection) {
						applySection.scrollIntoView({ behavior: 'smooth' });
					}
					return;
				}

				// Accordion Trigger Click
				const jobBtn = target.closest('.job-item button') as HTMLButtonElement | null;
				if (jobBtn) {
					const item = jobBtn.closest('.job-item') as HTMLElement | null;
					if (!item) return;
					const details = item.querySelector('.job-details') as HTMLElement | null;
					const chevron = jobBtn.querySelector('.chevron-icon svg') as HTMLElement | null;

					if (!details) return;
					const isOpen = !details.classList.contains('hidden');

					// Close all other open jobs
					document.querySelectorAll('.job-item').forEach(otherItem => {
						if (otherItem !== item) {
							const otherDetails = otherItem.querySelector('.job-details') as HTMLElement | null;
							const otherChevron = otherItem.querySelector('.chevron-icon svg') as HTMLElement | null;
							if (otherDetails && !otherDetails.classList.contains('hidden')) {
								gsap.to(otherDetails, {
									height: 0,
									opacity: 0,
									duration: 0.3,
									ease: 'power2.out',
									onComplete: () => {
										otherDetails.classList.add('hidden');
										otherDetails.style.height = '';
									}
								});
								if (otherChevron) otherChevron.style.transform = 'rotate(0deg)';
							}
						}
					});

					// Toggle current job
					if (isOpen) {
						gsap.to(details, {
							height: 0,
							opacity: 0,
							duration: 0.3,
							ease: 'power2.out',
							onComplete: () => {
								details.classList.add('hidden');
								details.style.height = '';
							}
						});
						if (chevron) chevron.style.transform = 'rotate(0deg)';
					} else {
						details.classList.remove('hidden');
						const naturalHeight = details.scrollHeight;
						gsap.fromTo(details, 
							{ height: 0, opacity: 0 },
							{ height: naturalHeight, opacity: 1, duration: 0.4, ease: 'power2.out' }
						);
						if (chevron) chevron.style.transform = 'rotate(180deg)';
					}
				}
			});
