---
import PageLayout from '../layouts/PageLayout.astro';

interface JobData {
	id: string;
	employer_id?: string;
	category_id?: string;
	category_name?: string;
	category?: string | { id?: string; name?: string; slug?: string };
	title: string;
	slug?: string;
	description?: string;
	requirements?: string | null;
	location?: string;
	employment_type?: string;
	work_mode?: string;
	salary_min?: string;
	salary_max?: string;
	experience_min?: string;
	experience_max?: string;
	skills?: string;
	status?: string;
	expires_at?: string;
	created_at?: string;
	updated_at?: string;
}

interface CategoryData {
	id: string | number;
	name: string;
	slug?: string;
	status?: string;
	created_at?: string;
	updated_at?: string;
}

const JOBS_API_URL = 'https://demo1.varundigitalmedia.com/jobportal/public/api/jobs';
const CATEGORIES_API_URL = 'https://demo1.varundigitalmedia.com/jobportal/public/api/categories';

const defaultCategoryMap: Record<string, string> = {
	'1': 'Software Development',
	'2': 'Sales & Marketing',
	'3': 'HR & Administration',
	'4': 'Finance',
	'5': 'Design'
};

const defaultCategories: CategoryData[] = [
	{ id: '1', name: 'Software Development', slug: 'software-development' },
	{ id: '2', name: 'Sales & Marketing', slug: 'sales-marketing' },
	{ id: '3', name: 'HR & Administration', slug: 'hr-administration' },
	{ id: '4', name: 'Finance', slug: 'finance' },
	{ id: '5', name: 'Design', slug: 'design' }
];

let initialCategories: CategoryData[] = [...defaultCategories];
let categoryMap: Record<string, string> = { ...defaultCategoryMap };

function formatWorkMode(mode?: string) {
	if (!mode) return 'Remote';
	if (mode.toLowerCase() === 'full_time') return 'Full-Time';
	return mode.charAt(0).toUpperCase() + mode.slice(1).toLowerCase();
}

function formatEmploymentType(type?: string) {
	if (!type) return 'Full-Time';
	return type.split('_').map(w => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase()).join('-');
}

function getJobCategory(job: JobData, catMap: Record<string, string> = categoryMap): string {
	if (job.category_name) return job.category_name;
	if (typeof job.category === 'string' && job.category.trim()) return job.category.trim();
	if (job.category && typeof job.category === 'object' && 'name' in job.category && job.category.name) {
		return job.category.name;
	}
	if (job.category_id && catMap[String(job.category_id)]) {
		return catMap[String(job.category_id)];
	}
	if (job.category_id) {
		return `Category ${job.category_id}`;
	}
	return 'General';
}

function formatSalary(min?: string, max?: string) {
	const minVal = min ? parseFloat(min) : 0;
	const maxVal = max ? parseFloat(max) : 0;
	if (minVal > 0 && maxVal > 0) {
		return `₹${minVal.toLocaleString('en-IN')} - ₹${maxVal.toLocaleString('en-IN')} PA`;
	}
	if (minVal > 0) {
		return `From ₹${minVal.toLocaleString('en-IN')} PA`;
	}
	if (maxVal > 0) {
		return `Up to ₹${maxVal.toLocaleString('en-IN')} PA`;
	}
	return 'Competitive Base + Growth Options';
}

function formatExperience(min?: string, max?: string) {
	const minExp = min ? parseFloat(min) : 0;
	const maxExp = max ? parseFloat(max) : 0;
	if (minExp > 0 && maxExp > 0) {
		return `${minExp} - ${maxExp} years`;
	}
	if (minExp > 0) {
		return `${minExp}+ years`;
	}
	if (maxExp > 0) {
		return `Up to ${maxExp} years`;
	}
	return 'Experienced';
}

function formatSkills(skillsStr?: string) {
	if (!skillsStr) return [];
	return skillsStr.split(',').map(s => s.trim()).filter(Boolean);
}

function parseRequirements(req: string | null | undefined): string[] {
	if (!req) return [];
	if (Array.isArray(req)) return req;
	if (typeof req === 'string' && req.includes('<li')) {
		const matches = req.match(/<li[^>]*>(.*?)<\/li>/gi);
		if (matches) {
			return matches.map(m => m.replace(/<\/?li[^>]*>/gi, '').trim()).filter(Boolean);
		}
	}
	return String(req).split(/\r?\n|•|;/).map(s => s.trim().replace(/^[-*]\s*/, '')).filter(Boolean);
}

const fallbackJobs: JobData[] = [
	{
		id: '2',
		employer_id: '3',
		category_id: '3',
		title: 'Web Developer',
		slug: 'web-developer-7c7310',
		description: 'Test',
		requirements: null,
		location: 'hyderabad',
		employment_type: 'full_time',
		work_mode: 'onsite',
		salary_min: '800000.00',
		salary_max: '1000000.00',
		experience_min: '4.0',
		experience_max: '6.0',
		skills: 'HTML,JS,CSS,React',
		status: 'published',
		expires_at: '2026-09-23',
		created_at: '2026-09-09 13:20:55',
		updated_at: '2026-09-09 13:26:35'
	},
	{
		id: '1',
		employer_id: '3',
		category_id: '1',
		title: 'Laravel Developer',
		slug: 'laravel-developer-73af0c',
		description: 'TEST DATA',
		requirements: null,
		location: 'Hyderabad',
		employment_type: 'full_time',
		work_mode: 'onsite',
		salary_min: '1200000.00',
		salary_max: '1600000.00',
		experience_min: '4.0',
		experience_max: '5.0',
		skills: 'php, laravel, CI3,CI4',
		status: 'published',
		expires_at: '2026-10-30',
		created_at: '2026-09-09 12:16:15',
		updated_at: '2026-09-09 12:16:15'
	}
];

let initialJobs: JobData[] = [];

try {
	const [jobsRes, catRes] = await Promise.all([
		fetch(JOBS_API_URL, {
			headers: { 'Accept': 'application/json' },
			signal: AbortSignal.timeout(5000)
		}),
		fetch(CATEGORIES_API_URL, {
			headers: { 'Accept': 'application/json' },
			signal: AbortSignal.timeout(5000)
		})
	]);

	if (catRes.ok) {
		const catJson = await catRes.json();
		if (catJson?.status && Array.isArray(catJson?.data) && catJson.data.length > 0) {
			const activeCats: CategoryData[] = [];
			catJson.data.forEach((cat: any) => {
				if (cat?.id && cat?.name) {
					categoryMap[String(cat.id)] = String(cat.name);
					if (cat.status !== 'inactive') {
						activeCats.push({
							id: cat.id,
							name: cat.name,
							slug: cat.slug || cat.name.toLowerCase().replace(/\s+/g, '-'),
							status: cat.status
						});
					}
				}
			});
			if (activeCats.length > 0) {
				initialCategories = activeCats;
			}
		}
	}

	if (jobsRes.ok) {
		const json = await jobsRes.json();
		if (json?.status && Array.isArray(json?.data) && json.data.length > 0) {
			initialJobs = json.data;
		}
	}
} catch (e) {
	// Fallback used below if fetch fails
}

if (!initialJobs || initialJobs.length === 0) {
	initialJobs = fallbackJobs;
}
