		// Drag & Drop File Upload UI updates
		const fileInput = document.getElementById('resume-file') as HTMLInputElement | null;
		const dropZone = document.getElementById('drop-zone');
		const emptyState = document.getElementById('upload-empty-state');
		const activeState = document.getElementById('upload-active-state');
		const fileNameSpan = document.getElementById('uploaded-file-name');
		const removeBtn = document.getElementById('remove-file-btn');
		const canvasContainer = document.getElementById('canvas-container');
		const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let selectedResumeFile: File | null = null;

		if (fileInput && dropZone && emptyState && activeState && fileNameSpan && removeBtn) {
			const handleFile = (file: File) => {
				selectedResumeFile = file;
				fileNameSpan.innerText = file.name;
				emptyState.classList.add('hidden');
				activeState.classList.remove('hidden');
				dropZone.classList.add('border-cyan-500/30', 'bg-cyan-950/5');
				fileInput.classList.add('pointer-events-none');
			};

			fileInput.addEventListener('change', () => {
				if (fileInput.files && fileInput.files.length > 0) {
					handleFile(fileInput.files[0]);
				}
			});

			removeBtn.addEventListener('click', (e) => {
				e.preventDefault();
				e.stopPropagation(); // Avoid triggering file selection dialog
				selectedResumeFile = null;
				fileInput.value = '';
				fileInput.classList.remove('pointer-events-none');
				activeState.classList.add('hidden');
				emptyState.classList.remove('hidden');
				dropZone.classList.remove('border-cyan-500/30', 'bg-cyan-950/5');
			});

			// drag and drop triggers
			dropZone.addEventListener('dragover', (e) => {
				e.preventDefault();
				if (!activeState.classList.contains('hidden')) return;
				dropZone.classList.add('border-cyan-500/50', 'bg-cyan-950/10');
			});

			dropZone.addEventListener('dragleave', () => {
				if (!activeState.classList.contains('hidden')) return;
				dropZone.classList.remove('border-cyan-500/50', 'bg-cyan-950/10');
			});

			dropZone.addEventListener('drop', (e) => {
				e.preventDefault();
				if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
					const file = e.dataTransfer.files[0];
					try {
						fileInput.files = e.dataTransfer.files;
					} catch (_) {}
					handleFile(file);
				}
			});
		}

		// Application submission sequence
		const applyForm = document.getElementById('apply-form') as HTMLFormElement | null;
		const successScreen = document.getElementById('success-screen');
		const resetFormBtn = document.getElementById('reset-form-btn');
		const applyErrorMsg = document.getElementById('apply-error-msg');

		if (applyForm && successScreen && resetFormBtn) {
			applyForm.addEventListener('submit', async (e) => {
				e.preventDefault();

				if (applyErrorMsg) {
					applyErrorMsg.innerText = '';
					applyErrorMsg.classList.add('hidden');
				}

				// Check resume file
				const file = selectedResumeFile || (fileInput?.files && fileInput.files[0]);
				if (!file) {
					if (applyErrorMsg) {
						applyErrorMsg.innerText = 'Please attach your resume (PDF or DOCX) before submitting.';
						applyErrorMsg.classList.remove('hidden');
					}
					return;
				}

				// Validate file size (5MB limit)
				if (file.size > 5 * 1024 * 1024) {
					if (applyErrorMsg) {
						applyErrorMsg.innerText = 'The uploaded resume exceeds the 5MB size limit. Please upload a smaller file.';
						applyErrorMsg.classList.remove('hidden');
					}
					return;
				}

				const submitBtn = applyForm.querySelector('button[type="submit"]') as HTMLButtonElement | null;
				if (submitBtn) {
					submitBtn.disabled = true;
					const btnText = submitBtn.querySelector('span');
					if (btnText) {
						btnText.innerText = 'Transmitting Application…';
					} else {
						submitBtn.innerText = 'Transmitting Application…';
					}
				}

				try {
					const formData = new FormData();

					// Cover letter text matching curl: --form 'cover_letter=...'
					const coverLetterEl = (document.getElementById('apply_cover_letter') || document.getElementById('apply_message')) as HTMLTextAreaElement | null;
					const coverLetterText = coverLetterEl?.value?.trim() || '';
					formData.append('cover_letter', coverLetterText);

					// Resume file matching curl: --form 'resume=@...'
					formData.append('resume', file);

					// Additional applicant profile info
					const nameInput = document.getElementById('apply_name') as HTMLInputElement | null;
					const emailInput = document.getElementById('apply_email') as HTMLInputElement | null;
					const phoneInput = document.getElementById('apply_phone') as HTMLInputElement | null;
					const portfolioInput = document.getElementById('apply_url') as HTMLInputElement | null;
					if (nameInput?.value?.trim()) formData.append('name', nameInput.value.trim());
					if (emailInput?.value?.trim()) formData.append('email', emailInput.value.trim());
					if (phoneInput?.value?.trim()) formData.append('phone', phoneInput.value.trim());
					if (portfolioInput?.value?.trim()) formData.append('portfolio_url', portfolioInput.value.trim());

					// Dynamic Target Job ID for whichever position the user selected or clicked
					const jobIdInput = document.getElementById('apply_job_id') as HTMLInputElement | null;
					const jobId = jobIdInput?.value?.trim() || positionSelect?.value?.trim();
					if (!jobId) {
						if (applyErrorMsg) {
							applyErrorMsg.innerText = 'Please select the position you are applying for.';
							applyErrorMsg.classList.remove('hidden');
						}
						if (submitBtn) {
							submitBtn.disabled = false;
							const btnText = submitBtn.querySelector('span');
							if (btnText) btnText.innerText = 'Send';
							else submitBtn.innerText = 'Send';
						}
						return;
					}
					formData.append('job_id', jobId);

					// Target URLs
					const guestEndpoint = `/api/jobs/${jobId}/apply/guest`;
					const fallbackProxy = '/api/apply';
					const directApiUrl = `https://demo1.varundigitalmedia.com/jobportal/public/api/jobs/${jobId}/apply/guest`;

					let response: Response;
					try {
						// Submit via guest endpoint proxy
						response = await fetch(guestEndpoint, {
							method: 'POST',
							body: formData
						});

						if (!response.ok && response.status === 404) {
							// Try proxy fallback
							response = await fetch(fallbackProxy, {
								method: 'POST',
								body: formData
							});
						}
					} catch (proxyErr) {
						// Fallback to proxy route or direct call if guest route is unavailable
						try {
							response = await fetch(fallbackProxy, {
								method: 'POST',
								body: formData
							});
						} catch (_) {
							response = await fetch(directApiUrl, {
								method: 'POST',
								body: formData
							});
						}
					}

					const result = await response.json().catch(() => ({}));
					const isSuccess = response.ok && (result.status === true || result.success === true || result.status === 200 || (!result.errors && !result.message?.toLowerCase().includes('error')));

					if (!isSuccess) {
						let errorMsg = result.message || result.error;
						if (!errorMsg && result.errors) {
							errorMsg = typeof result.errors === 'object'
								? Object.values(result.errors).join(' ')
								: String(result.errors);
						}
						if (!errorMsg) {
							errorMsg = response.status === 401
								? 'Submission failed: Authorization header required by API.'
								: `Application submission returned status ${response.status}. Please try again later.`;
						}
						throw new Error(errorMsg);
					}

					// Clear form inputs and dropzone immediately upon successful submission
					applyForm.reset();
					selectedResumeFile = null;
					if (fileInput && dropZone && emptyState && activeState) {
						fileInput.value = '';
						fileInput.classList.remove('pointer-events-none');
						activeState.classList.add('hidden');
						emptyState.classList.remove('hidden');
						dropZone.classList.remove('border-cyan-500/30', 'bg-cyan-950/5');
					}
					if (applyErrorMsg) {
						applyErrorMsg.innerText = '';
						applyErrorMsg.classList.add('hidden');
					}

					// Animate transition to clean success screen
					gsap.to(applyForm, {
						opacity: 0,
						y: -10,
						duration: 0.35,
						onComplete: () => {
							applyForm.classList.add('hidden');
							successScreen.classList.remove('hidden');
							successScreen.style.opacity = '0';
							successScreen.style.transform = 'translateY(10px)';

							gsap.to(successScreen, {
								opacity: 1,
								y: 0,
								duration: 0.4,
								ease: 'power2.out'
							});
						}
					});
				} catch (err: any) {
					console.error('Application transmission error:', err);
					if (applyErrorMsg) {
						applyErrorMsg.innerText = err.message || 'Unable to transmit application. Please check your connection or email hr@diceforceit.com directly.';
						applyErrorMsg.classList.remove('hidden');
					}
					if (submitBtn) {
						submitBtn.disabled = false;
						const btnText = submitBtn.querySelector('span');
						if (btnText) {
							btnText.innerText = 'Send';
						} else {
							submitBtn.innerText = 'Send';
						}
					}
				}
			});

			resetFormBtn.addEventListener('click', () => {
				gsap.to(successScreen, {
					opacity: 0,
					y: 10,
					duration: 0.3,
					onComplete: () => {
						successScreen.classList.add('hidden');

						applyForm.reset();
						selectedResumeFile = null;
						if (applyErrorMsg) {
							applyErrorMsg.innerText = '';
							applyErrorMsg.classList.add('hidden');
						}
						if (fileInput && dropZone && emptyState && activeState) {
							fileInput.value = '';
							fileInput.classList.remove('pointer-events-none');
							activeState.classList.add('hidden');
							emptyState.classList.remove('hidden');
							dropZone.classList.remove('border-cyan-500/30', 'bg-cyan-950/5');
						}

						applyForm.classList.remove('hidden');
						applyForm.style.opacity = '0';
						applyForm.style.transform = 'translateY(-10px)';

						const submitBtn = applyForm.querySelector('button[type="submit"]') as HTMLButtonElement | null;
						if (submitBtn) {
							submitBtn.disabled = false;
							const btnText = submitBtn.querySelector('span');
							if (btnText) {
								btnText.innerText = 'Send';
							} else {
								submitBtn.innerText = 'Send';
							}
						}

						gsap.to(applyForm, {
							opacity: 1,
							y: 0,
							duration: 0.5,
							ease: 'power2.out'
						});
					}
				});
			});
		}

		// 3. Three.js Interactive Particle SVG Image System
		let scene: THREE.Scene, 
			camera: THREE.PerspectiveCamera, 
			renderer: THREE.WebGLRenderer,
			geometry: THREE.BufferGeometry,
			points: THREE.Points,
			currentScale = 1.0;
		
		function initThree() {
			if (!canvasContainer) return;
			
			// Load SVG image as textures/particles
			const img = new Image();
			img.crossOrigin = "anonymous";
			img.src = '/careers-hero.svg';
			
			img.onload = () => {
				const sampleCanvas = document.createElement('canvas');
				const sWidth = 185;
				const sHeight = 185;
				
				sampleCanvas.width = sWidth;
				sampleCanvas.height = sHeight;
				const sCtx = sampleCanvas.getContext('2d');
				if (!sCtx) return;
				
				sCtx.drawImage(img, 0, 0, sWidth, sHeight);
				const imgData = sCtx.getImageData(0, 0, sWidth, sHeight);
				const data = imgData.data;
				
				const rawParticles = [];
				
				for (let y = 0; y < sHeight; y++) {
					for (let x = 0; x < sWidth; x++) {
						const idx = (y * sWidth + x) * 4;
						const r = data[idx];
						const g = data[idx + 1];
						const b = data[idx + 2];
						const a = data[idx + 3];
						
						if (a > 60) {
							const px = ((x / sWidth) - 0.5) * 5.0;
							const py = -((y / sHeight) - 0.5) * 5.0;
							const pz = (Math.random() - 0.5) * 0.12;
							
							rawParticles.push({
								x: px,
								y: py,
								z: pz,
								r: r / 255,
								g: g / 255,
								b: b / 255
							});
						}
					}
				}
				
				const maxParticles = 3200;
				let particlesList = [];
				if (rawParticles.length > maxParticles) {
					const rawCount = rawParticles.length;
					for (let i = 0; i < maxParticles; i++) {
						const index = Math.floor((i / (maxParticles - 1)) * (rawCount - 1));
						particlesList.push(rawParticles[index]);
					}
				} else {
					particlesList = rawParticles;
				}
				
				setupParticleSystem(particlesList);
			};
		}

		function setupParticleSystem(particlesList: any[]) {
			if (!canvasContainer) return;
			const width = canvasContainer.clientWidth;
			const height = canvasContainer.clientHeight || 350;
			
			scene = new THREE.Scene();
			
			camera = new THREE.PerspectiveCamera(60, width / height, 0.1, 100);
			camera.position.z = 4.8;
			
			renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
			renderer.setSize(width, height);
			renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
			renderer.domElement.style.display = 'block';
			canvasContainer.appendChild(renderer.domElement);
			
			const count = particlesList.length;
			const positions = new Float32Array(count * 3);
			const colors = new Float32Array(count * 3);
			const originalPositions = new Float32Array(count * 3);
			const velocities = new Float32Array(count * 3);
			
			for (let i = 0; i < count; i++) {
				const p = particlesList[i];
				const i3 = i * 3;
				
				originalPositions[i3] = p.x;
				originalPositions[i3 + 1] = p.y;
				originalPositions[i3 + 2] = p.z;
				
				positions[i3] = p.x + (Math.random() - 0.5) * 12;
				positions[i3 + 1] = p.y + (Math.random() - 0.5) * 12;
				positions[i3 + 2] = p.z + (Math.random() - 0.5) * 12;
				
				colors[i3] = p.r;
				colors[i3 + 1] = p.g;
				colors[i3 + 2] = p.b;
				
				velocities[i3] = 0;
				velocities[i3 + 1] = 0;
				velocities[i3 + 2] = 0;
			}
			
			geometry = new THREE.BufferGeometry();
			geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
			geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));
			
			const canvas = document.createElement('canvas');
			canvas.width = 32;
			canvas.height = 32;
			const ctx = canvas.getContext('2d');
			if (ctx) {
				const gradient = ctx.createRadialGradient(16, 16, 0, 16, 16, 16);
				gradient.addColorStop(0, 'rgba(255, 255, 255, 1)');
				gradient.addColorStop(0.25, 'rgba(255, 255, 255, 0.7)');
				gradient.addColorStop(0.6, 'rgba(255, 255, 255, 0.15)');
				gradient.addColorStop(1, 'rgba(255, 255, 255, 0)');
				ctx.fillStyle = gradient;
				ctx.fillRect(0, 0, 32, 32);
			}
			const texture = new THREE.CanvasTexture(canvas);
			
			const material = new THREE.PointsMaterial({
				size: 0.085,
				map: texture,
				transparent: true,
				opacity: 0.9,
				blending: THREE.AdditiveBlending,
				depthWrite: false,
				vertexColors: true
			});
			
			points = new THREE.Points(geometry, material);
			scene.add(points);
			
			function adjustScale() {
				if (!points || !canvasContainer) return;
				const w = canvasContainer.clientWidth;
				const h = canvasContainer.clientHeight || 350;
				const aspect = w / h;
				
				if (aspect < 1.0) {
					currentScale = aspect * 0.95;
				} else {
					currentScale = 1.05;
				}
				points.scale.set(currentScale, currentScale, currentScale);
			}
			
			adjustScale();
			
			const mouse = new THREE.Vector2(-9999, -9999);
			const mouse3D = new THREE.Vector3(-9999, -9999, 0);
			const plane = new THREE.Plane(new THREE.Vector3(0, 0, 1), 0);
			const raycaster = new THREE.Raycaster();
			
			function updateMousePosition(clientX: number, clientY: number) {
				if (!canvasContainer) return;
				const rect = canvasContainer.getBoundingClientRect();
				const x = ((clientX - rect.left) / rect.width) * 2 - 1;
				const y = -((clientY - rect.top) / rect.height) * 2 + 1;
				mouse.set(x, y);
				
				raycaster.setFromCamera(mouse, camera);
				raycaster.ray.intersectPlane(plane, mouse3D);
			}
			
			function handleMove(e: MouseEvent) {
				updateMousePosition(e.clientX, e.clientY);
			}
			
			function handleLeave() {
				mouse.set(-9999, -9999);
				mouse3D.set(-9999, -9999, 0);
			}
			
			function handleTouch(e: TouchEvent) {
				if (e.touches.length > 0) {
					updateMousePosition(e.touches[0].clientX, e.touches[0].clientY);
				}
			}
			
			canvasContainer.addEventListener('mousemove', handleMove);
			canvasContainer.addEventListener('mouseleave', handleLeave);
			canvasContainer.addEventListener('touchmove', handleTouch);
			canvasContainer.addEventListener('touchend', handleLeave);
			
			const clock = new THREE.Clock();
			
			function animate() {
				requestAnimationFrame(animate);
				
				const delta = Math.min(clock.getDelta(), 0.1);
				const elapsed = clock.getElapsedTime();

				// Rotate the image particles slightly for a premium dynamic feel
				if (points && !prefersReduced) {
					points.rotation.y = Math.sin(elapsed * 0.12) * 0.15;
					points.rotation.x = Math.cos(elapsed * 0.08) * 0.08;
				}

				const positionsAttr = geometry.attributes.position;
				const posArray = positionsAttr.array as Float32Array;
				
				const mouseRadius = 0.95;
				const mousePush = 3.5;
				const springForce = 5.2;
				const damping = 0.83;
				
				for (let i = 0; i < count; i++) {
					const idx = i * 3;
					
					let x = posArray[idx];
					let y = posArray[idx + 1];
					let z = posArray[idx + 2];
					
					const ox = originalPositions[idx];
					const oy = originalPositions[idx + 1];
					const oz = originalPositions[idx + 2];
					
					let vx = velocities[idx];
					let vy = velocities[idx + 1];
					let vz = velocities[idx + 2];
					
					if (mouse.x > -1000 && !prefersReduced) {
						const localMouseX = mouse3D.x / currentScale;
						const localMouseY = mouse3D.y / currentScale;
						const localMouseZ = mouse3D.z / currentScale;
						
						const dx = x - localMouseX;
						const dy = y - localMouseY;
						const dz = z - localMouseZ;
						const dist = Math.sqrt(dx*dx + dy*dy + dz*dz);
						
						if (dist < mouseRadius) {
							const pushStrength = (1.0 - dist / mouseRadius) * mousePush;
							const angleX = dist > 0 ? dx / dist : (Math.random() - 0.5);
							const angleY = dist > 0 ? dy / dist : (Math.random() - 0.5);
							const angleZ = dist > 0 ? dz / dist : (Math.random() - 0.5);
							
							vx += angleX * pushStrength * delta;
							vy += angleY * pushStrength * delta;
							vz += angleZ * pushStrength * delta;
						}
					}
					
					const sx = (ox - x) * springForce;
					const sy = (oy - y) * springForce;
					const sz = (oz - z) * springForce;
					
					vx += sx * delta;
					vy += sy * delta;
					vz += sz * delta;
					
					vx *= damping;
					vy *= damping;
					vz *= damping;
					
					x += vx;
					y += vy;
					z += vz;
					
					posArray[idx] = x;
					posArray[idx + 1] = y;
					posArray[idx + 2] = z;
					
					velocities[idx] = vx;
					velocities[idx + 1] = vy;
					velocities[idx + 2] = vz;
				}
				
				positionsAttr.needsUpdate = true;
				renderer.render(scene, camera);
			}
			
			animate();
			
			window.addEventListener('resize', () => {
				if (!canvasContainer || !renderer || !camera) return;
				const w = canvasContainer.clientWidth;
				const h = canvasContainer.clientHeight || 350;
				
				camera.aspect = w / h;
				camera.updateProjectionMatrix();
				renderer.setSize(w, h);
				
				adjustScale();
			});
		}

		initThree();
	</script>
</PageLayout>
