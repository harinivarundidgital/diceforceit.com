	<!-- Interactive Script -->
	<script>
		import * as THREE from 'three';
		import { gsap } from 'gsap';

		// Dynamic Jobs Fetch & Render
		const JOBS_API_URL = 'https://demo1.varundigitalmedia.com/jobportal/public/api/jobs';
		const CATEGORIES_API_URL = 'https://demo1.varundigitalmedia.com/jobportal/public/api/categories';
		const positionsContainer = document.getElementById('positions-container');
		const positionSelect = document.getElementById('apply_position') as HTMLSelectElement | null;

		let clientCategoryMap: Record<string, string> = {
			'1': 'Software Development',
			'2': 'Sales & Marketing',
			'3': 'HR & Administration',
			'4': 'Finance',
			'5': 'Design'
		};
		let clientJobsList: any[] = [];

		function formatWorkModeClient(mode?: string) {
			if (!mode) return 'Remote';
			if (mode.toLowerCase() === 'full_time') return 'Full-Time';
			return mode.charAt(0).toUpperCase() + mode.slice(1).toLowerCase();
		}

		function formatEmploymentTypeClient(type?: string) {
			if (!type) return 'Full-Time';
			return type.split('_').map(w => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase()).join('-');
		}

		function getJobCategoryClient(job: any): string {
			if (job.category_name) return job.category_name;
			if (typeof job.category === 'string' && job.category.trim()) return job.category.trim();
			if (job.category && typeof job.category === 'object' && job.category.name) {
				return job.category.name;
			}
			if (job.category_id && clientCategoryMap[String(job.category_id)]) {
				return clientCategoryMap[String(job.category_id)];
			}
			if (job.category_id) {
				return `Category ${job.category_id}`;
			}
			return 'General';
		}

		function formatSalaryClient(min?: string, max?: string) {
			const minVal = min ? parseFloat(min) : 0;
			const maxVal = max ? parseFloat(max) : 0;
			if (minVal > 0 && maxVal > 0) {
				return `₹${minVal.toLocaleString('en-IN')} - ₹${maxVal.toLocaleString('en-IN')} PA`;
			}
			if (minVal > 0) {
				return `From ₹${minVal.toLocaleString('en-IN')} PA`;
			}
			if (maxVal > 0) {
				return `Up to ₹${maxVal.toLocaleString('en-IN')} PA`;
			}
			return 'Competitive Base + Growth Options';
		}

		function formatExperienceClient(min?: string, max?: string) {
			const minExp = min ? parseFloat(min) : 0;
			const maxExp = max ? parseFloat(max) : 0;
			if (minExp > 0 && maxExp > 0) {
				return `${minExp} - ${maxExp} years`;
			}
			if (minExp > 0) {
				return `${minExp}+ years`;
			}
			if (maxExp > 0) {
				return `Up to ${maxExp} years`;
			}
			return 'Experienced';
		}

		function formatSkillsClient(skillsStr?: string): string[] {
			if (!skillsStr) return [];
			return skillsStr.split(',').map((s: string) => s.trim()).filter(Boolean);
		}

		function parseRequirementsClient(req: any): string[] {
			if (!req) return [];
			if (Array.isArray(req)) return req;
			if (typeof req === 'string' && req.includes('<li')) {
				const matches = req.match(/<li[^>]*>(.*?)<\/li>/gi);
				if (matches) {
					return matches.map((m: string) => m.replace(/<\/?li[^>]*>/gi, '').trim()).filter(Boolean);
				}
			}
			if (typeof req === 'string') {
				return req.split(/\r?\n|•|;/).map((s: string) => s.trim().replace(/^[-*]\s*/, '')).filter(Boolean);
			}
			return [];
		}

