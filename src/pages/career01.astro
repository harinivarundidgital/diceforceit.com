		function updatePositionOptions(jobs: any[]) {
			if (!positionSelect || !Array.isArray(jobs) || jobs.length === 0) return;
			const currentSelected = positionSelect.value;
			
			// Keep existing placeholder option
			const placeholder = positionSelect.querySelector('option[value=""]');
			positionSelect.innerHTML = '';
			if (placeholder) {
				positionSelect.appendChild(placeholder);
			} else {
				const defaultOpt = document.createElement('option');
				defaultOpt.value = '';
				defaultOpt.disabled = true;
				defaultOpt.selected = true;
				defaultOpt.className = 'bg-neutral-950 text-neutral-400';
				defaultOpt.textContent = 'Select open position…';
				positionSelect.appendChild(defaultOpt);
			}

			jobs.forEach((job: any) => {
				if (!job || !job.title) return;
				const opt = document.createElement('option');
				opt.value = String(job.id);
				opt.textContent = job.title;
				opt.className = 'bg-neutral-950 text-white';
				opt.setAttribute('data-job-id', String(job.id));
				positionSelect.appendChild(opt);
			});

			if (currentSelected) {
				const matchingOpt = Array.from(positionSelect.options).find(o => 
					o.value === currentSelected || 
					o.text.toLowerCase() === currentSelected.toLowerCase()
				);
				if (matchingOpt) {
					positionSelect.value = matchingOpt.value;
					const jobIdInput = document.getElementById('apply_job_id') as HTMLInputElement | null;
					if (jobIdInput) jobIdInput.value = matchingOpt.value;
				}
			}
		}

		async function fetchAndRenderJobs() {
			try {
				const [jobsRes, catRes] = await Promise.all([
					fetch(JOBS_API_URL).catch(() => null),
					fetch(CATEGORIES_API_URL).catch(() => null)
				]);

				if (catRes && catRes.ok) {
					const catJson = await catRes.json();
					if (catJson && catJson.status && Array.isArray(catJson.data)) {
						catJson.data.forEach((cat: any) => {
							if (cat?.id && cat?.name) {
								clientCategoryMap[String(cat.id)] = String(cat.name);
							}
						});
					}
				}

				if (jobsRes && jobsRes.ok) {
					const json = await jobsRes.json();
					if (json && json.status && Array.isArray(json.data) && json.data.length > 0) {
						clientJobsList = json.data;
						updatePositionOptions(json.data);
						if (positionsContainer) {
							positionsContainer.innerHTML = json.data.map((job: any) => renderJobHtml(job)).join('');
						}
					}
				}
			} catch (err) {
				console.warn('Jobs API fetch error, pre-rendered positions active:', err);
			}
		}

