			<!-- Interactive Script for Delivery Approach Section -->
			<script>
				document.addEventListener('DOMContentLoaded', () => {
					const modalData = {
						nocode: {
							title: "No-Code Delivery",
							badge: "RAPID PROTOTYPING & AGILITY",
							pills: ["Visual Workflow Drag & Drop", "Rapid Concept Validation", "Task Automation", "Zero Code Friction"],
							icon: `<svg class="w-7 h-7 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>`,
							paragraphs: [
								"No Code is a visual approach to building applications without writing traditional code. At <strong class='text-cyan-300 font-medium'>Diceforce IT</strong>, we assist businesses in swiftly developing intelligent processes, automating repetitive tasks, and validating concepts without requiring complex programming.",
								"We help teams adopt AI swiftly as part of our <strong class='text-cyan-300 font-medium'>AI consulting services</strong>, and we provide a solid basis for future enterprise-scale innovation."
							]
						},
						lowcode: {
							title: "Low-Code Delivery",
							badge: "HYBRID SPEED & FLEXIBILITY",
							pills: ["Enterprise Integrations", "Hybrid Speed & Custom Code", "Workflow Customization", "Business Agility"],
							icon: `<svg class="w-7 h-7 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>`,
							paragraphs: [
								"Low code helps to bridge the gap between quality of code and business agility. Custom code and visual construction in Low Code are suitable for faster application deployment.",
								"It enables businesses to connect enterprise systems, customize workflows, and react swiftly to changing business requirements while driving their application delivery. We assist businesses in determining where minimal code has the most operational benefit by using our experience in <strong class='text-cyan-300 font-medium'>AI/ML consultancy</strong>."
							]
						},
						procode: {
							title: "Pro-Code Enterprise AI",
							badge: "FULL CUSTOMIZATION & SCALABLE ENGINEERING",
							pills: ["Enterprise-Grade Security", "Complete Engineering Freedom", "Agentic AI Solutions", "Cloud-Native Scale"],
							icon: `<svg class="w-7 h-7 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>`,
							paragraphs: [
								"Pro Code is where enterprise AI truly comes to life, where both visual control and full code customization are supported. Complex business challenges need custom-built solutions that extend beyond platform limitations, requiring intelligent architectures, secure integrations, and scalable engineering. As an AI consulting company, <strong class='text-cyan-300 font-medium'>Diceforce IT</strong> develops enterprise applications designed specifically for organizations pursuing long-term digital transformation.",
								"Pro Code is designed for businesses that want <strong class='text-cyan-300 font-medium'>enterprise-grade security</strong>, complete engineering freedom, and solutions that go beyond the capabilities of Low code and No code platforms. Pro Code gives business-critical applications the control they need to develop, expand, and change existing systems with confidence when they call for unique processes, sophisticated connections, or AI-driven decision-making.",
								"Our engineering teams build advanced AI systems, <strong class='text-cyan-300 font-medium'>Agentic AI solutions</strong>, intelligent automation platforms, and cloud-native applications using modern Pro code development frameworks. Through AI strategy consulting at <strong class='text-cyan-300 font-medium'>Diceforce IT</strong>, we help organizations leverage Pro code for building intelligent products that solve their complex business challenges.",
								"Diceforce IT is an AI consulting firm that offers <strong class='text-cyan-300 font-medium'>AI consulting services</strong> and AI/ML consulting to create intelligent apps that work well with your current technological infrastructure. We assist businesses in creating safe, scalable, and future-ready AI solutions aligned with their objectives through enterprise AI."
							]
						}
					};

					let currentKey = 'nocode';

					// DOM Elements
					const modal = document.getElementById('delivery-modal');
					const modalOverlay = document.getElementById('modal-overlay');
					const modalClose = document.getElementById('modal-close');
					const modalTitle = document.getElementById('modal-title');
					const modalBadge = document.getElementById('modal-badge');
					const modalIconContainer = document.getElementById('modal-icon-container');
					const modalPills = document.getElementById('modal-pills');
					const modalBody = document.getElementById('modal-body');

					const detailPanel = document.getElementById('delivery-detail-panel');
					const panelCloseBtn = document.getElementById('panel-close-btn');
					const panelTitle = document.getElementById('panel-title');
					const panelBadge = document.getElementById('panel-badge');
					const panelIconContainer = document.getElementById('panel-icon-container');
					const panelPills = document.getElementById('panel-pills');
					const panelBody = document.getElementById('panel-body');
					const openModalFromPanelBtn = document.getElementById('open-modal-from-panel');

					const readMoreButtons = document.querySelectorAll('.delivery-read-more');
					const deliveryCards = document.querySelectorAll('.delivery-card');
					const panelTabBtns = document.querySelectorAll('.panel-tab-btn');

					// Update Inline Detail Panel Content
					function renderDetailPanel(key) {
						currentKey = key;
						const data = modalData[key];
						if (!data) return;

						if (panelTitle) panelTitle.textContent = data.title;
						if (panelBadge) panelBadge.textContent = data.badge;
						if (panelIconContainer && data.icon) panelIconContainer.innerHTML = data.icon;

						if (panelPills && Array.isArray(data.pills)) {
							panelPills.innerHTML = data.pills.map(pill => 
								`<span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-cyan-950/70 border border-cyan-500/30 text-cyan-200 text-xs font-mono shadow-sm">
									<span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
									${pill}
								</span>`
							).join('');
						}

						if (panelBody && Array.isArray(data.paragraphs)) {
							panelBody.innerHTML = data.paragraphs.map((p, idx) => 
								`<div class="relative p-5 rounded-2xl bg-white/[0.025] hover:bg-white/[0.04] border border-white/10 hover:border-cyan-400/40 transition-all duration-300 shadow-sm group overflow-hidden ${data.paragraphs.length === 1 ? 'md:col-span-2' : ''}">
									<div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-cyan-400 to-blue-500 rounded-l opacity-80 group-hover:opacity-100 transition-opacity"></div>
									<div class="text-xs font-mono text-cyan-400/70 uppercase mb-2">SPECS PART 0${idx+1}</div>
									<p class="text-neutral-200 text-sm sm:text-base leading-relaxed font-light select-text pl-1">${p}</p>
								</div>`
							).join('');
						}

						// Update Tab Buttons UI
						panelTabBtns.forEach(btn => {
							const tab = btn.getAttribute('data-panel-tab');
							const dot = btn.querySelector('span');
							if (tab === key) {
								btn.className = 'panel-tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-300 flex items-center gap-2 cursor-pointer bg-cyan-500/25 border border-cyan-400 text-cyan-300 shadow-md';
								if (dot) dot.className = 'w-2 h-2 rounded-full bg-cyan-400 animate-pulse';
							} else {
								btn.className = 'panel-tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-300 flex items-center gap-2 cursor-pointer text-neutral-400 hover:text-white hover:bg-white/5 border border-transparent';
								if (dot) dot.className = 'w-2 h-2 rounded-full bg-neutral-600';
							}
						});

						// Update Card Highlight UI
						deliveryCards.forEach(card => {
							const cardApproach = card.getAttribute('data-delivery-card');
							const btnText = card.querySelector('.btn-text');
							if (cardApproach === key) {
								card.classList.add('border-cyan-400/80', 'shadow-[0_0_30px_rgba(34,211,238,0.15)]');
								if (btnText) btnText.textContent = 'Active Approach';
							} else {
								card.classList.remove('border-cyan-400/80', 'shadow-[0_0_30px_rgba(34,211,238,0.15)]');
								if (btnText) btnText.textContent = 'Read More';
							}
						});
					}

					// Show Detail Panel
					function openDetailPanel(key) {
						renderDetailPanel(key);
						if (detailPanel) {
							detailPanel.classList.remove('hidden');
							detailPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
						}
					}

					// Hide Detail Panel
					function closeDetailPanel() {
						if (detailPanel) {
							detailPanel.classList.add('hidden');
						}
						deliveryCards.forEach(card => {
							card.classList.remove('border-cyan-400/80', 'shadow-[0_0_30px_rgba(34,211,238,0.15)]');
							const btnText = card.querySelector('.btn-text');
							if (btnText) btnText.textContent = 'Read More';
						});
					}

					// Open Backdrop Modal
					function openModal(key) {
						const data = modalData[key];
						if (!data || !modal) return;

						if (modalTitle) modalTitle.textContent = data.title;
						if (modalBadge) modalBadge.textContent = data.badge;
						if (modalIconContainer && data.icon) modalIconContainer.innerHTML = data.icon;

						if (modalPills && Array.isArray(data.pills)) {
							modalPills.innerHTML = data.pills.map(pill => 
								`<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-cyan-950/60 border border-cyan-500/30 text-cyan-200 text-xs font-mono shadow-sm">
									<span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
									${pill}
								</span>`
							).join('');
						}

						if (modalBody && Array.isArray(data.paragraphs)) {
							modalBody.innerHTML = data.paragraphs.map(p => 
								`<div class="relative p-5 rounded-2xl bg-white/[0.025] hover:bg-white/[0.04] border border-white/10 hover:border-cyan-400/40 transition-all duration-300 shadow-sm group overflow-hidden">
									<div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-cyan-400 to-blue-500 rounded-l opacity-70 group-hover:opacity-100 transition-opacity"></div>
									<p class="text-neutral-200 text-sm sm:text-base leading-relaxed font-light select-text pl-2">${p}</p>
								</div>`
							).join('');
						}

						modal.classList.remove('opacity-0', 'pointer-events-none');
						const innerBox = modal.querySelector('.transform');
						if (innerBox) {
							innerBox.classList.remove('scale-95');
							innerBox.classList.add('scale-100');
						}
						document.body.classList.add('overflow-hidden');
					}

					function closeModal() {
						if (!modal) return;
						const innerBox = modal.querySelector('.transform');
						if (innerBox) {
							innerBox.classList.remove('scale-100');
							innerBox.classList.add('scale-95');
						}
						modal.classList.add('opacity-0', 'pointer-events-none');
						document.body.classList.remove('overflow-hidden');
					}

					// Event Listeners for Cards & Buttons
					readMoreButtons.forEach(btn => {
						btn.addEventListener('click', (e) => {
							e.stopPropagation();
							const target = btn.getAttribute('data-modal-target');
							if (target) openDetailPanel(target);
						});
					});

					deliveryCards.forEach(card => {
						card.addEventListener('click', () => {
							const target = card.getAttribute('data-delivery-card');
							if (target) openDetailPanel(target);
						});
					});

					panelTabBtns.forEach(btn => {
						btn.addEventListener('click', () => {
							const tab = btn.getAttribute('data-panel-tab');
							if (tab) renderDetailPanel(tab);
						});
					});

					if (panelCloseBtn) panelCloseBtn.addEventListener('click', closeDetailPanel);
					if (openModalFromPanelBtn) openModalFromPanelBtn.addEventListener('click', () => openModal(currentKey));

					if (modalClose) modalClose.addEventListener('click', closeModal);
					if (modalOverlay) modalOverlay.addEventListener('click', closeModal);
					if (modal) {
						modal.addEventListener('click', (e) => {
							if (e.target === modal || e.target === modalOverlay) {
								closeModal();
							}
						});
					}

					document.addEventListener('keydown', (e) => {
						if (e.key === 'Escape') {
							if (modal && !modal.classList.contains('opacity-0')) {
								closeModal();
							} else if (detailPanel && !detailPanel.classList.contains('hidden')) {
								closeDetailPanel();
							}
						}
					});
				});
