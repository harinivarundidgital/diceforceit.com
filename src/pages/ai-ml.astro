					const activeNumClasses = "methodology-step-num font-mono text-sm sm:text-base font-bold text-cyan-400 transition-colors";
					const inactiveNumClasses = "methodology-step-num font-mono text-sm sm:text-base font-bold text-neutral-500 group-hover:text-cyan-400 transition-colors";

					const activeTitleClasses = "methodology-step-title font-syne font-bold text-base sm:text-lg text-white group-hover:text-cyan-300 transition-colors whitespace-nowrap";
					const inactiveTitleClasses = "methodology-step-title font-syne font-bold text-base sm:text-lg text-neutral-400 group-hover:text-white transition-colors whitespace-nowrap";

					stepBtns.forEach(btn => {
						btn.addEventListener('click', () => {
							const targetStep = btn.getAttribute('data-step');
							if (!targetStep) return;

							// Update buttons
							stepBtns.forEach(b => {
								const bStep = b.getAttribute('data-step');
								const isTarget = bStep === targetStep;
								b.setAttribute('aria-selected', isTarget ? 'true' : 'false');
								const numSpan = b.querySelector('.methodology-step-num');
								const titleSpan = b.querySelector('.methodology-step-title');

								if (isTarget) {
									if (numSpan) numSpan.className = activeNumClasses;
									if (titleSpan) titleSpan.className = activeTitleClasses;
								} else {
									if (numSpan) numSpan.className = inactiveNumClasses;
									if (titleSpan) titleSpan.className = inactiveTitleClasses;
								}
							});

							// Update content cards
							stepContents.forEach(content => {
								if (content.id === `methodology-content-${targetStep}`) {
									content.classList.remove('hidden', 'opacity-0');
									content.classList.add('block', 'opacity-100');
								} else {
									content.classList.remove('block', 'opacity-100');
