---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout 
	title="diceforce IT | AI & Machine Learning | Custom Cognitive Pipelines" 
	description="We engineer next-generation artificial intelligence infrastructure, fine-tune domain-specific models, and build robust neural architectures."
	activePage="ai-ml"
>
	<div class="max-w-6xl mx-auto w-full flex flex-col gap-16 md:gap-24">
		
		<!-- SECTION 1: HERO (2-Column Layout) -->
		<section class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center animate-stagger-item">
			<!-- Left Column: Hero Copy -->
			<div class="lg:col-span-7 space-y-6">
				<div class="inline-flex items-center gap-2 px-3 py-1 border border-cyan-500/20 rounded-full bg-cyan-950/10">
					<span class="font-mono text-xs tracking-widest text-cyan-400 uppercase">CORE SOLUTIONS</span>
				</div>
				<h1 class="font-syne font-black text-4xl sm:text-5xl md:text-6xl lg:text-7xl tracking-tighter leading-[0.95] text-white select-text text-balance">
					Cognitive systems.<br />
					Neural networks.
				</h1>
				<p class="text-neutral-400 font-light text-base sm:text-lg max-w-xl mt-6 leading-relaxed select-text">
					We design and deploy custom neural architectures, fine-tune models, and construct advanced vector retrieval pipelines to power next-generation agentic workflows.
				</p>
				<div class="pt-4 flex flex-wrap gap-4">
					<a href="#capabilities" class="px-6 py-3 bg-white text-black font-semibold rounded-full hover:bg-white/90 hover:scale-102 transition-all duration-300 text-xs tracking-wider uppercase whitespace-nowrap">
						Our Capabilities
					</a>
					<a href="/contact" class="px-6 py-3 border border-white/10 hover:border-white/30 text-white font-semibold rounded-full hover:bg-white/5 transition-all duration-300 text-xs tracking-wider uppercase whitespace-nowrap">
						Request Briefing
					</a>
				</div>
			</div>
			<!-- Right Column: Interactive 3D WebGL Particle System -->
			<div class="lg:col-span-5 relative w-full h-[350px] sm:h-[420px] lg:h-[480px] flex items-center justify-center overflow-hidden">
				<div class="absolute inset-0 bg-[#00deff]/[0.02] blur-[80px] rounded-full pointer-events-none"></div>
				<!-- Three.js Canvas Container -->
				<div id="canvas-container" class="w-full h-full cursor-grab active:cursor-grabbing relative z-10"></div>
			</div>
		</section>

		<!-- SECTION 2: AI & MACHINE LEARNING CAPABILITIES -->
		<section id="capabilities" class="border-t border-white/5 pt-16 scroll-mt-24 animate-stagger-item">
			<div class="space-y-4 mb-12">
				<div class="flex items-center gap-2">
					<span class="text-xs font-mono tracking-widest text-cyan-400/80 uppercase">01 COGNITIVE PIPELINES</span>
				</div>
				<h2 class="font-syne font-semibold text-2xl sm:text-3xl text-white tracking-tight leading-none select-text">
					AI & Machine Learning Engineering
				</h2>
				<p class="text-neutral-400 text-sm leading-relaxed max-w-2xl select-text font-light">
					We build robust, secure, and production-grade artificial intelligence systems. From optimization and fine-tuning to vector routing and agentic workflow loops.
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
				<!-- Capability Card 1 -->
				<div class="p-8 rounded-2xl border border-white/5 bg-white/[0.01] hover:border-cyan-500/20 hover:bg-white/[0.02] transition-all duration-300 flex flex-col justify-between min-h-[220px] group shadow-lg shadow-black/10">
					<div class="w-10 h-10 rounded-xl bg-cyan-400/5 text-cyan-400 border border-cyan-400/10 flex items-center justify-center group-hover:bg-cyan-400/10 group-hover:border-cyan-400/30 transition-all duration-300">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
						</svg>
					</div>
					<div class="mt-6">
						<h3 class="font-syne font-medium text-white text-lg mb-2 select-text">Model Fine-Tuning & Alignment</h3>
						<p class="text-neutral-400 text-xs leading-relaxed font-light select-text mb-4">
							We run SFT (Supervised Fine-Tuning) and DPO (Direct Preference Optimization) on leading open-weight foundations (Llama, Mistral, Qwen) to adapt them for specialized vertical applications and internal compliance guidelines.
						</p>
						<div class="flex flex-wrap gap-1.5">
							<span class="font-mono text-xs text-neutral-400 bg-white/5 border border-white/10 px-2 py-0.5 rounded">SFT/DPO</span>
							<span class="font-mono text-xs text-neutral-400 bg-white/5 border border-white/10 px-2 py-0.5 rounded">LoRA</span>
							<span class="font-mono text-xs text-neutral-400 bg-white/5 border border-white/10 px-2 py-0.5 rounded">Unsloth</span>
						</div>
					</div>
				</div>

				<!-- Capability Card 2 -->
				<div class="p-8 rounded-2xl border border-white/5 bg-white/[0.01] hover:border-cyan-500/20 hover:bg-white/[0.02] transition-all duration-300 flex flex-col justify-between min-h-[220px] group shadow-lg shadow-black/10">
					<div class="w-10 h-10 rounded-xl bg-blue-400/5 text-blue-400 border border-blue-400/10 flex items-center justify-center group-hover:bg-blue-400/10 group-hover:border-blue-400/30 transition-all duration-300">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
						</svg>
					</div>
					<div class="mt-6">
						<h3 class="font-syne font-medium text-white text-lg mb-2 select-text">GPU Cluster & Serving Infra</h3>
						<p class="text-neutral-400 text-xs leading-relaxed font-light select-text mb-4">
							Deploy model architectures at scale. We design low-latency serving stacks utilizing vLLM, Triton, and TensorRT pipelines with autoscaling triggers tied directly to token utilization and request queues.
						</p>
						<div class="flex flex-wrap gap-1.5">
							<span class="font-mono text-xs text-neutral-400 bg-white/5 border border-white/10 px-2 py-0.5 rounded">vLLM</span>
							<span class="font-mono text-xs text-neutral-400 bg-white/5 border border-white/10 px-2 py-0.5 rounded">Triton</span>
							<span class="font-mono text-xs text-neutral-400 bg-white/5 border border-white/10 px-2 py-0.5 rounded">Kubernetes</span>
						</div>
					</div>
				</div>

				<!-- Capability Card 3 -->
				<div class="p-8 rounded-2xl border border-white/5 bg-white/[0.01] hover:border-cyan-500/20 hover:bg-white/[0.02] transition-all duration-300 flex flex-col justify-between min-h-[220px] group shadow-lg shadow-black/10">
					<div class="w-10 h-10 rounded-xl bg-purple-400/5 text-purple-400 border border-purple-400/10 flex items-center justify-center group-hover:bg-purple-400/10 group-hover:border-purple-400/30 transition-all duration-300">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
						</svg>
					</div>
					<div class="mt-6">
						<h3 class="font-syne font-medium text-white text-lg mb-2 select-text">Advanced Vector Search & RAG</h3>
						<p class="text-neutral-400 text-xs leading-relaxed font-light select-text mb-4">
							Build clean knowledge pipelines. We implement enterprise RAG systems with hybrid keyword-vector search, semantic re-ranking (Cohere, BGE), and partition schemes for multi-tenant data access control.
						</p>
						<div class="flex flex-wrap gap-1.5">
							<span class="font-mono text-xs text-neutral-400 bg-white/5 border border-white/10 px-2 py-0.5 rounded">Qdrant</span>
							<span class="font-mono text-xs text-neutral-400 bg-white/5 border border-white/10 px-2 py-0.5 rounded">pgvector</span>
							<span class="font-mono text-xs text-neutral-400 bg-white/5 border border-white/10 px-2 py-0.5 rounded">Semantic Router</span>
						</div>
					</div>
				</div>

				<!-- Capability Card 4 -->
				<div class="p-8 rounded-2xl border border-white/5 bg-white/[0.01] hover:border-cyan-500/20 hover:bg-white/[0.02] transition-all duration-300 flex flex-col justify-between min-h-[220px] group shadow-lg shadow-black/10">
					<div class="w-10 h-10 rounded-xl bg-indigo-400/5 text-indigo-400 border border-indigo-400/10 flex items-center justify-center group-hover:bg-indigo-400/10 group-hover:border-indigo-400/30 transition-all duration-300">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
						</svg>
					</div>
					<div class="mt-6">
						<h3 class="font-syne font-medium text-white text-lg mb-2 select-text">Agentic Decision Systems</h3>
						<p class="text-neutral-400 text-xs leading-relaxed font-light select-text mb-4">
							Transition from static prompts to dynamic agents. We write state-management systems that allow agent networks to self-correct, interface with local browsers or terminal APIs, and run continuous data loops.
						</p>
						<div class="flex flex-wrap gap-1.5">
							<span class="font-mono text-xs text-neutral-400 bg-white/5 border border-white/10 px-2 py-0.5 rounded">LangGraph</span>
							<span class="font-mono text-xs text-neutral-400 bg-white/5 border border-white/10 px-2 py-0.5 rounded">Tool Use</span>
							<span class="font-mono text-xs text-neutral-400 bg-white/5 border border-white/10 px-2 py-0.5 rounded">State Loops</span>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- SECTION 3: BRIEFING CALLOUT -->
		<section class="border-t border-white/5 pt-16 pb-20 animate-stagger-item">
			<div class="relative bg-neutral-950/40 backdrop-blur-xl border border-white/10 rounded-3xl p-8 sm:p-12 md:p-16 flex flex-col md:flex-row items-center justify-between gap-8 relative overflow-hidden group/cta">
				<!-- Decor -->
				<div class="absolute -top-40 -left-40 w-96 h-96 bg-[#00deff]/10 rounded-full blur-[80px] pointer-events-none group-hover/cta:bg-[#00deff]/12 transition-all duration-500"></div>
				<div class="absolute -bottom-40 -right-40 w-96 h-96 bg-[#883ae2]/10 rounded-full blur-[80px] pointer-events-none group-hover/cta:bg-[#883ae2]/12 transition-all duration-500"></div>
				
				<div class="space-y-4 max-w-xl relative z-10">
					<div class="inline-flex items-center gap-2 px-3 py-1 border border-white/5 rounded-full bg-white/[0.01]">
						<span class="font-mono text-xs tracking-widest text-cyan-400 uppercase">SYSTEM DIAGNOSTICS</span>
					</div>
					<h2 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-white tracking-tight leading-tight font-syne select-text">
						Start your AI transformation.
					</h2>
					<p class="text-white/40 text-xs sm:text-sm font-light leading-relaxed select-text">
						Discuss custom pipelines, model integration limits, or specialized AI deployment. Let's design the custom cognitive infrastructure your company deserves.
					</p>
				</div>
				<a href="/contact" class="relative z-10 px-8 py-3.5 bg-white text-black font-semibold rounded-full hover:bg-white/90 hover:scale-102 transition-all duration-300 text-xs tracking-wider uppercase whitespace-nowrap">
					Request Briefing Call
				</a>
			</div>
		</section>

	</div>

	<!-- Interactive Script -->
	<script>
		import * as THREE from 'three';
		import { gsap } from 'gsap';

		// DOM Selectors
		const canvasContainer = document.getElementById('canvas-container');
		const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		// Three.js Interactive Particle SVG Image System
		let scene: THREE.Scene, 
			camera: THREE.PerspectiveCamera, 
			renderer: THREE.WebGLRenderer,
			geometry: THREE.BufferGeometry,
			points: THREE.Points,
			currentScale = 1.0;
		
		function initThree() {
			if (!canvasContainer) return;
			
			// Load SVG image as textures/particles
			const img = new Image();
			img.crossOrigin = "anonymous";
			img.src = '/Services-image.svg';
			
			img.onload = () => {
				const sampleCanvas = document.createElement('canvas');
				const sWidth = 180;
				const sHeight = 180;
				
				sampleCanvas.width = sWidth;
				sampleCanvas.height = sHeight;
				const sCtx = sampleCanvas.getContext('2d');
				if (!sCtx) return;
				
				sCtx.drawImage(img, 0, 0, sWidth, sHeight);
				const imgData = sCtx.getImageData(0, 0, sWidth, sHeight);
				const data = imgData.data;
				
				const rawParticles = [];
				
				for (let y = 0; y < sHeight; y++) {
					for (let x = 0; x < sWidth; x++) {
						const idx = (y * sWidth + x) * 4;
						const r = data[idx];
						const g = data[idx + 1];
						const b = data[idx + 2];
						const a = data[idx + 3];
						
						if (a > 60) {
							const px = ((x / sWidth) - 0.5) * 5.0;
							const py = -((y / sHeight) - 0.5) * 5.0;
							const pz = (Math.random() - 0.5) * 0.12;
							
							rawParticles.push({
								x: px,
								y: py,
								z: pz,
								r: r / 255,
								g: g / 255,
								b: b / 255
							});
						}
					}
				}
				
				const maxParticles = 3000;
				let particlesList = [];
				if (rawParticles.length > maxParticles) {
					const rawCount = rawParticles.length;
					for (let i = 0; i < maxParticles; i++) {
						const index = Math.floor((i / (maxParticles - 1)) * (rawCount - 1));
						particlesList.push(rawParticles[index]);
					}
				} else {
					particlesList = rawParticles;
				}
				
				setupParticleSystem(particlesList);
			};
		}

		function setupParticleSystem(particlesList: any[]) {
			if (!canvasContainer) return;
			const width = canvasContainer.clientWidth;
			const height = canvasContainer.clientHeight || 350;
			
			scene = new THREE.Scene();
			
			camera = new THREE.PerspectiveCamera(60, width / height, 0.1, 100);
			camera.position.z = 4.8;
			
			renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
			renderer.setSize(width, height);
			renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
			renderer.domElement.style.display = 'block';
			canvasContainer.appendChild(renderer.domElement);
			
			const count = particlesList.length;
			const positions = new Float32Array(count * 3);
			const colors = new Float32Array(count * 3);
			const originalPositions = new Float32Array(count * 3);
			const velocities = new Float32Array(count * 3);
			
			for (let i = 0; i < count; i++) {
				const p = particlesList[i];
				const i3 = i * 3;
				
				originalPositions[i3] = p.x;
				originalPositions[i3 + 1] = p.y;
				originalPositions[i3 + 2] = p.z;
				
				positions[i3] = p.x + (Math.random() - 0.5) * 12;
				positions[i3 + 1] = p.y + (Math.random() - 0.5) * 12;
				positions[i3 + 2] = p.z + (Math.random() - 0.5) * 12;
				
				colors[i3] = p.r;
				colors[i3 + 1] = p.g;
				colors[i3 + 2] = p.b;
				
				velocities[i3] = 0;
				velocities[i3 + 1] = 0;
				velocities[i3 + 2] = 0;
			}
			
			geometry = new THREE.BufferGeometry();
			geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
			geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));
			
			const canvas = document.createElement('canvas');
			canvas.width = 32;
			canvas.height = 32;
			const ctx = canvas.getContext('2d');
			if (ctx) {
				const gradient = ctx.createRadialGradient(16, 16, 0, 16, 16, 16);
				gradient.addColorStop(0, 'rgba(255, 255, 255, 1)');
				gradient.addColorStop(0.25, 'rgba(255, 255, 255, 0.7)');
				gradient.addColorStop(0.6, 'rgba(255, 255, 255, 0.15)');
				gradient.addColorStop(1, 'rgba(255, 255, 255, 0)');
				ctx.fillStyle = gradient;
				ctx.fillRect(0, 0, 32, 32);
			}
			const texture = new THREE.CanvasTexture(canvas);
			
			const material = new THREE.PointsMaterial({
				size: 0.085,
				map: texture,
				transparent: true,
				opacity: 0.9,
				blending: THREE.AdditiveBlending,
				depthWrite: false,
				vertexColors: true
			});
			
			points = new THREE.Points(geometry, material);
			scene.add(points);
			
			function adjustScale() {
				if (!points || !canvasContainer) return;
				const w = canvasContainer.clientWidth;
				const h = canvasContainer.clientHeight || 350;
				const aspect = w / h;
				
				if (aspect < 1.0) {
					currentScale = aspect * 0.95;
				} else {
					currentScale = 1.05;
				}
				points.scale.set(currentScale, currentScale, currentScale);
			}
			
			adjustScale();
			
			const mouse = new THREE.Vector2(-9999, -9999);
			const mouse3D = new THREE.Vector3(-9999, -9999, 0);
			const plane = new THREE.Plane(new THREE.Vector3(0, 0, 1), 0);
			const raycaster = new THREE.Raycaster();
			
			function updateMousePosition(clientX: number, clientY: number) {
				if (!canvasContainer) return;
				const rect = canvasContainer.getBoundingClientRect();
				const x = ((clientX - rect.left) / rect.width) * 2 - 1;
				const y = -((clientY - rect.top) / rect.height) * 2 + 1;
				mouse.set(x, y);
				
				raycaster.setFromCamera(mouse, camera);
				raycaster.ray.intersectPlane(plane, mouse3D);
			}
			
			function handleMove(e: MouseEvent) {
				updateMousePosition(e.clientX, e.clientY);
			}
			
			function handleLeave() {
				mouse.set(-9999, -9999);
				mouse3D.set(-9999, -9999, 0);
			}
			
			function handleTouch(e: TouchEvent) {
				if (e.touches.length > 0) {
					updateMousePosition(e.touches[0].clientX, e.touches[0].clientY);
				}
			}
			
			canvasContainer.addEventListener('mousemove', handleMove);
			canvasContainer.addEventListener('mouseleave', handleLeave);
			canvasContainer.addEventListener('touchmove', handleTouch);
			canvasContainer.addEventListener('touchend', handleLeave);
			
			const clock = new THREE.Clock();
			
			function animate() {
				requestAnimationFrame(animate);
				
				const delta = Math.min(clock.getDelta(), 0.1);
				const elapsed = clock.getElapsedTime();

				if (points && !prefersReduced) {
					points.rotation.y = Math.sin(elapsed * 0.12) * 0.15;
					points.rotation.x = Math.cos(elapsed * 0.08) * 0.08;
				}

				const positionsAttr = geometry.attributes.position;
				const posArray = positionsAttr.array as Float32Array;
				
				const mouseRadius = 0.95;
				const mousePush = 3.5;
				const springForce = 5.2;
				const damping = 0.83;
				
				for (let i = 0; i < count; i++) {
					const idx = i * 3;
					
					let x = posArray[idx];
					let y = posArray[idx + 1];
					let z = posArray[idx + 2];
					
					const ox = originalPositions[idx];
					const oy = originalPositions[idx + 1];
					const oz = originalPositions[idx + 2];
					
					let vx = velocities[idx];
					let vy = velocities[idx + 1];
					let vz = velocities[idx + 2];
					
					if (mouse.x > -1000 && !prefersReduced) {
						const localMouseX = mouse3D.x / currentScale;
						const localMouseY = mouse3D.y / currentScale;
						const localMouseZ = mouse3D.z / currentScale;
						
						const dx = x - localMouseX;
						const dy = y - localMouseY;
						const dz = z - localMouseZ;
						const dist = Math.sqrt(dx*dx + dy*dy + dz*dz);
						
						if (dist < mouseRadius) {
							const pushStrength = (1.0 - dist / mouseRadius) * mousePush;
							const angleX = dist > 0 ? dx / dist : (Math.random() - 0.5);
							const angleY = dist > 0 ? dy / dist : (Math.random() - 0.5);
							const angleZ = dist > 0 ? dz / dist : (Math.random() - 0.5);
							
							vx += angleX * pushStrength * delta;
							vy += angleY * pushStrength * delta;
							vz += angleZ * pushStrength * delta;
						}
					}
					
					const sx = (ox - x) * springForce;
					const sy = (oy - y) * springForce;
					const sz = (oz - z) * springForce;
					
					vx += sx * delta;
					vy += sy * delta;
					vz += sz * delta;
					
					vx *= damping;
					vy *= damping;
					vz *= damping;
					
					x += vx;
					y += vy;
					z += vz;
					
					posArray[idx] = x;
					posArray[idx + 1] = y;
					posArray[idx + 2] = z;
					
					velocities[idx] = vx;
					velocities[idx + 1] = vy;
					velocities[idx + 2] = vz;
				}
				
				positionsAttr.needsUpdate = true;
				renderer.render(scene, camera);
			}
			
			animate();
			
			window.addEventListener('resize', () => {
				if (!canvasContainer || !renderer || !camera) return;
				const w = canvasContainer.clientWidth;
				const h = canvasContainer.clientHeight || 350;
				
				camera.aspect = w / h;
				camera.updateProjectionMatrix();
				renderer.setSize(w, h);
				
				adjustScale();
			});
		}

		initThree();
	</script>
</PageLayout>
