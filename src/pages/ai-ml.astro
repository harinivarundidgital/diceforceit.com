---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout 
	title="diceforce IT | AI & Machine Learning | Custom Cognitive Pipelines" 
	description="We engineer next-generation artificial intelligence infrastructure, fine-tune domain-specific models, and build robust neural architectures."
	activePage="ai-ml"
>
	<div class="max-w-6xl mx-auto w-full flex flex-col gap-16 md:gap-24">
		
		<!-- SECTION 1: HERO (2-Column Layout) -->
		<section class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center animate-stagger-item">
			<!-- Left Column: Hero Copy -->
			<div class="lg:col-span-7 space-y-6">
				<div class="inline-flex items-center gap-2 px-3.5 py-1 border border-cyan-500/25 rounded-full bg-cyan-950/30 backdrop-blur-md">
					<span class="font-mono text-xs tracking-widest text-cyan-300 uppercase font-semibold">AI &amp; ML Services</span>
				</div>
				<h1 class="font-syne font-black text-3xl sm:text-4xl md:text-5xl lg:text-6xl tracking-tight leading-[1.05] text-white select-text text-balance">
					Engineering Cognitive Systems. <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-neutral-200 to-cyan-300">Built Around Your Business.</span>
				</h1>
				<p class="text-neutral-300 font-light text-base sm:text-lg max-w-xl mt-6 leading-relaxed select-text">
					We help you reimagine your dream business, moving beyond digital lens to engineering intelligence. Whether you're building your next AI product or accelerating innovation, we can become your perfect AI/ML services partner.
				</p>
				<div class="pt-4 flex flex-wrap gap-4">
					<a href="#capabilities" class="px-6 py-3.5 bg-white text-black font-semibold rounded-full hover:bg-white/90 hover:scale-102 transition-all duration-300 text-xs tracking-wider uppercase whitespace-nowrap shadow-lg shadow-white/10">
						Explore Our AI Engineering Expertise
					</a>
					<a href="/contact" class="px-6 py-3.5 border border-white/20 hover:border-cyan-400/50 text-white font-semibold rounded-full hover:bg-cyan-950/30 transition-all duration-300 text-xs tracking-wider uppercase whitespace-nowrap">
						Let’s Build Together
					</a>
				</div>
			</div>
			<!-- Right Column: Interactive 3D WebGL Particle System -->
			<div class="lg:col-span-5 relative w-full h-[350px] sm:h-[420px] lg:h-[480px] flex items-center justify-center overflow-hidden">
				<div class="absolute inset-0 bg-[#00deff]/[0.02] blur-[80px] rounded-full pointer-events-none"></div>
				<!-- Three.js Canvas Container -->
				<div id="canvas-container" class="w-full h-full cursor-grab active:cursor-grabbing relative z-10"></div>
			</div>
		</section>

		<!-- SECTION 2: AGENTIC AI & INTELLIGENT ENTERPRISE SOLUTIONS -->
		<section id="capabilities" class="pt-16 scroll-mt-24 animate-stagger-item">
			<!-- Section Header (2-Column) -->
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-16 items-end">
				<div class="lg:col-span-7 space-y-4">
					<div class="inline-flex items-center gap-2 px-3.5 py-1 border border-cyan-500/25 rounded-full bg-cyan-950/30 backdrop-blur-md">
						<span class="font-mono text-xs tracking-widest text-cyan-300 uppercase font-semibold">OUR PRIMARY FOCUS</span>
					</div>
					<h2 class="font-syne font-extrabold text-3xl sm:text-4xl lg:text-5xl text-white tracking-tight leading-[1.08] select-text">
						Agentic AI &amp; Intelligent Enterprise Solutions
					</h2>
				</div>
				<div class="lg:col-span-5 space-y-3">
					<p class="text-neutral-200 text-sm sm:text-base leading-relaxed select-text font-light">
						We build intelligent systems that connect conversations, enterprise applications, structured data and unstructured knowledge.
					</p>
					<p class="text-neutral-400 text-xs sm:text-sm leading-relaxed select-text font-light">
						These systems are designed to interpret intent, resolve ambiguity, retrieve supporting evidence, coordinate specialized agents and convert approved recommendations into meaningful business actions.
					</p>
				</div>
			</div>

			<!-- 8-Card Grid (3-Column Layout with Animated SVG Schematics) -->
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
				
				<!-- CARD 01 -->
				<div class="relative p-8 rounded-2xl border border-white/10 bg-[#080c16]/95 backdrop-blur-xl hover:border-cyan-400/50 hover:bg-[#0c1222] hover:-translate-y-2 transition-all duration-500 group shadow-xl hover:shadow-2xl hover:shadow-cyan-500/10 flex flex-col justify-between overflow-hidden min-h-[460px]">
					<div class="absolute -top-24 -right-24 w-48 h-48 bg-cyan-500/0 group-hover:bg-cyan-500/15 rounded-full blur-3xl transition-all duration-700 pointer-events-none"></div>
					<div class="absolute -bottom-24 -left-24 w-48 h-48 bg-indigo-500/0 group-hover:bg-indigo-500/10 rounded-full blur-3xl transition-all duration-700 pointer-events-none"></div>
					
					<div>
						<div class="flex items-center justify-between mb-6">
							<span class="font-mono text-sm font-semibold text-neutral-400 group-hover:text-cyan-400 transition-colors">01</span>
							<span class="w-2 h-2 rounded-full bg-cyan-400/30 group-hover:bg-cyan-400 group-hover:animate-ping transition-all"></span>
						</div>
						<!-- Moving Graphic: Continuous Packet Transmission -->
						<div class="h-16 w-full flex items-center mb-6 overflow-hidden">
							<svg class="w-full h-11 text-cyan-400 group-hover:scale-105 transition-transform duration-500" viewBox="0 0 200 40" fill="none" stroke="currentColor">
								<line x1="10" y1="20" x2="190" y2="20" stroke="rgba(255,255,255,0.15)" stroke-width="1"/>
								<rect x="25" y="14" width="12" height="12" rx="2" fill="#22d3ee" fill-opacity="0.9"/>
								<rect x="55" y="12" width="18" height="16" rx="2" stroke="#22d3ee" stroke-width="1.5" fill="none" class="group-hover:stroke-white transition-colors"/>
								<rect x="95" y="14" width="24" height="12" rx="2" stroke="#22d3ee" stroke-width="1.5" fill="none"/>
								<rect x="135" y="12" width="30" height="16" rx="2" stroke="#22d3ee" stroke-width="1.5" fill="none"/>
								<!-- Traveling Packet Beam -->
								<circle cx="20" cy="20" r="3.5" fill="#00deff" class="animate-pulse">
									<animate attributeName="cx" values="10;190;10" dur="4s" repeatCount="indefinite"/>
								</circle>
								<circle cx="20" cy="20" r="2" fill="#ffffff">
									<animate attributeName="cx" values="10;190;10" dur="4s" repeatCount="indefinite"/>
								</circle>
							</svg>
						</div>
						<h3 class="font-syne font-bold text-white text-xl sm:text-2xl mb-3 select-text group-hover:text-cyan-300 transition-colors leading-snug">
							Conversational Intelligence
						</h3>
						<p class="text-neutral-300 text-sm leading-relaxed font-light select-text mb-8">
							Natural-language experiences across websites, mobile applications, internal platforms and enterprise collaboration environments.
						</p>
					</div>

					<div class="pt-6 border-t border-white/10 space-y-3.5 relative z-10">
						<div class="grid grid-cols-[105px_1fr] sm:grid-cols-[115px_1fr] items-start gap-2.5">
							<span class="font-mono text-[10px] sm:text-[11px] tracking-wider text-cyan-400 font-semibold uppercase pt-0.5">UNDERSTANDS</span>
							<span class="text-neutral-200 font-light text-xs sm:text-[13px] leading-relaxed select-text">Intent, language and conversational context</span>
						</div>
						<div class="grid grid-cols-[105px_1fr] sm:grid-cols-[115px_1fr] items-start gap-2.5">
							<span class="font-mono text-[10px] sm:text-[11px] tracking-wider text-cyan-400 font-semibold uppercase pt-0.5">USES</span>
							<span class="text-neutral-200 font-light text-xs sm:text-[13px] leading-relaxed select-text">Approved knowledge, applications and interaction history</span>
						</div>
						<div class="grid grid-cols-[105px_1fr] sm:grid-cols-[115px_1fr] items-start gap-2.5">
							<span class="font-mono text-[10px] sm:text-[11px] tracking-wider text-cyan-400 font-semibold uppercase pt-0.5">SUPPORTS</span>
							<span class="text-neutral-200 font-light text-xs sm:text-[13px] leading-relaxed select-text">Faster, more intuitive access to enterprise services</span>
						</div>
					</div>
				</div>

				<!-- CARD 02 -->
				<div class="relative p-8 rounded-2xl border border-white/10 bg-[#080c16]/95 backdrop-blur-xl hover:border-cyan-400/50 hover:bg-[#0c1222] hover:-translate-y-2 transition-all duration-500 group shadow-xl hover:shadow-2xl hover:shadow-cyan-500/10 flex flex-col justify-between overflow-hidden min-h-[460px]">
					<div class="absolute -top-24 -right-24 w-48 h-48 bg-cyan-500/0 group-hover:bg-cyan-500/15 rounded-full blur-3xl transition-all duration-700 pointer-events-none"></div>
					<div class="absolute -bottom-24 -left-24 w-48 h-48 bg-indigo-500/0 group-hover:bg-indigo-500/10 rounded-full blur-3xl transition-all duration-700 pointer-events-none"></div>
					
					<div>
						<div class="flex items-center justify-between mb-6">
							<span class="font-mono text-sm font-semibold text-neutral-400 group-hover:text-cyan-400 transition-colors">02</span>
							<span class="w-2 h-2 rounded-full bg-cyan-400/30 group-hover:bg-cyan-400 group-hover:animate-ping transition-all"></span>
						</div>
						<!-- Moving Graphic: Floating Network Nodes & Traveling Signal -->
						<div class="h-16 w-full flex items-center mb-6 overflow-hidden">
							<svg class="w-full h-11 text-cyan-400 group-hover:scale-105 transition-transform duration-500" viewBox="0 0 200 40" fill="none" stroke="currentColor">
								<line x1="30" y1="20" x2="90" y2="10" stroke="#22d3ee" stroke-opacity="0.7" stroke-width="1.5"/>
								<line x1="30" y1="20" x2="90" y2="30" stroke="#22d3ee" stroke-opacity="0.7" stroke-width="1.5"/>
								<line x1="90" y1="10" x2="150" y2="20" stroke="#22d3ee" stroke-opacity="0.7" stroke-width="1.5"/>
								<line x1="90" y1="30" x2="150" y2="20" stroke="#22d3ee" stroke-opacity="0.7" stroke-width="1.5"/>
								<circle cx="30" cy="20" r="5" fill="#080c16" stroke="#22d3ee" stroke-width="2">
									<animate attributeName="cy" values="18;22;18" dur="3s" repeatCount="indefinite"/>
								</circle>
								<circle cx="90" cy="10" r="4" fill="#22d3ee">
									<animate attributeName="cy" values="8;12;8" dur="2.5s" repeatCount="indefinite"/>
								</circle>
								<circle cx="90" cy="30" r="4" fill="#22d3ee">
									<animate attributeName="cy" values="32;28;32" dur="2.5s" repeatCount="indefinite"/>
								</circle>
								<circle cx="150" cy="20" r="5" fill="#080c16" stroke="#22d3ee" stroke-width="2">
									<animate attributeName="cy" values="22;18;22" dur="3.2s" repeatCount="indefinite"/>
								</circle>
								<!-- Traveling Signal Packet -->
								<circle cx="30" cy="20" r="2.5" fill="#ffffff">
									<animate attributeName="cx" values="30;90;150;90;30" dur="4s" repeatCount="indefinite"/>
									<animate attributeName="cy" values="20;10;20;30;20" dur="4s" repeatCount="indefinite"/>
								</circle>
							</svg>
						</div>
						<h3 class="font-syne font-bold text-white text-xl sm:text-2xl mb-3 select-text group-hover:text-cyan-300 transition-colors leading-snug">
							Autonomous Agents
						</h3>
						<p class="text-neutral-300 text-sm leading-relaxed font-light select-text mb-8">
							Background agents that monitor information, identify events, coordinate workflows and operate within defined business controls.
						</p>
					</div>

					<div class="pt-6 border-t border-white/10 space-y-3.5 relative z-10">
						<div class="grid grid-cols-[105px_1fr] sm:grid-cols-[115px_1fr] items-start gap-2.5">
							<span class="font-mono text-[10px] sm:text-[11px] tracking-wider text-cyan-400 font-semibold uppercase pt-0.5">UNDERSTANDS</span>
							<span class="text-neutral-200 font-light text-xs sm:text-[13px] leading-relaxed select-text">Events, thresholds and operational conditions</span>
						</div>
						<div class="grid grid-cols-[105px_1fr] sm:grid-cols-[115px_1fr] items-start gap-2.5">
							<span class="font-mono text-[10px] sm:text-[11px] tracking-wider text-cyan-400 font-semibold uppercase pt-0.5">USES</span>
							<span class="text-neutral-200 font-light text-xs sm:text-[13px] leading-relaxed select-text">Connected systems, policies and workflow state</span>
						</div>
						<div class="grid grid-cols-[105px_1fr] sm:grid-cols-[115px_1fr] items-start gap-2.5">
							<span class="font-mono text-[10px] sm:text-[11px] tracking-wider text-cyan-400 font-semibold uppercase pt-0.5">SUPPORTS</span>
							<span class="text-neutral-200 font-light text-xs sm:text-[13px] leading-relaxed select-text">Timely, controlled operational response</span>
						</div>
					</div>
				</div>

				<!-- CARD 03 -->
				<div class="relative p-8 rounded-2xl border border-white/10 bg-[#080c16]/95 backdrop-blur-xl hover:border-cyan-400/50 hover:bg-[#0c1222] hover:-translate-y-2 transition-all duration-500 group shadow-xl hover:shadow-2xl hover:shadow-cyan-500/10 flex flex-col justify-between overflow-hidden min-h-[460px]">
					<div class="absolute -top-24 -right-24 w-48 h-48 bg-cyan-500/0 group-hover:bg-cyan-500/15 rounded-full blur-3xl transition-all duration-700 pointer-events-none"></div>
					<div class="absolute -bottom-24 -left-24 w-48 h-48 bg-indigo-500/0 group-hover:bg-indigo-500/10 rounded-full blur-3xl transition-all duration-700 pointer-events-none"></div>
					
					<div>
						<div class="flex items-center justify-between mb-6">
							<span class="font-mono text-sm font-semibold text-neutral-400 group-hover:text-cyan-400 transition-colors">03</span>
							<span class="w-2 h-2 rounded-full bg-cyan-400/30 group-hover:bg-cyan-400 group-hover:animate-ping transition-all"></span>
						</div>
						<!-- Moving Graphic: Continuous Rotating Radar & Orbit Nodes -->
						<div class="h-16 w-full flex items-center justify-center mb-6 overflow-hidden">
							<svg class="w-32 h-12 text-cyan-400 group-hover:scale-105 transition-transform duration-500" viewBox="0 0 100 40" fill="none">
								<circle cx="50" cy="20" r="16" stroke="rgba(255,255,255,0.2)" stroke-width="1"/>
								<circle cx="50" cy="20" r="10" stroke="#22d3ee" stroke-width="1.5" stroke-dasharray="4 4" class="animate-spin-slow origin-center"/>
								<circle cx="50" cy="20" r="4" fill="#22d3ee" class="animate-pulse"/>
								<g class="animate-spin-slow origin-center">
									<circle cx="34" cy="20" r="3" fill="#22d3ee"/>
									<circle cx="66" cy="20" r="3" fill="#883ae2"/>
								</g>
							</svg>
						</div>
						<h3 class="font-syne font-bold text-white text-xl sm:text-2xl mb-3 select-text group-hover:text-cyan-300 transition-colors leading-snug">
							Context Resolution
						</h3>
						<p class="text-neutral-300 text-sm leading-relaxed font-light select-text mb-8">
							Systems that distinguish between similar people, organizations, accounts, transactions and events using connected context and supporting evidence.
						</p>
					</div>

					<div class="pt-6 border-t border-white/10 space-y-3.5 relative z-10">
						<div class="grid grid-cols-[105px_1fr] sm:grid-cols-[115px_1fr] items-start gap-2.5">
							<span class="font-mono text-[10px] sm:text-[11px] tracking-wider text-cyan-400 font-semibold uppercase pt-0.5">UNDERSTANDS</span>
							<span class="text-neutral-200 font-light text-xs sm:text-[13px] leading-relaxed select-text">Entities, relationships and ambiguity</span>
						</div>
						<div class="grid grid-cols-[105px_1fr] sm:grid-cols-[115px_1fr] items-start gap-2.5">
							<span class="font-mono text-[10px] sm:text-[11px] tracking-wider text-cyan-400 font-semibold uppercase pt-0.5">USES</span>
							<span class="text-neutral-200 font-light text-xs sm:text-[13px] leading-relaxed select-text">Governed records, metadata and evidence signals</span>
						</div>
						<div class="grid grid-cols-[105px_1fr] sm:grid-cols-[115px_1fr] items-start gap-2.5">
							<span class="font-mono text-[10px] sm:text-[11px] tracking-wider text-cyan-400 font-semibold uppercase pt-0.5">SUPPORTS</span>
							<span class="text-neutral-200 font-light text-xs sm:text-[13px] leading-relaxed select-text">More reliable entity and event resolution</span>
						</div>
					</div>
				</div>

				<!-- CARD 04 -->
				<div class="relative p-8 rounded-2xl border border-white/10 bg-[#080c16]/95 backdrop-blur-xl hover:border-cyan-400/50 hover:bg-[#0c1222] hover:-translate-y-2 transition-all duration-500 group shadow-xl hover:shadow-2xl hover:shadow-cyan-500/10 flex flex-col justify-between overflow-hidden min-h-[460px]">
					<div class="absolute -top-24 -right-24 w-48 h-48 bg-cyan-500/0 group-hover:bg-cyan-500/15 rounded-full blur-3xl transition-all duration-700 pointer-events-none"></div>
					<div class="absolute -bottom-24 -left-24 w-48 h-48 bg-indigo-500/0 group-hover:bg-indigo-500/10 rounded-full blur-3xl transition-all duration-700 pointer-events-none"></div>
					
					<div>
						<div class="flex items-center justify-between mb-6">
							<span class="font-mono text-sm font-semibold text-neutral-400 group-hover:text-cyan-400 transition-colors">04</span>
							<span class="w-2 h-2 rounded-full bg-cyan-400/30 group-hover:bg-cyan-400 group-hover:animate-ping transition-all"></span>
						</div>
						<!-- Moving Graphic: Floating Enterprise Data Nodes -->
						<div class="h-16 w-full flex items-center justify-center mb-6 overflow-hidden">
							<svg class="w-36 h-11 text-cyan-400 group-hover:scale-105 transition-transform duration-500" viewBox="0 0 120 40" fill="none" stroke="currentColor">
								<rect x="8" y="6" width="16" height="12" rx="2" stroke="rgba(255,255,255,0.3)" stroke-width="1.5">
									<animate attributeName="y" values="5;7;5" dur="3s" repeatCount="indefinite"/>
								</rect>
								<rect x="96" y="6" width="16" height="12" rx="2" stroke="rgba(255,255,255,0.3)" stroke-width="1.5">
									<animate attributeName="y" values="7;5;7" dur="3s" repeatCount="indefinite"/>
								</rect>
								<rect x="16" y="24" width="16" height="12" rx="2" stroke="rgba(255,255,255,0.3)" stroke-width="1.5">
									<animate attributeName="y" values="23;25;23" dur="3.5s" repeatCount="indefinite"/>
								</rect>
								<rect x="88" y="24" width="16" height="12" rx="2" stroke="rgba(255,255,255,0.3)" stroke-width="1.5">
									<animate attributeName="y" values="25;23;25" dur="3.5s" repeatCount="indefinite"/>
								</rect>
								<line x1="24" y1="12" x2="60" y2="20" stroke="#22d3ee" stroke-opacity="0.5" stroke-width="1"/>
								<line x1="96" y1="12" x2="60" y2="20" stroke="#22d3ee" stroke-opacity="0.5" stroke-width="1"/>
								<line x1="32" y1="28" x2="60" y2="20" stroke="#22d3ee" stroke-opacity="0.5" stroke-width="1"/>
								<line x1="88" y1="28" x2="60" y2="20" stroke="#22d3ee" stroke-opacity="0.5" stroke-width="1"/>
								<circle cx="60" cy="20" r="6" fill="#080c16" stroke="#22d3ee" stroke-width="2"/>
								<circle cx="60" cy="20" r="3" fill="#22d3ee" class="animate-pulse"/>
								<!-- Pulse signals along lines -->
								<circle cx="24" cy="12" r="1.5" fill="#22d3ee">
									<animate attributeName="cx" values="24;60;24" dur="2.5s" repeatCount="indefinite"/>
									<animate attributeName="cy" values="12;20;12" dur="2.5s" repeatCount="indefinite"/>
								</circle>
								<circle cx="96" cy="12" r="1.5" fill="#883ae2">
									<animate attributeName="cx" values="96;60;96" dur="3s" repeatCount="indefinite"/>
									<animate attributeName="cy" values="12;20;12" dur="3s" repeatCount="indefinite"/>
								</circle>
							</svg>
						</div>
						<h3 class="font-syne font-bold text-white text-xl sm:text-2xl mb-3 select-text group-hover:text-cyan-300 transition-colors leading-snug">
							Enterprise Knowledge
						</h3>
						<p class="text-neutral-300 text-sm leading-relaxed font-light select-text mb-8">
							Grounded retrieval across CRM, ERP, documents, communications, meetings, operational systems and approved external sources.
						</p>
					</div>

					<div class="pt-6 border-t border-white/10 space-y-3.5 relative z-10">
						<div class="grid grid-cols-[105px_1fr] sm:grid-cols-[115px_1fr] items-start gap-2.5">
							<span class="font-mono text-[10px] sm:text-[11px] tracking-wider text-cyan-400 font-semibold uppercase pt-0.5">UNDERSTANDS</span>
							<span class="text-neutral-200 font-light text-xs sm:text-[13px] leading-relaxed select-text">Questions, permissions and knowledge relevance</span>
						</div>
						<div class="grid grid-cols-[105px_1fr] sm:grid-cols-[115px_1fr] items-start gap-2.5">
							<span class="font-mono text-[10px] sm:text-[11px] tracking-wider text-cyan-400 font-semibold uppercase pt-0.5">USES</span>
							<span class="text-neutral-200 font-light text-xs sm:text-[13px] leading-relaxed select-text">Structured and unstructured enterprise sources</span>
						</div>
						<div class="grid grid-cols-[105px_1fr] sm:grid-cols-[115px_1fr] items-start gap-2.5">
							<span class="font-mono text-[10px] sm:text-[11px] tracking-wider text-cyan-400 font-semibold uppercase pt-0.5">SUPPORTS</span>
							<span class="text-neutral-200 font-light text-xs sm:text-[13px] leading-relaxed select-text">Evidence-connected answers and decisions</span>
						</div>
					</div>
				</div>

				<!-- CARD 05 -->
				<div class="relative p-8 rounded-2xl border border-white/10 bg-[#080c16]/95 backdrop-blur-xl hover:border-cyan-400/50 hover:bg-[#0c1222] hover:-translate-y-2 transition-all duration-500 group shadow-xl hover:shadow-2xl hover:shadow-cyan-500/10 flex flex-col justify-between overflow-hidden min-h-[460px]">
					<div class="absolute -top-24 -right-24 w-48 h-48 bg-cyan-500/0 group-hover:bg-cyan-500/15 rounded-full blur-3xl transition-all duration-700 pointer-events-none"></div>
					<div class="absolute -bottom-24 -left-24 w-48 h-48 bg-indigo-500/0 group-hover:bg-indigo-500/10 rounded-full blur-3xl transition-all duration-700 pointer-events-none"></div>
					
					<div>
						<div class="flex items-center justify-between mb-6">
