			<script>
				document.addEventListener('DOMContentLoaded', () => {
					const tabBtns = document.querySelectorAll('.intelligence-tab-btn');
					const tabContents = document.querySelectorAll('.intelligence-tab-content');

					const styles = {
						interact: {
							btnClass: "intelligence-tab-btn px-6 py-3.5 rounded-xl border text-sm sm:text-base font-semibold tracking-wider transition-all duration-300 cursor-pointer flex items-center gap-2.5 bg-cyan-500/20 border-cyan-400 text-cyan-300 shadow-lg shadow-cyan-500/10",
							badgeClass: "w-6.5 h-6.5 rounded-lg bg-cyan-400/20 text-cyan-300 flex items-center justify-center font-mono text-sm font-bold"
						},
						understand: {
							btnClass: "intelligence-tab-btn px-6 py-3.5 rounded-xl border text-sm sm:text-base font-semibold tracking-wider transition-all duration-300 cursor-pointer flex items-center gap-2.5 bg-blue-500/20 border-blue-400 text-blue-300 shadow-lg shadow-blue-500/10",
							badgeClass: "w-6.5 h-6.5 rounded-lg bg-blue-400/20 text-blue-300 flex items-center justify-center font-mono text-sm font-bold"
						},
						coordinate: {
							btnClass: "intelligence-tab-btn px-6 py-3.5 rounded-xl border text-sm sm:text-base font-semibold tracking-wider transition-all duration-300 cursor-pointer flex items-center gap-2.5 bg-purple-500/20 border-purple-400 text-purple-300 shadow-lg shadow-purple-500/10",
							badgeClass: "w-6.5 h-6.5 rounded-lg bg-purple-400/20 text-purple-300 flex items-center justify-center font-mono text-sm font-bold"
						},
						execute: {
							btnClass: "intelligence-tab-btn px-6 py-3.5 rounded-xl border text-sm sm:text-base font-semibold tracking-wider transition-all duration-300 cursor-pointer flex items-center gap-2.5 bg-emerald-500/20 border-emerald-400 text-emerald-300 shadow-lg shadow-emerald-500/10",
							badgeClass: "w-6.5 h-6.5 rounded-lg bg-emerald-400/20 text-emerald-300 flex items-center justify-center font-mono text-sm font-bold"
						},
						inactive: {
							btnClass: "intelligence-tab-btn px-6 py-3.5 rounded-xl border border-white/10 bg-[#080c16]/80 text-neutral-400 hover:text-white hover:border-white/30 text-sm sm:text-base font-semibold tracking-wider transition-all duration-300 cursor-pointer flex items-center gap-2.5",
							badgeClass: "w-6.5 h-6.5 rounded-lg bg-white/10 text-neutral-300 flex items-center justify-center font-mono text-sm font-bold"
						}
					};

					tabBtns.forEach(btn => {
						btn.addEventListener('click', () => {
							const targetTab = btn.getAttribute('data-tab');
							if (!targetTab) return;

							// Update button states
							tabBtns.forEach(b => {
								const bTab = b.getAttribute('data-tab');
								const isTarget = bTab === targetTab;
								b.setAttribute('aria-selected', isTarget ? 'true' : 'false');
								const badge = b.querySelector('span:first-child');
								
								if (isTarget && bTab && styles[bTab as keyof typeof styles]) {
									const activeStyle = styles[bTab as keyof typeof styles];
									b.className = activeStyle.btnClass;
									if (badge) badge.className = activeStyle.badgeClass;
								} else {
									b.className = styles.inactive.btnClass;
									if (badge) badge.className = styles.inactive.badgeClass;
								}
							});

							// Update tab content panels
							tabContents.forEach(content => {
								if (content.id === `tab-content-${targetTab}`) {
									content.classList.remove('hidden');
									setTimeout(() => {
										content.classList.remove('opacity-0');
										content.classList.add('opacity-100');
									}, 30);
								} else {
									content.classList.remove('opacity-100');
									content.classList.add('opacity-0');
									content.classList.add('hidden');
								}
							});
						});
					});
				});
			</script>
