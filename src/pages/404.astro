---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout 
	title="diceforce IT | 404 - Transmission Lost" 
	description="The neural route you requested does not exist or has been decompiled. Return back to our core interface."
	activePage="none"
>
	<div class="max-w-4xl mx-auto w-full min-h-[60vh] flex flex-col items-center justify-center text-center gap-8 py-20">
		<!-- Error Indicator -->
		<div class="space-y-4 animate-stagger-item">
			<div class="inline-flex items-center gap-2 px-3 py-1 border border-cyan-500/20 rounded-full bg-cyan-500/5">
				<span class="font-mono text-xs tracking-widest text-cyan-400 uppercase animate-pulse">Error 404 // Transmission Lost</span>
			</div>
			
			<h1 class="font-syne font-black text-6xl sm:text-7xl md:text-8xl lg:text-9xl tracking-tighter leading-none text-white select-text">
				Route <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-500 to-indigo-500 font-black">Null</span>
			</h1>
			
			<p class="text-neutral-400 font-light text-base sm:text-lg max-w-xl mx-auto mt-6 leading-relaxed select-text">
				The packet or resource path you requested is offline, has changed names, or does not exist in the active namespace.
			</p>
		</div>

		<!-- Action button to go home -->
		<div class="animate-stagger-item pt-4">
			<div class="relative group transition-transform duration-500 hover:scale-[1.015]">
				<!-- Outer atmospheric soft glow using logo colors -->
				<div class="absolute -inset-1 bg-gradient-to-r from-[#0377ff] via-[#00deff] to-[#883ae2] rounded-full blur-md opacity-25 group-hover:opacity-60 transition-all duration-500 ease-out"></div>
				
				<!-- Rounded container that clips the rotating border gradient -->
				<div class="relative rounded-full p-[1px] overflow-hidden flex items-center justify-center bg-black shadow-[0_4px_12px_rgba(0,0,0,0.5)] group-hover:shadow-[0_0_20px_rgba(3,119,255,0.4)] transition-all duration-500">
					<!-- Rotating gradient element with logo colors -->
					<div class="absolute inset-[-200%] bg-[conic-gradient(from_0deg,#0377ff,#00deff,#883ae2,#00deff,#0377ff)] animate-border-spin"></div>
					
					<!-- Main Button Link -->
					<a 
						href="/home" 
						class="relative px-10 py-4 bg-black hover:bg-neutral-900 text-white font-mono text-xs font-bold uppercase tracking-widest rounded-full transition-all duration-300 inline-flex items-center gap-2.5 cursor-pointer z-10 select-none group-hover:text-[#00deff]"
					>
						Return to Core Interface
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
					</a>
				</div>
			</div>
		</div>

		<!-- Subtle debug helper -->
		<div class="font-mono text-xs text-white/25 uppercase tracking-widest mt-12 animate-stagger-item">
			Calibrating system parameters... <span id="404-retry-text">routing idle</span>
		</div>
	</div>

	<script>
		// Staggered status simulator
		const debugText = document.getElementById('404-retry-text');
		const statuses = [
			'searching dns table…',
			'testing static routes…',
			'resolving dynamic namespaces…',
			'pinging core gateway…',
			'route unreachable. standing by.'
		];
		
		if (debugText) {
			let currentIdx = 0;
			const statusInterval = setInterval(() => {
				if (currentIdx < statuses.length) {
					debugText.innerText = statuses[currentIdx];
					currentIdx++;
				} else {
					clearInterval(statusInterval);
				}
			}, 1500);
		}
	</script>
</PageLayout>
