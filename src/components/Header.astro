---
interface Props {
	activePage?: 'home' | 'about' | 'services' | 'careers' | 'contact' | 'none' | 'animl' | 'ai-ml' | 'it-staffing';
}

const { activePage = 'none' } = Astro.props;
---

<!-- Floating Header Navigation -->
<header id="main-header" class="fixed top-4 sm:top-6 left-0 right-0 z-50 w-full flex justify-center transition-all duration-500 ease-out opacity-100 translate-y-0 pointer-events-auto">
	<div class="w-[95%] sm:w-[92%] max-w-6xl relative backdrop-blur-lg bg-black/60 border border-white/10 rounded-full px-4 sm:px-8 py-2 flex items-center justify-between shadow-[0_4px_30px_rgba(0,0,0,0.4),inset_0_1px_0_rgba(255,255,255,0.05)] z-50">
		
		<!-- Brand Logo & Link -->
		<a href="/" class="flex items-center gap-1.5 sm:gap-2 group relative z-10 shrink-0 pointer-events-auto">
			<img src="/Diceforce-IT-white.svg" alt="Diceforce IT Logo" class="h-8 w-auto object-contain filter drop-shadow-[0_0_8px_rgba(34,211,238,0.6)]" width="157" height="32" />
		</a>
		
		<!-- Navigation Links (Desktop Right Aligned) -->
		<nav class="hidden min-[1180px]:flex items-center gap-6 relative z-25 pointer-events-auto">
			<!-- Home -->
			{activePage === 'home' ? (
				<a href="/" class="inline-flex items-center justify-center text-[16px] font-mono tracking-widest text-cyan-400 transition-colors uppercase py-1 px-2">
					<span class="text-cyan-400 opacity-100 mr-1">[</span>
					<span>Launch Pad</span>
					<span class="text-cyan-400 opacity-100 ml-1">]</span>
				</a>
			) : (
				<a href="/" class="inline-flex items-center justify-center text-[16px] font-mono tracking-widest text-white/60 hover:text-cyan-400 transition-colors uppercase py-1 px-2 group/link">
					<span class="text-cyan-400 opacity-0 group-hover/link:opacity-100 transition-[opacity,transform] duration-200 mr-1 translate-x-1 group-hover/link:translate-x-0">[</span>
					<span>Launch Pad</span>
					<span class="text-cyan-400 opacity-0 group-hover/link:opacity-100 transition-[opacity,transform] duration-200 ml-1 -translate-x-1 group-hover/link:translate-x-0">]</span>
				</a>
			)}

			<!-- Company Dropdown Group -->
			<div class="relative group/dropdown py-1 flex items-center justify-center">
				{activePage === 'about' || activePage === 'careers' ? (
					<a href="/about" class="inline-flex items-center justify-center text-[16px] font-mono tracking-widest text-cyan-400 transition-colors uppercase py-1 px-2 gap-1 group/link">
						<span class="text-cyan-400 opacity-100 mr-1">[</span>
						<span>Our Company</span>
						<span class="text-cyan-400 opacity-100 ml-1">]</span>
						<svg class="w-4 h-4 text-cyan-400 transition-[color,transform] group-hover/dropdown:rotate-180 duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
							<polyline points="6 9 12 15 18 9"></polyline>
						</svg>
					</a>
				) : (
					<a href="/about" class="inline-flex items-center justify-center text-[16px] font-mono tracking-widest text-white/60 hover:text-cyan-400 transition-colors uppercase py-1 px-2 gap-1 group/link">
						<span class="text-cyan-400 opacity-0 group-hover/link:opacity-100 transition-[opacity,transform] duration-200 mr-1 translate-x-1 group-hover/link:translate-x-0">[</span>
						<span>Our Company</span>
						<span class="text-cyan-400 opacity-0 group-hover/link:opacity-100 transition-[opacity,transform] duration-200 ml-1 -translate-x-1 group-hover/link:translate-x-0">]</span>
						<svg class="w-4 h-4 text-white/40 group-hover/dropdown:text-cyan-400 transition-[color,transform] group-hover/dropdown:rotate-180 duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
							<polyline points="6 9 12 15 18 9"></polyline>
						</svg>
					</a>
				)}
				
				<!-- Dropdown Menu Box (Two Column Grid) -->
				<div class="absolute top-full left-1/2 -translate-x-1/2 pt-2.5 opacity-0 invisible group-hover/dropdown:opacity-100 group-hover/dropdown:visible transition-[opacity,visibility] duration-300 w-[32rem] pointer-events-none group-hover/dropdown:pointer-events-auto z-50">
					<div class="backdrop-blur-md bg-black/95 border border-white/10 rounded-xl p-3 shadow-2xl grid grid-cols-2 gap-3">
						<a href="/about" class="flex flex-col gap-1 p-3 rounded-lg border border-white/5 bg-white/[0.02] hover:border-cyan-400/30 hover:bg-cyan-500/[0.05] transition-all duration-300 group/dropitem text-left font-sans">
							<div class="flex items-center gap-1">
								<span class="text-cyan-400 opacity-0 group-hover/dropitem:opacity-100 transition-[opacity,transform] duration-200 -translate-x-1 group-hover/dropitem:translate-x-0 font-mono text-xs">[</span>
								<span class="text-[16px] font-mono uppercase tracking-widest text-neutral-300 group-hover:text-cyan-400 transition-colors font-bold">Our DNA</span>
								<span class="text-cyan-400 opacity-0 group-hover/dropitem:opacity-100 transition-[opacity,transform] duration-200 translate-x-1 group-hover/dropitem:translate-x-0 font-mono text-xs">]</span>
							</div>
							<p class="text-[15px] text-neutral-400 group-hover:text-neutral-300 transition-colors font-light leading-snug font-sans">
								Our mission, vision, and core engineering philosophy.
							</p>
						</a>
						<a href="/careers" class="flex flex-col gap-1 p-3 rounded-lg border border-white/5 bg-white/[0.02] hover:border-cyan-400/30 hover:bg-cyan-500/[0.05] transition-all duration-300 group/dropitem text-left font-sans">
							<div class="flex items-center gap-1">
								<span class="text-cyan-400 opacity-0 group-hover/dropitem:opacity-100 transition-[opacity,transform] duration-200 -translate-x-1 group-hover/dropitem:translate-x-0 font-mono text-xs">[</span>
								<span class="text-[16px] font-mono uppercase tracking-widest text-neutral-300 group-hover:text-cyan-400 transition-colors font-bold">Join Us</span>
								<span class="text-cyan-400 opacity-0 group-hover/dropitem:opacity-100 transition-[opacity,transform] duration-200 translate-x-1 group-hover/dropitem:translate-x-0 font-mono text-xs">]</span>
							</div>
							<p class="text-[15px] text-neutral-400 group-hover:text-neutral-300 transition-colors font-light leading-snug font-sans">
								Explore open opportunities and build the future with us.
							</p>
						</a>
					</div>
				</div>
			</div>

			<!-- Services Dropdown Group -->
			<div class="relative group/dropdown py-1 flex items-center justify-center">
				{activePage === 'ai-ml' || activePage === 'it-staffing' || activePage === 'animl' ? (
					<a href="/ai-ml" class="inline-flex items-center justify-center text-[16px] font-mono tracking-widest text-cyan-400 transition-colors uppercase py-1 px-2 gap-1 group/link">
						<span class="text-cyan-400 opacity-100 mr-1">[</span>
						<span>Our Expertise</span>
						<span class="text-cyan-400 opacity-100 ml-1">]</span>
						<svg class="w-4 h-4 text-cyan-400 transition-[color,transform] group-hover/dropdown:rotate-180 duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
							<polyline points="6 9 12 15 18 9"></polyline>
						</svg>
					</a>
				) : (
					<a href="/ai-ml" class="inline-flex items-center justify-center text-[16px] font-mono tracking-widest text-white/60 hover:text-cyan-400 transition-colors uppercase py-1 px-2 gap-1 group/link">
						<span class="text-cyan-400 opacity-0 group-hover/link:opacity-100 transition-[opacity,transform] duration-200 mr-1 translate-x-1 group-hover/link:translate-x-0">[</span>
						<span>Our Expertise</span>
						<span class="text-cyan-400 opacity-0 group-hover/link:opacity-100 transition-[opacity,transform] duration-200 ml-1 -translate-x-1 group-hover/link:translate-x-0">]</span>
						<svg class="w-4 h-4 text-white/40 group-hover/dropdown:text-cyan-400 transition-[color,transform] group-hover/dropdown:rotate-180 duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
							<polyline points="6 9 12 15 18 9"></polyline>
						</svg>
					</a>
				)}
				
				<!-- Dropdown Menu Box (Two Column Grid) -->
				<div class="absolute top-full left-1/2 -translate-x-1/2 pt-2.5 opacity-0 invisible group-hover/dropdown:opacity-100 group-hover/dropdown:visible transition-[opacity,visibility] duration-300 w-[32rem] pointer-events-none group-hover/dropdown:pointer-events-auto z-50">
					<div class="backdrop-blur-md bg-black/95 border border-white/10 rounded-xl p-3 shadow-2xl grid grid-cols-2 gap-3">
						<a href="/ai-ml" class="flex flex-col gap-1 p-3 rounded-lg border border-white/5 bg-white/[0.02] hover:border-cyan-400/30 hover:bg-cyan-500/[0.05] transition-all duration-300 group/dropitem text-left font-sans">
							<div class="flex items-center gap-1">
								<span class="text-cyan-400 opacity-0 group-hover/dropitem:opacity-100 transition-[opacity,transform] duration-200 -translate-x-1 group-hover/dropitem:translate-x-0 font-mono text-xs">[</span>
								<span class="text-[16px] font-mono uppercase tracking-widest text-neutral-300 group-hover:text-cyan-400 transition-colors font-bold">Ai ML</span>
								<span class="text-cyan-400 opacity-0 group-hover/dropitem:opacity-100 transition-[opacity,transform] duration-200 translate-x-1 group-hover/dropitem:translate-x-0 font-mono text-xs">]</span>
							</div>
							<p class="text-[15px] text-neutral-400 group-hover:text-neutral-300 transition-colors font-light leading-snug font-sans">
								Custom neural models & cognitive pipelines.
							</p>
						</a>
						<a href="/it-staffing" class="flex flex-col gap-1 p-3 rounded-lg border border-white/5 bg-white/[0.02] hover:border-cyan-400/30 hover:bg-cyan-500/[0.05] transition-all duration-300 group/dropitem text-left font-sans">
							<div class="flex items-center gap-1">
								<span class="text-cyan-400 opacity-0 group-hover/dropitem:opacity-100 transition-[opacity,transform] duration-200 -translate-x-1 group-hover/dropitem:translate-x-0 font-mono text-xs">[</span>
								<span class="text-[16px] font-mono uppercase tracking-widest text-neutral-300 group-hover:text-cyan-400 transition-colors font-bold">IT Staffing</span>
								<span class="text-cyan-400 opacity-0 group-hover/dropitem:opacity-100 transition-[opacity,transform] duration-200 translate-x-1 group-hover/dropitem:translate-x-0 font-mono text-xs">]</span>
							</div>
							<p class="text-[15px] text-neutral-400 group-hover:text-neutral-300 transition-colors font-light leading-snug font-sans">
								Elite embedded machine learning & dev squads.
							</p>
						</a>
					</div>
				</div>
			</div>
			
			<!-- Contact -->
			{activePage === 'contact' ? (
				<a href="/contact" class="inline-flex items-center justify-center text-[16px] font-mono tracking-widest text-cyan-400 transition-colors uppercase py-1 px-2">
					<span class="text-cyan-400 opacity-100 mr-1">[</span>
					<span>Let's Talk</span>
					<span class="text-cyan-400 opacity-100 ml-1">]</span>
				</a>
			) : (
				<a href="/contact" class="inline-flex items-center justify-center text-[16px] font-mono tracking-widest text-white/60 hover:text-cyan-400 transition-colors uppercase py-1 px-2 group/link">
					<span class="text-cyan-400 opacity-0 group-hover/link:opacity-100 transition-[opacity,transform] duration-200 mr-1 translate-x-1 group-hover/link:translate-x-0">[</span>
					<span>Let's Talk</span>
					<span class="text-cyan-400 opacity-0 group-hover/link:opacity-100 transition-[opacity,transform] duration-200 ml-1 -translate-x-1 group-hover/link:translate-x-0">]</span>
				</a>
			)}
		</nav>

		<!-- Mobile Menu Hamburger Button (Trigger) -->
		<button 
			id="mobile-menu-btn" 
			aria-label="Open Navigation Menu" 
			onclick="window.toggleMobileMenu(event)"
			class="min-[1180px]:hidden relative z-[60] p-2.5 -mr-1.5 text-cyan-400 hover:text-white transition-colors focus:outline-none pointer-events-auto flex items-center justify-center cursor-pointer active:scale-95"
		>
			<svg id="hamburger-icon" class="w-7 h-7 transition-transform duration-300 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
				<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
			</svg>
		</button>
	</div>
</header>

<!-- Mobile Menu Overlay (Full-screen fixed layer) -->
<div 
	id="mobile-menu-overlay" 
	class="fixed inset-0 z-[100] bg-[#030308]/98 backdrop-blur-2xl hidden flex-col justify-between transition-opacity duration-300 ease-in-out opacity-0 pointer-events-none min-[1180px]:hidden overflow-y-auto max-h-[100dvh] pt-24 pb-8 px-6"
>
	<!-- Dedicated Top Header Bar inside Overlay with Explicit CLOSE Option -->
	<div class="absolute top-4 left-0 right-0 z-[110] w-full flex justify-center px-4 sm:px-6 pointer-events-auto">
		<div class="w-[95%] sm:w-[92%] max-w-6xl flex items-center justify-between py-2 border-b border-white/10 pb-3">
			<a href="/" onclick="window.closeMobileMenu()" class="flex items-center gap-1.5 sm:gap-2 group">
				<img src="/Diceforce-IT-white.svg" alt="Diceforce IT Logo" class="h-8 w-auto object-contain filter drop-shadow-[0_0_8px_rgba(34,211,238,0.6)]" width="157" height="32" />
			</a>
			
			<!-- Icon-Only CLOSE Button -->
			<button 
				id="mobile-menu-close-btn" 
				aria-label="Close Navigation Menu" 
				onclick="window.closeMobileMenu(event)"
				class="p-2.5 rounded-full bg-cyan-950/90 border border-cyan-400/60 text-cyan-400 hover:text-white hover:bg-cyan-500/20 hover:border-cyan-300 transition-all shadow-[0_0_15px_rgba(34,211,238,0.3)] flex items-center justify-center cursor-pointer active:scale-95 pointer-events-auto group"
			>
				<svg class="w-6 h-6 text-cyan-400 group-hover:text-white transition-colors pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
				</svg>
			</button>
		</div>
	</div>

	<!-- Soft Ambient Glows in Mobile Menu -->
	<div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-80 h-80 rounded-full bg-cyan-500/10 blur-[100px] pointer-events-none"></div>
	<div class="absolute bottom-10 right-0 w-72 h-72 rounded-full bg-blue-600/10 blur-[100px] pointer-events-none"></div>

	<!-- Scrollable Menu Content -->
	<div class="relative z-10 w-full max-w-md mx-auto flex flex-col gap-6 pt-4">
		
		<!-- Section 01: Main -->
		<div class="space-y-2">
			<div class="font-mono text-[11px] uppercase tracking-[0.25em] text-cyan-400/70 font-semibold px-2">01 // Main</div>
			<a 
				href="/" 
				onclick="window.closeMobileMenu()"
				class={`group flex items-center justify-between p-3.5 rounded-xl border transition-all duration-300 ${
					activePage === 'home' 
						? 'bg-cyan-500/10 border-cyan-400/50 text-cyan-400 shadow-[0_0_15px_rgba(34,211,238,0.15)]' 
						: 'bg-white/[0.03] border-white/5 text-white/90 hover:bg-white/[0.07] hover:border-cyan-400/30 hover:text-cyan-400'
				}`}
			>
				<span class="font-mono text-lg uppercase tracking-wider font-bold flex items-center gap-2">
					<span class="text-cyan-400">{activePage === 'home' ? '[' : ''}</span>
					<span>Launch Pad</span>
					<span class="text-cyan-400">{activePage === 'home' ? ']' : ''}</span>
				</span>
				<svg class="w-5 h-5 text-cyan-400/60 group-hover:text-cyan-400 group-hover:translate-x-1 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
				</svg>
			</a>
		</div>

		<!-- Section 02: Our Expertise -->
		<div class="space-y-2">
			<div class="font-mono text-[11px] uppercase tracking-[0.25em] text-cyan-400/70 font-semibold px-2">02 // Our Expertise</div>
			
			<div class="grid gap-2">
				<a 
					href="/ai-ml" 
					onclick="window.closeMobileMenu()"
					class={`group flex flex-col p-3.5 rounded-xl border transition-all duration-300 ${
						activePage === 'ai-ml' || activePage === 'animl'
							? 'bg-cyan-500/10 border-cyan-400/50 text-cyan-400 shadow-[0_0_15px_rgba(34,211,238,0.15)]' 
							: 'bg-white/[0.03] border-white/5 text-white/90 hover:bg-white/[0.07] hover:border-cyan-400/30 hover:text-cyan-400'
					}`}
				>
					<div class="flex items-center justify-between">
						<span class="font-mono text-base uppercase tracking-wider font-bold flex items-center gap-1.5">
							<span class="text-cyan-400">{activePage === 'ai-ml' || activePage === 'animl' ? '[' : ''}</span>
							<span>AI & Machine Learning</span>
							<span class="text-cyan-400">{activePage === 'ai-ml' || activePage === 'animl' ? ']' : ''}</span>
						</span>
						<svg class="w-4 h-4 text-cyan-400/60 group-hover:text-cyan-400 group-hover:translate-x-1 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
						</svg>
					</div>
					<p class="text-xs text-neutral-400 mt-1 font-sans font-light leading-snug">Custom neural models & cognitive pipelines.</p>
				</a>

				<a 
					href="/it-staffing" 
					onclick="window.closeMobileMenu()"
					class={`group flex flex-col p-3.5 rounded-xl border transition-all duration-300 ${
						activePage === 'it-staffing' 
							? 'bg-cyan-500/10 border-cyan-400/50 text-cyan-400 shadow-[0_0_15px_rgba(34,211,238,0.15)]' 
							: 'bg-white/[0.03] border-white/5 text-white/90 hover:bg-white/[0.07] hover:border-cyan-400/30 hover:text-cyan-400'
					}`}
				>
					<div class="flex items-center justify-between">
						<span class="font-mono text-base uppercase tracking-wider font-bold flex items-center gap-1.5">
							<span class="text-cyan-400">{activePage === 'it-staffing' ? '[' : ''}</span>
							<span>IT Staffing</span>
							<span class="text-cyan-400">{activePage === 'it-staffing' ? ']' : ''}</span>
						</span>
						<svg class="w-4 h-4 text-cyan-400/60 group-hover:text-cyan-400 group-hover:translate-x-1 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
						</svg>
					</div>
					<p class="text-xs text-neutral-400 mt-1 font-sans font-light leading-snug">Elite embedded machine learning & dev squads.</p>
				</a>
			</div>
		</div>

		<!-- Section 03: Our Company -->
		<div class="space-y-2">
			<div class="font-mono text-[11px] uppercase tracking-[0.25em] text-cyan-400/70 font-semibold px-2">03 // Our Company</div>
			
			<div class="grid gap-2">
				<a 
					href="/about" 
					onclick="window.closeMobileMenu()"
					class={`group flex flex-col p-3.5 rounded-xl border transition-all duration-300 ${
						activePage === 'about' 
							? 'bg-cyan-500/10 border-cyan-400/50 text-cyan-400 shadow-[0_0_15px_rgba(34,211,238,0.15)]' 
							: 'bg-white/[0.03] border-white/5 text-white/90 hover:bg-white/[0.07] hover:border-cyan-400/30 hover:text-cyan-400'
					}`}
				>
					<div class="flex items-center justify-between">
						<span class="font-mono text-base uppercase tracking-wider font-bold flex items-center gap-1.5">
							<span class="text-cyan-400">{activePage === 'about' ? '[' : ''}</span>
							<span>Our DNA</span>
							<span class="text-cyan-400">{activePage === 'about' ? ']' : ''}</span>
						</span>
						<svg class="w-4 h-4 text-cyan-400/60 group-hover:text-cyan-400 group-hover:translate-x-1 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
						</svg>
					</div>
					<p class="text-xs text-neutral-400 mt-1 font-sans font-light leading-snug">Our mission, vision, and core engineering philosophy.</p>
				</a>

				<a 
					href="/careers" 
					onclick="window.closeMobileMenu()"
					class={`group flex flex-col p-3.5 rounded-xl border transition-all duration-300 ${
						activePage === 'careers' 
							? 'bg-cyan-500/10 border-cyan-400/50 text-cyan-400 shadow-[0_0_15px_rgba(34,211,238,0.15)]' 
							: 'bg-white/[0.03] border-white/5 text-white/90 hover:bg-white/[0.07] hover:border-cyan-400/30 hover:text-cyan-400'
					}`}
				>
					<div class="flex items-center justify-between">
						<span class="font-mono text-base uppercase tracking-wider font-bold flex items-center gap-1.5">
							<span class="text-cyan-400">{activePage === 'careers' ? '[' : ''}</span>
							<span>Join Us</span>
							<span class="text-cyan-400">{activePage === 'careers' ? ']' : ''}</span>
						</span>
						<svg class="w-4 h-4 text-cyan-400/60 group-hover:text-cyan-400 group-hover:translate-x-1 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
						</svg>
					</div>
					<p class="text-xs text-neutral-400 mt-1 font-sans font-light leading-snug">Explore open opportunities and build the future with us.</p>
				</a>
			</div>
		</div>

		<!-- Action Button: Contact -->
		<div class="pt-2">
			<a 
				href="/contact" 
				onclick="window.closeMobileMenu()"
				class="w-full py-4 bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-black font-bold font-mono tracking-widest uppercase rounded-xl flex items-center justify-center gap-2 shadow-[0_0_20px_rgba(34,211,238,0.3)] transition-all duration-300 active:scale-[0.98]"
			>
				<span>Let's Talk</span>
				<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
					<path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
				</svg>
			</a>
		</div>
	</div>

	<!-- Bottom Brand Footer inside Mobile Menu Overlay -->
	<div class="relative z-10 w-full max-w-md mx-auto pt-6 border-t border-white/10 flex items-center justify-between text-xs font-mono text-neutral-500">
		<span class="uppercase tracking-widest text-cyan-400/80 font-bold">Diceforce IT</span>
		<span>© {new Date().getFullYear()} All Rights Reserved</span>
	</div>
</div>

<script is:inline>
	window.openMobileMenu = function() {
		var overlay = document.getElementById('mobile-menu-overlay');
		var btn = document.getElementById('mobile-menu-btn');
		if (!overlay) return;
		overlay.classList.remove('hidden');
		overlay.classList.add('flex');
		requestAnimationFrame(function() {
			overlay.style.opacity = '1';
			overlay.style.pointerEvents = 'auto';
		});
		if (btn) btn.setAttribute('aria-expanded', 'true');
		document.body.style.overflow = 'hidden';
	};

	window.closeMobileMenu = function(e) {
		if (e) e.stopPropagation();
		var overlay = document.getElementById('mobile-menu-overlay');
		var btn = document.getElementById('mobile-menu-btn');
		if (!overlay) return;
		overlay.style.opacity = '0';
		overlay.style.pointerEvents = 'none';
		setTimeout(function() {
			overlay.classList.remove('flex');
			overlay.classList.add('hidden');
		}, 300);
		if (btn) btn.setAttribute('aria-expanded', 'false');
		document.body.style.overflow = '';
	};

	window.toggleMobileMenu = function(e) {
		if (e) e.stopPropagation();
		var overlay = document.getElementById('mobile-menu-overlay');
		if (!overlay) return;
		if (overlay.classList.contains('hidden') || overlay.style.opacity === '0' || overlay.style.opacity === '') {
			window.openMobileMenu();
		} else {
			window.closeMobileMenu(e);
		}
	};

	// Close on Escape key
	window.addEventListener('keydown', function(e) {
		if (e.key === 'Escape') {
			window.closeMobileMenu(e);
		}
	});
</script>
