---
/* BackgroundEffects.astro - Animated radial light glows and background gradients */
---

<div class="absolute inset-0 pointer-events-none overflow-hidden z-0" aria-hidden="true">
  <!-- Radial glowing light 1 (Cyan/Neon Blue top center) -->
  <div class="absolute top-[10%] left-[30%] w-[500px] h-[500px] rounded-full bg-[#00deff]/[0.08] blur-[130px] animate-ambient-light"></div>

  <!-- Radial glowing light 2 (Deep Electric Blue bottom right) -->
  <div class="absolute bottom-[15%] right-[20%] w-[600px] h-[600px] rounded-full bg-[#1266ff]/[0.08] blur-[150px] animate-ambient-light" style="animation-delay: 3s;"></div>
</div>
