---
/* DataFabric.astro - Glowing capsule header positioned above architecture core matching reference diagram */
---

<div class="w-full flex justify-center z-30 relative mb-4">
  <div class="eai-data-fabric-capsule flex items-center gap-3 px-4 py-1.5 bg-black/80 border border-cyan-500/30 rounded-full shadow-[0_0_20px_rgba(0,222,255,0.15)]" role="banner" aria-label="Unified Data Fabric Header">
    <!-- 3 Layer Diamond Stack Icon -->
    <div class="text-cyan-400 flex items-center justify-center">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/>
        <path d="m22 12.5-8.58 3.91a2 2 0 0 1-1.66 0L3 12.5"/>
        <path d="m22 17.5-8.58 3.91a2 2 0 0 1-1.66 0L3 17.5"/>
      </svg>
    </div>

    <!-- Title & Subtitle -->
    <div class="flex flex-col text-left">
      <span class="font-heading font-extrabold text-xs tracking-wider uppercase text-white">UNIFIED DATA <span class="text-cyan-400">FABRIC</span></span>
      <span class="font-mono text-xs text-white/50">Connect. Normalize. Enrich.</span>
    </div>
  </div>
</div>
