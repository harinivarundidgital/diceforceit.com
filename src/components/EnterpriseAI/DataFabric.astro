---
/* DataFabric.astro - Glowing capsule header positioned above architecture core */
---

<div class="w-full flex justify-center z-30 relative mb-6">
  <div class="eai-data-fabric-capsule flex flex-wrap items-center justify-center gap-2 sm:gap-3.5 px-3.5 sm:px-5 py-2 max-w-[95vw] bg-[#080d22]/90 border border-cyan-500/40 rounded-2xl sm:rounded-full shadow-[0_0_25px_rgba(0,222,255,0.2)] backdrop-blur-xl hover:border-cyan-400 transition-all duration-300 group" role="banner" aria-label="Unified Data Fabric Header">
    <!-- 3 Layer Diamond Stack Icon -->
    <div class="text-cyan-400 flex items-center justify-center p-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/20 group-hover:scale-110 transition-transform">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="animate-pulse">
        <path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/>
        <path d="m22 12.5-8.58 3.91a2 2 0 0 1-1.66 0L3 12.5"/>
        <path d="m22 17.5-8.58 3.91a2 2 0 0 1-1.66 0L3 17.5"/>
      </svg>
    </div>

    <!-- Title & Subtitle -->
    <div class="flex flex-col text-left">
      <span class="font-heading font-extrabold text-xs tracking-wider text-white flex items-center gap-2">
        Unified Data Fabric
      </span>
      <span class="font-mono text-[11px] text-white">Connect • Normalize • Enrich</span>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-1.5 pl-0 sm:pl-2 border-t sm:border-t-0 sm:border-l border-white/10 pt-1.5 sm:pt-0 mt-1 sm:mt-0 text-[10px] font-mono text-white">
      <span class="px-2 py-0.5 rounded-md bg-cyan-950/50 border border-cyan-500/20">Vector DB</span>
      <span class="px-2 py-0.5 rounded-md bg-cyan-950/50 border border-cyan-500/20">Semantic RAG</span>
      <span class="px-2 py-0.5 rounded-md bg-cyan-950/50 border border-cyan-500/20">Real-time ETL</span>
    </div>
  </div>
</div>
