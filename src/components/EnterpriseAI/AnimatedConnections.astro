---
/* AnimatedConnections.astro - SVG Backdrop with animated neon circuit connections and glowing circle nodes */
---

<svg class="eai-svg-connections" id="eai-svg-overlay" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <defs>
    <!-- Neon Gradient Definition -->
    <linearGradient id="neonGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00deff" stop-opacity="0.85" />
      <stop offset="50%" stop-color="#a855f7" stop-opacity="0.9" />
      <stop offset="100%" stop-color="#10b981" stop-opacity="0.85" />
    </linearGradient>

    <!-- Cyan Glow Filter -->
    <filter id="neonGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="3" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>

    <!-- Glowing Circle Node Markers (Replaces Arrowhead Shapes) -->
    <marker id="flowCircleCyan" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6">
      <circle cx="5" cy="5" r="3.5" fill="#00deff" stroke="#050816" stroke-width="1.5" />
    </marker>

    <marker id="flowCirclePurple" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6">
      <circle cx="5" cy="5" r="3.5" fill="#c084fc" stroke="#050816" stroke-width="1.5" />
    </marker>

    <marker id="flowCircleEmerald" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6">
      <circle cx="5" cy="5" r="3.5" fill="#34d399" stroke="#050816" stroke-width="1.5" />
    </marker>
  </defs>

  <!-- Container for dynamically calculated SVG connection paths -->
  <g id="eai-connection-paths-group">
    <!-- SVG Paths dynamically generated via client script -->
  </g>
</svg>

<script>
  // Dynamic client-side calculation of SVG curves linking architecture stages with circle nodes
  function updateConnections() {
    const overlay = document.getElementById('eai-svg-overlay');
    const group = document.getElementById('eai-connection-paths-group');
    const center = document.getElementById('core-engine-center');
    
    if (!overlay || !group || !center) return;

    const overlayRect = overlay.getBoundingClientRect();
    const centerRect = center.getBoundingClientRect();
    
    const centerX = centerRect.left + centerRect.width / 2 - overlayRect.left;
    const centerY = centerRect.top + centerRect.height / 2 - overlayRect.top;

    let pathsHTML = '';

    // Stage 0: User Input Bar ➔ Data Fabric Capsule
    const userInput = document.getElementById('eai-user-prompt-input');
    const dataFabric = document.querySelector('.eai-data-fabric-capsule');
    if (userInput && dataFabric) {
      const uRect = userInput.getBoundingClientRect();
      const fRect = dataFabric.getBoundingClientRect();
      
      const startX = uRect.left + uRect.width / 2 - overlayRect.left;
      const startY = uRect.bottom - overlayRect.top;
      const endX = fRect.left + fRect.width / 2 - overlayRect.left;
      const endY = fRect.top - overlayRect.top;

      pathsHTML += `<path class="eai-svg-path" data-stage="0" d="M ${startX} ${startY} Q ${startX} ${(startY + endY)/2}, ${endX} ${endY}" filter="url(#neonGlow)" />`;
    }

    // Stage 1: Data Fabric Capsule ➔ Enterprise Input Cards
    const inputCards = document.querySelectorAll('.eai-input-card');
    if (dataFabric && inputCards.length > 0) {
      const fRect = dataFabric.getBoundingClientRect();
      const startX = fRect.left + fRect.width / 2 - overlayRect.left;
      const startY = fRect.bottom - overlayRect.top;

      inputCards.forEach((card) => {
        const rect = card.getBoundingClientRect();
        const endX = rect.left + rect.width / 2 - overlayRect.left;
        const endY = rect.top - overlayRect.top;
        const controlY = startY + (endY - startY) * 0.5;

        pathsHTML += `<path class="eai-svg-path" data-stage="1" d="M ${startX} ${startY} C ${startX} ${controlY}, ${endX} ${controlY}, ${endX} ${endY}" filter="url(#neonGlow)" />`;
      });
    }

    // Stage 2: Enterprise Inputs ➔ Left Capabilities
    const leftCaps = document.querySelectorAll('.eai-cap-left');
    inputCards.forEach((card, idx) => {
      const rect = card.getBoundingClientRect();
      const startX = rect.right - overlayRect.left;
      const startY = rect.top + rect.height / 2 - overlayRect.top;
      
      const targetCap = leftCaps[idx < 2 ? 0 : 1] || leftCaps[0];
      if (targetCap) {
        const capRect = targetCap.getBoundingClientRect();
        const endX = capRect.left - overlayRect.left;
        const endY = capRect.top + capRect.height / 2 - overlayRect.top;

        const controlX1 = startX + (endX - startX) * 0.5;
        const controlX2 = startX + (endX - startX) * 0.5;

        pathsHTML += `<path class="eai-svg-path" data-stage="2" d="M ${startX} ${startY} C ${controlX1} ${startY}, ${controlX2} ${endY}, ${endX} ${endY}" filter="url(#neonGlow)" />`;
      }
    });

    // Stage 3: Left Capabilities ➔ Core Engine Center
    leftCaps.forEach((cap) => {
      const capRect = cap.getBoundingClientRect();
      const startX = capRect.right - overlayRect.left;
      const startY = capRect.top + capRect.height / 2 - overlayRect.top;
      const endX = centerRect.left - overlayRect.left;
      const endY = centerY;

      pathsHTML += `<path class="eai-svg-path" data-stage="3" d="M ${startX} ${startY} Q ${(startX + endX)/2} ${startY}, ${endX} ${endY}" filter="url(#neonGlow)" />`;
    });

    // Stage 4: Core Engine Center ➔ Hallucination Control Layer
    const hallucination = document.querySelector('.eai-hallucination-card');
    if (hallucination) {
      const hRect = hallucination.getBoundingClientRect();
      const startX = centerX;
      const startY = centerRect.bottom - overlayRect.top;
      const endX = hRect.left + hRect.width / 2 - overlayRect.left;
      const endY = hRect.top - overlayRect.top;

      pathsHTML += `<path class="eai-svg-path" data-stage="4" d="M ${startX} ${startY} L ${endX} ${endY}" filter="url(#neonGlow)" />`;
    }

    // Stage 5: Core Engine Center ➔ Right Capabilities
    const rightCaps = document.querySelectorAll('.eai-cap-right');
    rightCaps.forEach((cap) => {
      const capRect = cap.getBoundingClientRect();
      const startX = centerRect.right - overlayRect.left;
      const startY = centerY;
      const endX = capRect.left - overlayRect.left;
      const endY = capRect.top + capRect.height / 2 - overlayRect.top;

      pathsHTML += `<path class="eai-svg-path" data-stage="5" d="M ${startX} ${startY} Q ${(startX + endX)/2} ${endY}, ${endX} ${endY}" filter="url(#neonGlow)" />`;
    });

    // Stage 6: Right Capabilities ➔ Intelligent Outputs
    const outputCards = document.querySelectorAll('.eai-output-card');
    rightCaps.forEach((cap, idx) => {
      const capRect = cap.getBoundingClientRect();
      const startX = capRect.right - overlayRect.left;
      const startY = capRect.top + capRect.height / 2 - overlayRect.top;
      
      const targetOutputs = [outputCards[idx * 2], outputCards[idx * 2 + 1]];
      targetOutputs.forEach(targetOutput => {
        if (targetOutput) {
          const outRect = targetOutput.getBoundingClientRect();
          const endX = outRect.left - overlayRect.left;
          const endY = outRect.top + outRect.height / 2 - overlayRect.top;

          const controlX1 = startX + (endX - startX) * 0.5;
          const controlX2 = startX + (endX - startX) * 0.5;

          pathsHTML += `<path class="eai-svg-path" data-stage="6" d="M ${startX} ${startY} C ${controlX1} ${startY}, ${controlX2} ${endY}, ${endX} ${endY}" filter="url(#neonGlow)" />`;
        }
      });
    });

    // Stage 7: Intelligent Outputs ➔ Automated Actions (Flow inside Column 3)
    const actionCards = document.querySelectorAll('.eai-action-card');
    outputCards.forEach((outCard, idx) => {
      const outRect = outCard.getBoundingClientRect();
      const actionCard = actionCards[idx];
      if (actionCard) {
        const actRect = actionCard.getBoundingClientRect();
        const startX = outRect.left + outRect.width * 0.75 - overlayRect.left;
        const startY = outRect.bottom - overlayRect.top;
        const endX = actRect.left + actRect.width * 0.75 - overlayRect.left;
        const endY = actRect.top - overlayRect.top;

        pathsHTML += `<path class="eai-svg-path" data-stage="7" d="M ${startX} ${startY} C ${startX} ${(startY + endY)/2}, ${endX} ${(startY + endY)/2}, ${endX} ${endY}" filter="url(#neonGlow)" />`;
      }
    });

    group.innerHTML = pathsHTML;
  }

  // Recalculate on load and window resize
  if (typeof window !== 'undefined') {
    (window as any).updateConnections = updateConnections;
    window.addEventListener('load', updateConnections);
    window.addEventListener('resize', updateConnections);
    setTimeout(updateConnections, 250);
  }
</script>
