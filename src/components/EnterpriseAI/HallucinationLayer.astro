---
/* HallucinationLayer.astro - Guardrail glass card below core engine */
---

<div class="eai-hallucination-card flex flex-col sm:flex-row items-center justify-center text-center gap-2 sm:gap-4 p-3 bg-[#080d22]/85 border border-white/10 rounded-xl" role="region" aria-label="Hallucination Control Layer">
  <div class="eai-hallucination-header flex items-center justify-center gap-2">
    <div class="eai-shield-icon flex items-center justify-center">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>
        <path d="m9 12 2 2 4-4"/>
      </svg>
    </div>
    <span class="eai-hallucination-title font-bold text-xs text-center">Hallucination Control Layer</span>
  </div>

  <div class="eai-hallucination-badges text-xs text-white/70 font-mono flex items-center justify-center text-center flex-wrap gap-1.5 mt-1 sm:mt-0">
    <span>Validation</span>
    <span>•</span>
    <span>Verification</span>
    <span>•</span>
    <span>Confidence Scoring</span>
    <span>•</span>
    <span>Human-in-the-Loop</span>
  </div>
</div>
