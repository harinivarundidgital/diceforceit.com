---
/* CapabilityCard.astro - Floating capability card with icon, title, and description matching reference diagram */
interface Props {
  title: string;
  desc?: string;
  posClass: string;
  id: string;
}

const { title, desc, posClass, id } = Astro.props;
const isLeft = posClass.includes('left');
const isRight = posClass.includes('right');
---

<div class={`eai-capability-card ${posClass}`} id={`cap-card-${id}`} tabIndex={0} aria-label={`Capability: ${title}`}>
  <div class="flex flex-col gap-0.5 max-w-[200px]">
    <div class="flex items-center gap-1.5">
      <span class={`w-1.5 h-1.5 rounded-full shrink-0 ${isLeft ? 'bg-cyan-400' : isRight ? 'bg-purple-400' : 'bg-emerald-400'}`}></span>
      <span class="font-bold text-[0.7rem] uppercase tracking-wider text-white truncate">{title}</span>
    </div>
    {desc && <p class="text-[0.6rem] text-white/55 font-light leading-tight pl-3">{desc}</p>}
  </div>
</div>
