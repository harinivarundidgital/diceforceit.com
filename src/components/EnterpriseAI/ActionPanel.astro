---
import ActionCard from './ActionCard.astro';

const actions = [
  { id: 'workflows', title: 'Execute Workflows', description: 'End-to-end process automation', icon: 'play-circle', theme: 'theme-cyan' },
  { id: 'crm', title: 'Update CRM & ERP', description: 'Update records across systems', icon: 'database', theme: 'theme-blue' },
  { id: 'alerts', title: 'Trigger Smart Alerts', description: 'Notify the right people instantly', icon: 'bell', theme: 'theme-cyan' },
  { id: 'meetings', title: 'Schedule & Dispatch', description: 'Book meetings with relevant stakeholders', icon: 'calendar', theme: 'theme-blue' },
];
---

<div class="eai-panel-actions flex flex-col h-full" aria-label="Section 4 Actions Taken">
  <div class="eai-panel-title flex items-center justify-center text-center w-full">
    <div class="flex items-center justify-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-cyan-400">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
        <polyline points="22 4 12 14.01 9 11.01"/>
      </svg>
      <span class="font-bold tracking-wider text-xs text-center">Automated Actions</span>
    </div>
  </div>

  <div class="flex flex-col gap-3.5 my-auto">
    {actions.map((item) => (
      <ActionCard title={item.title} description={item.description} id={item.id} themeClass={item.theme}>
        <slot name="icon" slot="icon">
          {item.icon === 'play-circle' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/>
            </svg>
          )}
          {item.icon === 'database' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>
            </svg>
          )}
          {item.icon === 'bell' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>
            </svg>
          )}
          {item.icon === 'calendar' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
          )}
        </slot>
      </ActionCard>
    ))}
  </div>
</div>
