---
/* ActionCard.astro - Vertical action card indicating automated execution with theme color */
interface Props {
  title: string;
  description?: string;
  id: string;
  themeClass?: string;
}

const { title, id, themeClass = "theme-cyan" } = Astro.props;
---

<div class={`eai-glass-card eai-action-card group flex items-center justify-center text-center p-3.5 bg-[#080d22]/85 border border-white/10 rounded-xl hover:border-cyan-400/50 hover:bg-[#08152b]/95 transition-all duration-300 shadow-sm hover:shadow-[0_0_20px_rgba(0,222,255,0.25)] w-full ${themeClass}`} id={`action-card-${id}`} tabIndex={0} aria-label={`Automated Action: ${title}`}>
  <div class="flex items-center justify-center text-center gap-2.5 w-full">
    <div class="eai-card-icon group-hover:scale-110 transition-transform shrink-0">
      <slot name="icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9 11 12 14 22 4"></polyline>
          <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
        </svg>
      </slot>
    </div>
    <span class="eai-action-title font-bold text-xs text-white group-hover:text-white transition-colors text-center">{title}</span>
  </div>
</div>
