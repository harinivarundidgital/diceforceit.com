---
import OutputCard from './OutputCard.astro';

const outputs = [
  { id: 'insights', title: 'Actionable Insights', description: 'Real-time insights with context & impact', icon: 'zap', theme: 'theme-cyan' },
  { id: 'opportunity', title: 'Opportunity Intelligence', description: 'High probability opportunities with win strategy', icon: 'trending-up', theme: 'theme-blue' },
  { id: 'risk-comp', title: 'Risk & Compliance Alerts', description: 'Risks, issues & compliance gaps identified', icon: 'shield-alert', theme: 'theme-cyan' },
  { id: 'predictive', title: 'Predictive Analytics & Answers', description: 'Forecasts for revenue, costs, timelines', icon: 'bar-chart-3', theme: 'theme-blue' },
];
---

<div class="eai-panel-outputs flex flex-col h-full" aria-label="Section 3 Intelligent Outputs">
  <div class="eai-panel-title flex items-center justify-center text-center w-full">
    <div class="flex items-center justify-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-cyan-400">
        <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
      </svg>
      <span class="font-bold tracking-wider text-xs text-center">Intelligent Outputs</span>
    </div>
  </div>

  <div class="flex flex-col gap-3.5 my-auto">
    {outputs.map((item) => (
      <OutputCard title={item.title} description={item.description} id={item.id} themeClass={item.theme}>
        <slot name="icon" slot="icon">
          {item.icon === 'zap' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
            </svg>
          )}
          {item.icon === 'trending-up' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>
            </svg>
          )}
          {item.icon === 'shield-alert' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/>
            </svg>
          )}
          {item.icon === 'bar-chart-3' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/>
            </svg>
          )}
        </slot>
      </OutputCard>
    ))}
  </div>
</div>
