---
import OutputCard from './OutputCard.astro';

const outputs = [
  { id: 'insights', title: 'Actionable Insights', description: 'Real-time insights with context & impact', icon: 'zap', theme: 'theme-purple' },
  { id: 'opportunity', title: 'Opportunity Intelligence', description: 'High probability opportunities with win strategy', icon: 'trending-up', theme: 'theme-blue' },
  { id: 'relationship', title: 'Relationship Intelligence', description: 'Stakeholder mapping, influence & sentiment', icon: 'network', theme: 'theme-green' },
  { id: 'win-prob', title: 'Project Win Probability', description: 'AI calculated probability with key factors', icon: 'target', theme: 'theme-gold' },
  { id: 'risk-comp', title: 'Risk & Compliance Alerts', description: 'Risks, issues & compliance gaps identified', icon: 'shield-alert', theme: 'theme-orange' },
  { id: 'workflows', title: 'Automated Workflows', description: 'Trigger workflows across systems', icon: 'git-pull-request', theme: 'theme-magenta' },
  { id: 'predictive', title: 'Predictive Outcomes', description: 'Forecasts for revenue, costs, timelines', icon: 'bar-chart-3', theme: 'theme-cyan' },
  { id: 'answers', title: 'Natural Language Answers', description: 'Ask anything. Get precise, context-aware answers', icon: 'message-square', theme: 'theme-teal' },
];
---

<div class="eai-panel-outputs flex flex-col h-full" aria-label="Section 3 Intelligent Outputs">
  <div class="eai-panel-title flex-col items-start justify-center h-auto pb-1 mb-2.5">
    <div class="flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-purple-400">
        <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
      </svg>
      <span class="font-bold uppercase tracking-wider text-xs">INTELLIGENT OUTPUTS</span>
    </div>
    <span class="text-xs text-white/45 font-mono">One Solution. Infinite Possibilities.</span>
  </div>

  <div class="flex flex-col gap-1.5">
    {outputs.map((item) => (
      <OutputCard title={item.title} description={item.description} id={item.id} themeClass={item.theme}>
        <slot name="icon" slot="icon">
          {item.icon === 'zap' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
            </svg>
          )}
          {item.icon === 'trending-up' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>
            </svg>
          )}
          {item.icon === 'network' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="16" y="16" width="6" height="6" rx="1"/><rect x="2" y="16" width="6" height="6" rx="1"/><rect x="9" y="2" width="6" height="6" rx="1"/><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"/><path d="M12 12V8"/>
            </svg>
          )}
          {item.icon === 'target' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>
            </svg>
          )}
          {item.icon === 'shield-alert' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/>
            </svg>
          )}
          {item.icon === 'git-pull-request' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M13 6h3a2 2 0 0 1 2 2v7"/><line x1="6" x2="6" y1="9" y2="21"/>
            </svg>
          )}
          {item.icon === 'bar-chart-3' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/>
            </svg>
          )}
          {item.icon === 'message-square' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
          )}
        </slot>
      </OutputCard>
    ))}
  </div>
</div>
