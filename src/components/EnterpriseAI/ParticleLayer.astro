---
/* ParticleLayer.astro - Floating background particles & ambient stars */
---

<div class="absolute inset-0 pointer-events-none z-1 overflow-hidden" aria-hidden="true">
</div>

<style>
  .particle {
    position: absolute;
    border-radius: 50%;
    background: #00deff;
    box-shadow: 0 0 10px #00deff, 0 0 20px #22d3ee;
    opacity: 0.4;
    animation: particleFloat 8s ease-in-out infinite alternate;
  }
  .p-1 { width: 3px; height: 3px; }
  .p-2 { width: 4px; height: 4px; background: #1fbfff; box-shadow: 0 0 10px #1fbfff; }
  .p-3 { width: 2px; height: 2px; }

  @keyframes particleFloat {
    0% { transform: translateY(0px) translateX(0px); opacity: 0.2; }
    50% { opacity: 0.7; }
    100% { transform: translateY(-40px) translateX(20px); opacity: 0.3; }
  }
</style>
