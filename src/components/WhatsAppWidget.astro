---
// Floating WhatsApp Interactive Widget Component
interface Props {
	phoneNumber?: string;
	message?: string;
}

const { 
	phoneNumber = "19727102714", 
	message = "Hello Diceforce IT team, I would like to inquire about your services." 
} = Astro.props;

const encodedMessage = encodeURIComponent(message);
const whatsappUrl = `https://wa.me/${phoneNumber}?text=${encodedMessage}`;
---

<!-- WhatsApp Floating Button Container -->
<div id="whatsapp-widget-root" class="fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-[99] flex flex-col items-end gap-3">
	
	<!-- Quick Chat Preview Card (Opens on Click) -->
	<div 
		id="whatsapp-chat-card"
		class="hidden opacity-0 translate-y-4 scale-95 pointer-events-none transition-all duration-300 ease-out w-[calc(100vw-2rem)] sm:w-80 rounded-2xl bg-[#090d16]/95 border border-emerald-500/30 p-4 shadow-[0_20px_50px_rgba(0,0,0,0.8),0_0_30px_rgba(37,211,102,0.15)] backdrop-blur-xl mb-1"
		aria-hidden="true"
	>
		<!-- Card Header -->
		<div class="flex items-center justify-between pb-3 border-b border-white/10">
			<div class="flex items-center gap-3">
				<div class="relative">
					<div class="w-10 h-10 rounded-full bg-gradient-to-tr from-emerald-600 to-green-400 p-0.5 shadow-md flex items-center justify-center">
						<img src="/diceforceITlogo_.gif" alt="Diceforce IT" class="w-full h-full object-contain rounded-full bg-black/60" />
					</div>
					<!-- Online Status Indicator -->
					<span class="absolute bottom-0 right-0 w-3 h-3 rounded-full bg-emerald-400 border-2 border-[#090d16] shadow-[0_0_8px_#25D366] animate-pulse"></span>
				</div>
				<div>
					<h4 class="text-xs font-mono font-bold text-white uppercase tracking-wider">Diceforce IT Support</h4>
					<p class="text-[11px] text-emerald-400 font-mono flex items-center gap-1.5">
						<span class="w-1.5 h-1.5 rounded-full bg-emerald-400 inline-block animate-ping"></span>
						Online — Replies instantly
					</p>
				</div>
			</div>
			<!-- Close Button -->
			<button 
				id="whatsapp-close-btn"
				type="button" 
				aria-label="Close chat window"
				class="text-neutral-400 hover:text-white p-1 rounded-lg hover:bg-white/10 transition-colors"
			>
				<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
				</svg>
			</button>
		</div>

		<!-- Chat Body Message Bubble -->
		<div class="my-3.5 p-3 rounded-xl bg-white/[0.04] border border-white/5 text-xs text-neutral-300 font-sans leading-relaxed relative">
			<p class="text-white/90 font-medium">👋 Hi there! How can we help your business today?</p>
			<p class="text-[10px] text-neutral-500 font-mono mt-1 text-right">+1 (972) 710-2714</p>
		</div>

		<!-- Direct Chat Trigger Button -->
		<a 
			href={whatsappUrl} 
			target="_blank" 
			rel="noopener noreferrer"
			class="w-full py-2.5 px-4 rounded-xl bg-gradient-to-r from-emerald-500 via-green-500 to-emerald-400 hover:from-emerald-400 hover:to-green-400 text-black font-mono font-bold text-xs uppercase tracking-wider flex items-center justify-center gap-2 shadow-[0_0_20px_rgba(37,211,102,0.4)] transition-all duration-300 transform hover:scale-[1.02] active:scale-95"
		>
			<svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
				<path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
			</svg>
			<span>Start Chat</span>
		</a>
	</div>

	<!-- Floating Circular Button to Toggle Popup -->
	<button 
		id="whatsapp-toggle-btn"
		type="button" 
		aria-label="Open WhatsApp chat option"
		class="relative flex items-center justify-center w-14 h-14 rounded-full bg-gradient-to-tr from-emerald-600 via-emerald-500 to-green-400 text-white shadow-[0_0_25px_rgba(37,211,102,0.5)] hover:shadow-[0_0_40px_rgba(37,211,102,0.8)] transition-all duration-300 hover:scale-110 active:scale-95 group cursor-pointer"
	>
		<!-- Pulse Ring Behind Button -->
		<span class="absolute -inset-1 rounded-full bg-emerald-500/40 animate-ping pointer-events-none opacity-75"></span>
		
		<!-- WhatsApp Icon (Shown when closed) -->
		<svg id="whatsapp-icon-open" class="w-7 h-7 fill-current relative z-10 filter drop-shadow-[0_2px_4px_rgba(0,0,0,0.3)] transition-transform duration-300 group-hover:rotate-12" viewBox="0 0 24 24">
			<path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
		</svg>

		<!-- Close Icon (Shown when open) -->
		<svg id="whatsapp-icon-close" class="w-6 h-6 stroke-current stroke-2 relative z-10 filter drop-shadow-[0_2px_4px_rgba(0,0,0,0.3)] hidden" fill="none" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
		</svg>

		<!-- Unread Badge Counter -->
		<span id="whatsapp-unread-badge" class="absolute -top-1 -right-1 w-5 h-5 rounded-full bg-red-500 text-white font-mono text-[10px] font-extrabold flex items-center justify-center border-2 border-black shadow-md z-20">
			1
		</span>
	</button>
</div>

<script>
	function setupWhatsAppWidget() {
		const toggleBtn = document.getElementById('whatsapp-toggle-btn');
		const closeBtn = document.getElementById('whatsapp-close-btn');
		const chatCard = document.getElementById('whatsapp-chat-card');
		const iconOpen = document.getElementById('whatsapp-icon-open');
		const iconClose = document.getElementById('whatsapp-icon-close');
		const badge = document.getElementById('whatsapp-unread-badge');
		const widgetRoot = document.getElementById('whatsapp-widget-root');

		if (!toggleBtn || !chatCard) return;

		let isOpen = false;

		function openCard() {
			isOpen = true;
			chatCard.classList.remove('hidden');
			// Force reflow for smooth animation transition
			void chatCard.offsetWidth;
			chatCard.classList.remove('opacity-0', 'translate-y-4', 'scale-95', 'pointer-events-none');
			chatCard.classList.add('opacity-100', 'translate-y-0', 'scale-100', 'pointer-events-auto');
			chatCard.setAttribute('aria-hidden', 'false');

			if (iconOpen) iconOpen.classList.add('hidden');
			if (iconClose) iconClose.classList.remove('hidden');
			if (badge) badge.classList.add('hidden');
		}

		function closeCard() {
			isOpen = false;
			chatCard.classList.remove('opacity-100', 'translate-y-0', 'scale-100', 'pointer-events-auto');
			chatCard.classList.add('opacity-0', 'translate-y-4', 'scale-95', 'pointer-events-none');
			chatCard.setAttribute('aria-hidden', 'true');

			if (iconOpen) iconOpen.classList.remove('hidden');
			if (iconClose) iconClose.classList.add('hidden');

			// Hide after CSS transition duration
			setTimeout(() => {
				if (!isOpen) {
					chatCard.classList.add('hidden');
				}
			}, 300);
		}

		function toggleCard(e: Event) {
			e.stopPropagation();
			if (isOpen) {
				closeCard();
			} else {
				openCard();
			}
		}

		toggleBtn.addEventListener('click', toggleCard);

		if (closeBtn) {
			closeBtn.addEventListener('click', (e) => {
				e.stopPropagation();
				closeCard();
			});
		}

		// Close when clicking outside of the widget root
		document.addEventListener('click', (e) => {
			if (isOpen && widgetRoot && !widgetRoot.contains(e.target as Node)) {
				closeCard();
			}
		});

		// Close on Escape key press
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && isOpen) {
				closeCard();
			}
		});
	}

	// Initialize on DOM load and Astro page transitions
	setupWhatsAppWidget();
	document.addEventListener('astro:page-load', setupWhatsAppWidget);
</script>
