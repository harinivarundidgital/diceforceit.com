	<!-- Giant bold text logo with parallax transform -->
	<div class="footer-giant-text-wrapper w-full mt-16 sm:mt-24 pt-8 sm:pt-12 relative z-10 pointer-events-auto select-none overflow-hidden text-center max-w-full flex justify-center items-center px-2 sm:px-4">
		<h2 class="giant-reveal-text font-extrabold uppercase leading-none font-syne select-none text-center cursor-default whitespace-nowrap will-change-transform transition-transform duration-100 ease-out max-w-full">
			DICEFORCE IT
		</h2>
	</div>

	<!-- Bottom Copyright & Credits Bar -->
	<div class="max-w-6xl mx-auto w-full mt-10 sm:mt-16 pt-6 sm:pt-8 border-t border-cyan-500/15 relative z-10 pointer-events-auto flex flex-col sm:flex-row items-center justify-between gap-3 sm:gap-6 text-center sm:text-left text-xs sm:text-sm font-mono text-neutral-400">
