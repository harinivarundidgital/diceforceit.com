			<div class="mt-6 p-4 rounded-xl bg-gradient-to-br from-cyan-950/40 via-neutral-900/60 to-purple-950/30 backdrop-blur-md transition-all duration-300 space-y-2 group shadow-[0_4px_25px_rgba(0,0,0,0.4)]">
				<p class="text-xs font-mono uppercase tracking-wider text-cyan-400/90 font-semibold">Have a project in mind?</p>
				<a href="/contact" class="text-sm font-medium text-white hover:text-cyan-300 transition-colors flex items-center gap-2">
					<span>Start a Project</span>
					<svg class="w-4 h-4 text-cyan-400 group-hover:translate-x-1 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
					</svg>
				</a>
			</div>
		</div>
		
		<!-- Column 4: Socials -->
		<div class="lg:col-span-2 space-y-4">
			<h4 class="text-sm font-mono uppercase tracking-[0.2em] text-cyan-400 font-bold select-text flex items-center gap-2">
				<span class="w-1.5 h-1.5 rounded-full bg-cyan-400 inline-block shadow-[0_0_6px_#22d3ee]"></span> Connect
			</h4>
			<ul class="space-y-3 text-sm text-neutral-300 font-sans">
				<li>
					<a href="https://instagram.com/" target="_blank" rel="noopener" class="flex items-center gap-3 text-neutral-300 hover:text-cyan-300 transition-all duration-200 group text-sm">
						<div class="w-9 h-9 rounded-lg bg-neutral-900/80 flex items-center justify-center group-hover:bg-cyan-950/60 group-hover:text-cyan-400 transition-all duration-300 text-neutral-400 shadow-sm shrink-0 group-hover:shadow-[0_0_12px_rgba(34,211,238,0.2)]">
							<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" /></svg>
						</div>
						<span class="font-medium group-hover:translate-x-0.5 transition-transform duration-200">Instagram</span>
					</a>
				</li>
				<li>
					<a href="https://twitter.com/" target="_blank" rel="noopener" class="flex items-center gap-3 text-neutral-300 hover:text-cyan-300 transition-all duration-200 group text-sm">
						<div class="w-9 h-9 rounded-lg bg-neutral-900/80 flex items-center justify-center group-hover:bg-cyan-950/60 group-hover:text-cyan-400 transition-all duration-300 text-neutral-400 shadow-sm shrink-0 group-hover:shadow-[0_0_12px_rgba(34,211,238,0.2)]">
							<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" /></svg>
						</div>
						<span class="font-medium group-hover:translate-x-0.5 transition-transform duration-200">Twitter / X</span>
					</a>
				</li>
				<li>
					<a href="https://linkedin.com/" target="_blank" rel="noopener" class="flex items-center gap-3 text-neutral-300 hover:text-cyan-300 transition-all duration-200 group text-sm">
						<div class="w-9 h-9 rounded-lg bg-neutral-900/80 flex items-center justify-center group-hover:bg-cyan-950/60 group-hover:text-cyan-400 transition-all duration-300 text-neutral-400 shadow-sm shrink-0 group-hover:shadow-[0_0_12px_rgba(34,211,238,0.2)]">
							<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M22.23 0H1.77C.8 0 0 .77 0 1.72v20.56C0 23.23.8 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.72V1.72C24 .77 23.2 0 22.23 0zM7.12 20.45H3.56V9h3.56v11.45zM5.34 7.43a2.06 2.06 0 110-4.11 2.06 2.06 0 010 4.11zm15.11 13.02h-3.56v-5.6c0-1.34-.03-3.05-1.86-3.05-1.86 0-2.14 1.45-2.14 2.95v5.7H9.33V9h3.42v1.56h.05c.48-.9 1.64-1.86 3.39-1.86 3.63 0 4.3 2.39 4.3 5.5v6.25z" /></svg>
						</div>
