---
// Reusable Footer Component
---

<footer id="main-footer" class="relative w-full pt-28 pb-32 mt-0 overflow-hidden bg-[#020205]/40 backdrop-blur-md px-6 sm:px-12 md:px-16">
	<!-- Atmospheric Radial Glow behind Moon -->
	<div id="footer-glow" class="absolute bottom-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-[450px] bg-[radial-gradient(ellipse_at_bottom,rgba(34,211,238,0.30)_0%,rgba(3,119,255,0.20)_40%,rgba(136,58,226,0.10)_65%,transparent_85%)] blur-[70px] pointer-events-none z-0 animate-moon-aura will-change-transform"></div>

	<!-- Footer Background Image with Moon Edge Drop-Shadow Glow & Parallax -->
	<div id="footer-bg-container" class="absolute inset-x-0 -bottom-[10%] w-full h-[120%] z-0 pointer-events-none overflow-hidden">
		<img 
			id="footer-bg-img"
			src="/footerbackground.png" 
			alt="" 
			aria-hidden="true"
			class="w-full h-full object-cover object-bottom opacity-95 mix-blend-screen will-change-transform transition-transform duration-200 ease-out" 
			style="mix-blend-mode: screen; object-position: bottom;"
		/>
	</div>

	<!-- Dark Vignette Overlay for Text Contrast & Readability -->
	<div class="absolute inset-0 bg-gradient-to-b from-transparent via-black/25 to-black/50 pointer-events-none z-[1]"></div>

	<!-- Footer Content Grid -->
	<div class="max-w-6xl mx-auto w-full grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-12 relative z-10 pointer-events-auto">
		<!-- Brand Block -->
		<div class="lg:col-span-4 space-y-4">
			<a href="/home" class="flex items-center gap-3 group w-fit">
				<div class="relative flex items-center justify-center">
					<div class="absolute -inset-1 rounded-full bg-cyan-500/20 blur-sm group-hover:bg-cyan-400/40 transition-colors duration-300"></div>
					<img src="/diceforceITlogo_.gif" alt="Diceforce IT Logo" class="relative w-12 h-12 object-contain" width="48" height="48" />
				</div>
				<span class="text-base font-space tracking-[0.25em] text-cyan-400 font-bold uppercase select-text group-hover:text-cyan-300 transition-colors">Diceforce IT</span>
			</a>
			<p class="text-neutral-300 text-sm leading-relaxed max-w-sm select-text">
				Digital experiences that connect, scale and perform. A creative technology studio for design, strategy, engineering, and enterprise AI solutions.
			</p>
			<span class="text-xs sm:text-sm font-mono text-neutral-400 block pt-2 select-text">
				© 2026 diceforce IT — All rights reserved.
			</span>
		</div>
		
		<!-- Column 2: Navigation -->
		<div class="lg:col-span-3 space-y-4">
			<h4 class="text-sm font-mono uppercase tracking-[0.2em] text-cyan-400 font-bold select-text flex items-center gap-2">
				<span class="w-1.5 h-1.5 rounded-full bg-cyan-400 inline-block shadow-[0_0_6px_#22d3ee]"></span> Navigation
			</h4>
			<ul class="space-y-2 text-sm text-neutral-300 font-sans">
				<li>
					<a href="/home" class="group flex items-center gap-2 text-neutral-300 hover:text-cyan-300 transition-colors py-1">
						<svg class="w-4 h-4 text-cyan-400 opacity-0 group-hover:opacity-100 -translate-x-2 group-hover:translate-x-0 transition-all duration-200 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
						</svg>
						<span class="group-hover:translate-x-1 transition-transform duration-200">Home</span>
					</a>
				</li>
				<li>
					<a href="/about" class="group flex items-center gap-2 text-neutral-300 hover:text-cyan-300 transition-colors py-1">
						<svg class="w-4 h-4 text-cyan-400 opacity-0 group-hover:opacity-100 -translate-x-2 group-hover:translate-x-0 transition-all duration-200 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
						</svg>
						<span class="group-hover:translate-x-1 transition-transform duration-200">About Us</span>
