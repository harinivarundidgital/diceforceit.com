---
// Reusable Footer Component
---

<footer class="relative w-full pt-28 pb-32 mt-20 overflow-hidden bg-[#020205]/70 backdrop-blur-md px-6 sm:px-12 md:px-16 border-t border-white/10">
	<!-- Footer Background Image (Aligned and stuck to bottom - Preserved Intact) -->
	<div class="absolute inset-x-0 bottom-0 w-full h-full z-0 pointer-events-none overflow-hidden">
		<img 
			src="/images/footerbackground.png" 
			alt="" 
			aria-hidden="true"
			class="w-full h-full object-cover object-bottom opacity-50 mix-blend-screen" 
			style="mix-blend-mode: screen; object-position: bottom;"
		/>
	</div>

	<!-- Dark Vignette Overlay for Text Contrast & Readability -->
	<div class="absolute inset-0 bg-gradient-to-b from-black/95 via-black/80 to-black/40 pointer-events-none z-[1]"></div>

	<!-- Ambient Decorative Top Line Sheen -->
	<div class="absolute top-0 left-1/2 -translate-x-1/2 w-3/4 max-w-4xl h-[1px] bg-gradient-to-r from-transparent via-cyan-500/50 to-transparent pointer-events-none z-10"></div>

	<!-- Footer Content Grid -->
